<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MemoriaPlus.Views.ComingSoonView"
             x:CompileBindings="False"
             Background="{StaticResource SurfaceBrush}">
    <!-- Placeholder reusable; Tag nombra el modo. -->
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
            <Border Background="{StaticResource SurfaceContainerBrush}"
                    CornerRadius="{StaticResource CornerRadiusDefault}"
                    Padding="32" BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock FontSize="48" HorizontalAlignment="Center"
                               Foreground="{StaticResource OutlineBrush}" Text="🛠"/>
                    <TextBlock Theme="{StaticResource H1Style}" HorizontalAlignment="Center"
                               Margin="0,12,0,4"
                               Text="{Binding $parent[UserControl].Tag}"/>
                    <TextBlock Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Text="Esta sección está en desarrollo. Por ahora la app entra desde la sidebar Cálculos para editar el proyecto activo."/>
                    <Border Background="{StaticResource SurfaceContainerLowestBrush}"
                            CornerRadius="{StaticResource CornerRadiusSm}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1" Padding="12,8">
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   TextAlignment="Center"
                                   Text="{Binding Version, Mode=OneWay, StringFormat='🚧  Próximamente en {0}'}"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
