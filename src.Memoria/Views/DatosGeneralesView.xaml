<UserControl x:Class="MemoriaPlus.Views.DatosGeneralesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="640">
            <TextBlock Style="{StaticResource H1Style}" Text="Datos generales del proyecto"/>
            <TextBlock Style="{StaticResource LabelCapsStyle}" Margin="0,4,0,0"
                       Text="PLACEHOLDER · placeholders y formulario se conectan en el commit de captura"/>
            <Border Margin="0,16,0,0" Padding="16"
                    Background="{StaticResource SurfaceContainerLowestBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusDefault}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2Style}" Text="Identificación"/>
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               Text="Nombre · Ubicación · Ciudad · Mes/Año · Uso · Cantidad de niveles · Sistema estructural · Tipo de fundaciones · Esfuerzo admisible · Profundidad de desplante · f'c · fy · Normas aplicables."/>
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Padding="16"
                    Background="{StaticResource SurfaceContainerLowestBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusDefault}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2Style}" Text="Ingeniero responsable"/>
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               Text="Nombre · CODIA · Tel. fijo · Tel. celular · Diseñador arquitectónico."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
