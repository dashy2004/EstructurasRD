<UserControl x:Class="MemoriaPlus.Views.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <!--
        Vista placeholder reusable para los modos de la sidebar que aun no
        tienen implementacion. La propiedad Tag del UserControl se usa para
        nombrar el modo (ej. "Búsqueda", "Plantillas", "Configuración") sin
        crear archivos separados por cada uno.
    -->

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
            <Border Background="{StaticResource SurfaceContainerBrush}"
                    CornerRadius="{StaticResource CornerRadiusDefault}"
                    Padding="32" BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock FontSize="48" HorizontalAlignment="Center"
                               Foreground="{StaticResource OutlineBrush}"
                               Text="🛠"/>
                    <TextBlock Style="{StaticResource H1Style}" HorizontalAlignment="Center"
                               Margin="0,12,0,4"
                               Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <TextBlock Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Text="Esta sección está en desarrollo. Por ahora la app entra desde la sidebar Cálculos para editar el proyecto activo."/>
                    <Border Background="{StaticResource SurfaceContainerLowestBrush}"
                            CornerRadius="{StaticResource CornerRadiusSm}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1"
                            Padding="12,8">
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   TextAlignment="Center">
                            <Run Text="🚧  Próximamente en "/>
                            <Run Text="{Binding Version, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
