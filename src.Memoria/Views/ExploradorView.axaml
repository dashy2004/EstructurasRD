<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
             x:Class="MemoriaPlus.Views.ExploradorView"
             x:CompileBindings="False"
             Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,16,0,16" ColumnDefinitions="*,12,320" RowDefinitions="Auto,12,*">

        <!-- Header con buscador y CTA -->
        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Margin="0,0,12,0"
                     ToolTip.Tip="Buscar por nombre, ingeniero o CODIA"
                     Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Theme="{StaticResource PrimaryButtonStyle}"
                    Content="+ Nuevo proyecto" Command="{Binding NuevoProyectoCommand}"/>
        </Grid>

        <!-- Tabla de proyectos -->
        <Border Grid.Row="2" Grid.Column="0" Theme="{StaticResource SectionCardStyle}" Padding="0">
            <DataGrid x:Name="ProyectosGrid"
                      ItemsSource="{Binding ProyectosRecientesFiltrados}"
                      SelectedItem="{Binding ProyectoRecienteSeleccionado}"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      BorderThickness="0"
                      Theme="{StaticResource MemoriaDataGridStyle}"
                      DoubleTapped="ProyectosGrid_OnDoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOMBRE"          Width="2*"  Binding="{Binding Nombre}"/>
                    <DataGridTextColumn Header="INGENIERO"       Width="*"   Binding="{Binding Ingeniero}"/>
                    <DataGridTextColumn Header="CODIA"           Width="100" Binding="{Binding Codia}"/>
                    <DataGridTextColumn Header="NIVELES"         Width="100" Binding="{Binding Niveles}"/>
                    <DataGridTextColumn Header="ÚLTIMA EDICIÓN"  Width="140" Binding="{Binding UltimaEdicion}"/>
                    <DataGridTemplateColumn Header="ESTADO"      Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SecondaryContainerBrush}"
                                        CornerRadius="{StaticResource CornerRadiusSm}"
                                        Padding="8,2" Margin="0,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Estado}"
                                               FontFamily="{StaticResource FontFamilyUI}"
                                               FontSize="11" FontWeight="Medium"
                                               Foreground="{StaticResource OnSurfaceBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Panel detalle -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                Theme="{StaticResource SectionCardStyle}">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Theme="{StaticResource H2Style}"
                           Text="{Binding ProyectoRecienteSeleccionado.Nombre}"/>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="INGENIERO" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ProyectoRecienteSeleccionado.Ingeniero}"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="13"/>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="CODIA" Margin="0,12,0,2"/>
                    <TextBlock Text="{Binding ProyectoRecienteSeleccionado.Codia}"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="13"/>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="NIVELES" Margin="0,12,0,2"/>
                    <TextBlock Text="{Binding ProyectoRecienteSeleccionado.Niveles}"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="13"/>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="ÚLTIMA EDICIÓN" Margin="0,12,0,2"/>
                    <TextBlock Text="{Binding ProyectoRecienteSeleccionado.UltimaEdicion}"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="13"/>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="ESTADO" Margin="0,12,0,2"/>
                    <Border Background="{StaticResource SecondaryContainerBrush}"
                            CornerRadius="{StaticResource CornerRadiusSm}"
                            Padding="8,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ProyectoRecienteSeleccionado.Estado}"
                                   FontFamily="{StaticResource FontFamilyUI}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                    </Border>
                </StackPanel>

                <Button Grid.Row="2" Theme="{StaticResource PrimaryButtonStyle}"
                        Content="📂 Abrir en Cálculos" HorizontalAlignment="Stretch"
                        Command="{Binding AbrirEnCalculosCommand}"
                        ToolTip.Tip="Abrir el proyecto seleccionado en la pestaña Cálculos (doble-click en la fila también funciona)"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Margin="0,0,0,12"
                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                   FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
            <Run Text="Mostrando "/>
            <Run Text="{Binding ProyectosRecientesFiltrados.Count, Mode=OneWay}"/>
            <Run Text=" de "/>
            <Run Text="{Binding ProyectosRecientes.Count, Mode=OneWay}"/>
            <Run Text=" proyectos"/>
        </TextBlock>
    </Grid>
</UserControl>
