<UserControl x:Class="MemoriaPlus.Views.ExploradorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24,16,0,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>     <!-- tabla principal -->
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="320"/>   <!-- panel detalle -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header con buscador y CTA -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Margin="0,0,12,0"
                     ToolTip="Buscar por nombre, ingeniero o CODIA"
                     Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                    Content="+ Nuevo proyecto"
                    Command="{Binding NuevoProyectoCommand}"/>
        </Grid>

        <!-- Tabla de proyectos -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="0">
            <DataGrid x:Name="ProyectosGrid"
                      ItemsSource="{Binding ProyectosRecientesFiltrados}"
                      SelectedItem="{Binding ProyectoRecienteSeleccionado}"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      BorderThickness="0"
                      MouseDoubleClick="ProyectosGrid_OnDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NOMBRE"          Width="2*"  Binding="{Binding Nombre}"/>
                    <DataGridTextColumn Header="INGENIERO"       Width="*"   Binding="{Binding Ingeniero}"/>
                    <DataGridTextColumn Header="CODIA"           Width="100" Binding="{Binding Codia}"/>
                    <DataGridTextColumn Header="NIVELES"         Width="100" Binding="{Binding Niveles}"/>
                    <DataGridTextColumn Header="ÚLTIMA EDICIÓN"  Width="140" Binding="{Binding UltimaEdicion}"/>
                    <DataGridTemplateColumn Header="ESTADO"      Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SecondaryContainerBrush}"
                                        CornerRadius="{StaticResource CornerRadiusSm}"
                                        Padding="8,2"
                                        Margin="0,4"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Estado}"
                                               FontFamily="{StaticResource FontFamilyUI}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource OnSurfaceBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Panel detalle -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Style="{StaticResource H2Style}"
                               Text="{Binding ProyectoRecienteSeleccionado.Nombre}"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="INGENIERO"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ProyectoRecienteSeleccionado.Ingeniero}"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="13"/>

                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="CODIA"
                               Margin="0,12,0,2"/>
                    <TextBlock Text="{Binding ProyectoRecienteSeleccionado.Codia}"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="13"/>

                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="NIVELES"
                               Margin="0,12,0,2"/>
                    <TextBlock Text="{Binding ProyectoRecienteSeleccionado.Niveles}"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="13"/>

                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="ÚLTIMA EDICIÓN"
                               Margin="0,12,0,2"/>
                    <TextBlock Text="{Binding ProyectoRecienteSeleccionado.UltimaEdicion}"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="13"/>

                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="ESTADO"
                               Margin="0,12,0,2"/>
                    <Border Background="{StaticResource SecondaryContainerBrush}"
                            CornerRadius="{StaticResource CornerRadiusSm}"
                            Padding="8,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ProyectoRecienteSeleccionado.Estado}"
                                   FontFamily="{StaticResource FontFamilyUI}"
                                   FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                    </Border>
                </StackPanel>

                <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}"
                        Content="📂 Abrir en Cálculos" HorizontalAlignment="Stretch"
                        Command="{Binding AbrirEnCalculosCommand}"
                        ToolTip="Abrir el proyecto seleccionado en la pestaña Cálculos (doble-click en la fila también funciona)"/>
            </Grid>
        </Border>

        <!-- Footer (info de cantidad) -->
        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Margin="0,0,0,12"
                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                   FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
            <Run Text="Mostrando "/>
            <Run Text="{Binding ProyectosRecientesFiltrados.Count, Mode=OneWay}"/>
            <Run Text=" de "/>
            <Run Text="{Binding ProyectosRecientes.Count, Mode=OneWay}"/>
            <Run Text=" proyectos"/>
        </TextBlock>
    </Grid>
</UserControl>
