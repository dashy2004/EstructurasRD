<UserControl x:Class="MemoriaPlus.Views.ValidacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ValidacionViewModel}"
             mc:Ignorable="d"
             Width="420"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <!-- Estilo pill para los filtros: Todas/Errores/Observaciones -->
        <Style x:Key="FilterPillStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="bd" Padding="10,4"
                                Background="{StaticResource SurfaceContainerLowBrush}"
                                BorderBrush="{StaticResource OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusSm}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IssueCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceContainerLowestBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusDefault}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- header -->
                <RowDefinition Height="Auto"/>  <!-- 3 cards de conteos -->
                <RowDefinition Height="Auto"/>  <!-- filtros -->
                <RowDefinition Height="*"/>     <!-- lista de issues -->
                <RowDefinition Height="Auto"/>  <!-- footer -->
            </Grid.RowDefinitions>

            <!-- =====================================================
                 HEADER
                 ===================================================== -->
            <Border Grid.Row="0" Padding="16,14"
                    BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontFamily="{StaticResource FontFamilyUI}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource OnSurfaceBrush}">
                            <Run Text="🛡  "/>
                            <Run Text="Validación normativa"/>
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="11"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Margin="0,2,0,0"
                                   Text="{Binding Reporte.ReglamentoAplicable}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Padding="8,2"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" FontSize="14"
                            Foreground="{StaticResource OnSurfaceVariantBrush}"
                            Command="{Binding CerrarPanelCommand}"
                            ToolTip="Cerrar panel"/>
                </Grid>
            </Border>

            <!-- =====================================================
                 3 CARDS DE CONTEOS (Errores · Observaciones · Conformes)
                 ===================================================== -->
            <Grid Grid.Row="1" Margin="16,16,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="10"
                        Background="{StaticResource SurfaceContainerLowestBrush}"
                        BorderBrush="{StaticResource ErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusDefault}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⊘" FontSize="18" HorizontalAlignment="Center"
                                   Foreground="{StaticResource ErrorBrush}"/>
                        <TextBlock Text="{Binding TotalErrores}"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="ERRORES"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="10"
                        Background="{StaticResource SurfaceContainerLowestBrush}"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusDefault}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="18" HorizontalAlignment="Center"
                                   Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="{Binding TotalObservaciones}"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="OBS."
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Padding="10"
                        Background="{StaticResource SurfaceContainerLowestBrush}"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusDefault}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="18" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="{Binding TotalConformes}"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="CONFORME"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =====================================================
                 FILTROS (pills): Todas · Errores · Observaciones
                 ===================================================== -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,4,16,8">
                <RadioButton Style="{StaticResource FilterPillStyle}"
                             GroupName="ValidationFilter"
                             IsChecked="{Binding EsFiltroTodas, Mode=OneWay}"
                             Command="{Binding FiltrarCommand}"
                             CommandParameter="Todas">
                    <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
                        <Run Text="Todas · "/>
                        <Run Text="{Binding Issues.Count, Mode=OneWay}"/>
                    </TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterPillStyle}"
                             GroupName="ValidationFilter"
                             IsChecked="{Binding EsFiltroErrores, Mode=OneWay}"
                             Command="{Binding FiltrarCommand}"
                             CommandParameter="Errores">
                    <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
                        <Run Text="Errores · "/>
                        <Run Text="{Binding TotalErrores, Mode=OneWay}"/>
                    </TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterPillStyle}"
                             GroupName="ValidationFilter"
                             IsChecked="{Binding EsFiltroObservaciones, Mode=OneWay}"
                             Command="{Binding FiltrarCommand}"
                             CommandParameter="Observaciones">
                    <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
                        <Run Text="Observaciones · "/>
                        <Run Text="{Binding TotalObservaciones, Mode=OneWay}"/>
                    </TextBlock>
                </RadioButton>
            </StackPanel>

            <!-- =====================================================
                 LISTA DE ISSUES (ItemsControl scrolleable)
                 ===================================================== -->
            <ScrollViewer Grid.Row="3" Padding="16,8,16,8"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Empty state cuando no hay issues -->
                    <Border Padding="16" CornerRadius="{StaticResource CornerRadiusDefault}"
                            Background="{StaticResource SurfaceContainerLowestBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IssuesFiltrados.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontSize="32" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Sin hallazgos"
                                       FontFamily="{StaticResource FontFamilyUI}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource OnSurfaceBrush}"/>
                            <TextBlock Text="El proyecto cumple con todas las reglas chequeadas en este filtro."
                                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Issue cards -->
                    <ItemsControl ItemsSource="{Binding IssuesFiltrados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource IssueCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icono de severidad -->
                                        <TextBlock Grid.Column="0" Margin="0,0,10,0"
                                                   VerticalAlignment="Top"
                                                   FontSize="18">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Text" Value="⚠"/>
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severidad}" Value="Error">
                                                            <Setter Property="Text" Value="⊘"/>
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Cuerpo de la card -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Titulo}"
                                                       FontFamily="{StaticResource FontFamilyUI}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource OnSurfaceBrush}"/>
                                            <TextBlock Text="{Binding UbicacionFormateada}"
                                                       FontFamily="{StaticResource FontFamilyMono}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                                            <Border Margin="0,8,0,0" Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource SurfaceContainerHighBrush}"
                                                    CornerRadius="{StaticResource CornerRadiusSm}">
                                                <TextBlock Text="{Binding ReferenciaNormativa}"
                                                           FontFamily="{StaticResource FontFamilyMono}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- =====================================================
                 FOOTER: Copiar reporte + Re-validar + fecha
                 ===================================================== -->
            <Border Grid.Row="4" Padding="16,10"
                    Background="{StaticResource SurfaceContainerLowBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="📋 Copiar reporte"
                            Padding="10,0"
                            Command="{Binding CopiarReporteCommand}"
                            ToolTip="Copiar el reporte plano al portapapeles"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Margin="12,0,12,0"
                               FontFamily="{StaticResource FontFamilyMono}"
                               FontSize="10"
                               TextAlignment="Center"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Text="{Binding FechaGeneradoTexto, StringFormat='Generado · {0}'}"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="↻ Re-validar"
                            Padding="10,0"
                            Command="{Binding RevalidarCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
