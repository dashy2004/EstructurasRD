<UserControl x:Class="MemoriaPlus.Views.CargasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="900">
            <TextBlock Style="{StaticResource H1Style}" Text="Tabla de cargas"/>
            <TextBlock Style="{StaticResource LabelCapsStyle}" Margin="0,4,0,0"
                       Text="PLACEHOLDER · 15 filas h=0.06..0.20 + pesos propios entrepiso/techo + carga viva + factores"/>
            <Border Margin="0,16,0,0" Padding="12,8"
                    Background="{StaticResource SurfaceContainerBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusDefault}">
                <TextBlock Foreground="{StaticResource OnSurfaceVariantBrush}"
                           Text="ⓘ  Estos valores aplican a todo el proyecto. La importacion desde el .xlsx semilla y el editor en vivo se conectan en commits posteriores."/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
