<UserControl x:Class="MemoriaPlus.Views.DatosIngenieroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ConfiguracionViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource SurfaceBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource H1Style}" Text="Datos del ingeniero"/>
            <TextBlock Margin="0,4,0,16"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="13"
                       Text="Este perfil precarga automáticamente los campos de proyectos nuevos."/>

            <!-- SECCIÓN: IDENTIDAD -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="🆔  IDENTIDAD"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Nombre completo"/>
                            <TextBox Text="{Binding Perfil.Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CODIA"/>
                            <TextBox Text="{Binding Perfil.Codia, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Especialidad"/>
                            <ComboBox SelectedValue="{Binding Perfil.Especialidad, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="Estructural"/>
                                <ComboBoxItem Content="Hidráulico"/>
                                <ComboBoxItem Content="Eléctrico"/>
                                <ComboBoxItem Content="Sanitario"/>
                                <ComboBoxItem Content="Vial"/>
                                <ComboBoxItem Content="Otro"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECCIÓN: CONTACTO -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="📞  CONTACTO"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Teléfono fijo"/>
                            <TextBox Text="{Binding Perfil.TelefonoFijo, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Teléfono celular"/>
                            <TextBox Text="{Binding Perfil.TelefonoCelular, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Email"/>
                            <TextBox Text="{Binding Perfil.Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Ciudad / oficina"/>
                            <TextBox Text="{Binding Perfil.Ciudad, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECCIÓN: FIRMA Y SELLO (placeholder: paths a imágenes) -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="✍  FIRMA Y SELLO"/>
                    <TextBlock Margin="0,4,0,12"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="11" TextWrapping="Wrap"
                               Text="Indica el path absoluto a las imágenes PNG. El drag-and-drop con preview se agregará en v0.6."/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Firma (PNG con fondo transparente)"/>
                            <TextBox Text="{Binding Perfil.FirmaPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Sello / logo de oficina"/>
                            <TextBox Text="{Binding Perfil.SelloPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECCIÓN: FORMACIÓN (opcional) -->
            <Expander Margin="0,0,0,12" IsExpanded="False"
                      Foreground="{StaticResource OnSurfaceBrush}">
                <Expander.Header>
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="🎓  FORMACIÓN (opcional)"/>
                </Expander.Header>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Universidad"/>
                            <TextBox Text="{Binding Perfil.Universidad, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Año de graduación"/>
                            <TextBox Text="{Binding Perfil.AnoGraduacion, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Maestría / Postgrado"/>
                            <TextBox Text="{Binding Perfil.PostGrado, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>

            <!-- FOOTER: Acciones -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="💾 Guardar perfil"
                        Padding="16,0"
                        Command="{Binding GuardarPerfilCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
