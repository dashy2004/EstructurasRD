<UserControl x:Class="MemoriaPlus.Views.DatosIngenieroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ConfiguracionViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource SurfaceBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource H1Style}" Text="Datos del ingeniero"/>
            <TextBlock Margin="0,4,0,16"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="13"
                       Text="Este perfil precarga automáticamente los campos de proyectos nuevos."/>

            <!-- SECCIÓN: IDENTIDAD -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="🆔  IDENTIDAD"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Nombre completo"/>
                            <TextBox Text="{Binding Perfil.Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CODIA"/>
                            <TextBox Text="{Binding Perfil.Codia, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Especialidad"/>
                            <ComboBox SelectedValue="{Binding Perfil.Especialidad, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="Estructural"/>
                                <ComboBoxItem Content="Hidráulico"/>
                                <ComboBoxItem Content="Eléctrico"/>
                                <ComboBoxItem Content="Sanitario"/>
                                <ComboBoxItem Content="Vial"/>
                                <ComboBoxItem Content="Otro"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECCIÓN: CONTACTO -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="📞  CONTACTO"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Teléfono fijo"/>
                            <TextBox Text="{Binding Perfil.TelefonoFijo, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Teléfono celular"/>
                            <TextBox Text="{Binding Perfil.TelefonoCelular, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Email"/>
                            <TextBox Text="{Binding Perfil.Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Ciudad / oficina"/>
                            <TextBox Text="{Binding Perfil.Ciudad, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECCIÓN: FIRMA Y SELLO con drag-drop + preview (commit 28) -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="✍  FIRMA Y SELLO"/>
                    <TextBlock Margin="0,4,0,12"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="11" TextWrapping="Wrap"
                               Text="Arrastra los archivos PNG/JPG aquí o usa el botón Examinar. La firma se imprime sobre las hojas finales de la memoria; el sello identifica tu oficina."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DROP ZONE: FIRMA -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Firma (PNG con fondo transparente)"/>
                            <Border x:Name="FirmaDropZone"
                                    Height="180"
                                    AllowDrop="True"
                                    Background="{StaticResource SurfaceContainerLowestBrush}"
                                    BorderBrush="{StaticResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadiusDefault}"
                                    Drop="FirmaDropZone_Drop"
                                    DragEnter="DropZone_DragEnter"
                                    DragOver="DropZone_DragOver"
                                    DragLeave="DropZone_DragLeave"
                                    Tag="Firma">
                                <Grid>
                                    <!-- Empty state: instrucciones -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="16">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Perfil.FirmaPath, Converter={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="📥" FontSize="28" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource OutlineBrush}"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                                   Text="Arrastra un PNG aquí o usa Examinar"/>
                                    </StackPanel>

                                    <!-- Preview cuando hay path set -->
                                    <Border Padding="8">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Perfil.FirmaPath, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding Perfil.FirmaPath, Converter={StaticResource PathToImageConverter}}"
                                               Stretch="Uniform"
                                               StretchDirection="DownOnly"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontFamilyMono}"
                                       FontSize="10"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Perfil.FirmaPath}"
                                       Text="{Binding Perfil.FirmaPath, TargetNullValue='(sin firma)'}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="📂 Examinar…" Padding="10,2"
                                        Click="ExaminarFirma_Click"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="✕ Quitar" Padding="10,2" Margin="6,0,0,0"
                                        Click="QuitarFirma_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- DROP ZONE: SELLO -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Sello / logo de oficina"/>
                            <Border x:Name="SelloDropZone"
                                    Height="180"
                                    AllowDrop="True"
                                    Background="{StaticResource SurfaceContainerLowestBrush}"
                                    BorderBrush="{StaticResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadiusDefault}"
                                    Drop="SelloDropZone_Drop"
                                    DragEnter="DropZone_DragEnter"
                                    DragOver="DropZone_DragOver"
                                    DragLeave="DropZone_DragLeave"
                                    Tag="Sello">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="16">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Perfil.SelloPath, Converter={x:Null}}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="📥" FontSize="28" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource OutlineBrush}"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                                   Text="Arrastra un PNG/JPG aquí o usa Examinar"/>
                                    </StackPanel>
                                    <Border Padding="8">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Perfil.SelloPath, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding Perfil.SelloPath, Converter={StaticResource PathToImageConverter}}"
                                               Stretch="Uniform"
                                               StretchDirection="DownOnly"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontFamilyMono}"
                                       FontSize="10"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Perfil.SelloPath}"
                                       Text="{Binding Perfil.SelloPath, TargetNullValue='(sin sello)'}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="📂 Examinar…" Padding="10,2"
                                        Click="ExaminarSello_Click"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="✕ Quitar" Padding="10,2" Margin="6,0,0,0"
                                        Click="QuitarSello_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECCIÓN: FORMACIÓN (opcional) -->
            <Expander Margin="0,0,0,12" IsExpanded="False"
                      Foreground="{StaticResource OnSurfaceBrush}">
                <Expander.Header>
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="🎓  FORMACIÓN (opcional)"/>
                </Expander.Header>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Universidad"/>
                            <TextBox Text="{Binding Perfil.Universidad, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Año de graduación"/>
                            <TextBox Text="{Binding Perfil.AnoGraduacion, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Maestría / Postgrado"/>
                            <TextBox Text="{Binding Perfil.PostGrado, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>

            <!-- FOOTER: Acciones -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="💾 Guardar perfil"
                        Padding="16,0"
                        Command="{Binding GuardarPerfilCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
