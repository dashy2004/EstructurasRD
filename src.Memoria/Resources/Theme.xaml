<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ================================================================
         Memoria Plus — Design Tokens
         Fuente: docs/referencia/ui-design/memoria_plus/DESIGN.md
         (paleta extendida tipo Material 3, palette neutra + cobalt accent)
         ================================================================ -->

    <!-- Surfaces -->
    <Color x:Key="ColorSurface">#FCF8FB</Color>
    <Color x:Key="ColorSurfaceContainerLowest">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceContainerLow">#F6F3F5</Color>
    <Color x:Key="ColorSurfaceContainer">#F0EDEF</Color>
    <Color x:Key="ColorSurfaceContainerHigh">#EAE7EA</Color>
    <Color x:Key="ColorSurfaceContainerHighest">#E4E2E4</Color>
    <Color x:Key="ColorOnSurface">#1B1B1D</Color>
    <Color x:Key="ColorOnSurfaceVariant">#434751</Color>
    <Color x:Key="ColorOutline">#737782</Color>
    <Color x:Key="ColorOutlineVariant">#C3C6D2</Color>

    <!-- Primary (cobalt) -->
    <Color x:Key="ColorPrimary">#064287</Color>
    <Color x:Key="ColorPrimaryContainer">#2C5AA0</Color>
    <Color x:Key="ColorOnPrimary">#FFFFFF</Color>
    <Color x:Key="ColorOnPrimaryContainer">#BFD3FF</Color>

    <!-- Secondary (neutral gray accent) -->
    <Color x:Key="ColorSecondary">#5D5E60</Color>
    <Color x:Key="ColorSecondaryContainer">#DFDFE1</Color>
    <Color x:Key="ColorOnSecondary">#FFFFFF</Color>
    <Color x:Key="ColorOnSecondaryContainer">#616365</Color>

    <!-- Status -->
    <Color x:Key="ColorSuccess">#2D7A4F</Color>
    <Color x:Key="ColorWarning">#C18A2C</Color>
    <Color x:Key="ColorError">#BA1A1A</Color>
    <Color x:Key="ColorErrorContainer">#FFDAD6</Color>

    <!-- Brushes (lo que la UI consume) -->
    <SolidColorBrush x:Key="SurfaceBrush"                  Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush"   Color="{StaticResource ColorSurfaceContainerLowest}"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush"      Color="{StaticResource ColorSurfaceContainerLow}"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush"         Color="{StaticResource ColorSurfaceContainer}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush"     Color="{StaticResource ColorSurfaceContainerHigh}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush"  Color="{StaticResource ColorSurfaceContainerHighest}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush"                Color="{StaticResource ColorOnSurface}"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush"         Color="{StaticResource ColorOnSurfaceVariant}"/>
    <SolidColorBrush x:Key="OutlineBrush"                  Color="{StaticResource ColorOutline}"/>
    <SolidColorBrush x:Key="OutlineVariantBrush"           Color="{StaticResource ColorOutlineVariant}"/>
    <SolidColorBrush x:Key="PrimaryBrush"                  Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush"         Color="{StaticResource ColorPrimaryContainer}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"                Color="{StaticResource ColorOnPrimary}"/>
    <SolidColorBrush x:Key="OnPrimaryContainerBrush"       Color="{StaticResource ColorOnPrimaryContainer}"/>
    <SolidColorBrush x:Key="SecondaryBrush"                Color="{StaticResource ColorSecondary}"/>
    <SolidColorBrush x:Key="SecondaryContainerBrush"       Color="{StaticResource ColorSecondaryContainer}"/>
    <SolidColorBrush x:Key="OnSecondaryBrush"              Color="{StaticResource ColorOnSecondary}"/>
    <SolidColorBrush x:Key="OnSecondaryContainerBrush"     Color="{StaticResource ColorOnSecondaryContainer}"/>
    <SolidColorBrush x:Key="OnErrorBrush"                  Color="{StaticResource ColorOnError}"/>
    <SolidColorBrush x:Key="OnErrorContainerBrush"         Color="{StaticResource ColorOnErrorContainer}"/>
    <SolidColorBrush x:Key="SuccessBrush"                  Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="WarningBrush"                  Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="ErrorBrush"                    Color="{StaticResource ColorError}"/>
    <SolidColorBrush x:Key="ErrorContainerBrush"           Color="{StaticResource ColorErrorContainer}"/>

    <!-- ================================================================
         Typography — Inter (UI) + JetBrains Mono (datos tabulares)
         Fallback a Segoe UI / Consolas si las familias no estan instaladas.
         ================================================================ -->
    <FontFamily x:Key="FontFamilyUI">Inter, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMono">JetBrains Mono, Iosevka, Consolas, monospace</FontFamily>

    <sys:Double x:Key="FontSizeH1">24</sys:Double>
    <sys:Double x:Key="FontSizeH2">18</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeLabel">11</sys:Double>
    <sys:Double x:Key="FontSizeData">12</sys:Double>

    <!-- ================================================================
         Spacing & sizing — strict 4px baseline grid
         ================================================================ -->
    <sys:Double x:Key="RowHeightDense">28</sys:Double>
    <sys:Double x:Key="InputHeight">32</sys:Double>
    <sys:Double x:Key="ContainerPadding">16</sys:Double>
    <sys:Double x:Key="ElementGap">8</sys:Double>
    <sys:Double x:Key="GridGutter">12</sys:Double>
    <CornerRadius x:Key="CornerRadiusSm">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusDefault">4</CornerRadius>
    <Thickness x:Key="HairlineThickness">1</Thickness>

    <!-- ================================================================
         Component styles (minimal — se amplian conforme se construyan vistas)
         ================================================================ -->

    <!-- Window default -->
    <Style TargetType="{x:Type Window}" x:Key="MemoriaWindowStyle">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
    </Style>

    <!-- Headers -->
    <Style TargetType="{x:Type TextBlock}" x:Key="H1Style">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeH1}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="H2Style">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeH2}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="LabelCapsStyle">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="DataTabularStyle">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeData}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Primary button (cobalt fill) -->
    <Style TargetType="{x:Type Button}" x:Key="PrimaryButtonStyle">
        <Setter Property="Background" Value="{StaticResource PrimaryContainerBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height"     Value="{StaticResource InputHeight}"/>
        <Setter Property="Padding"    Value="14,0"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" CornerRadius="{StaticResource CornerRadiusDefault}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary button (white fill, outline) -->
    <Style TargetType="{x:Type Button}" x:Key="SecondaryButtonStyle">
        <Setter Property="Background" Value="{StaticResource SurfaceContainerLowestBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height"     Value="{StaticResource InputHeight}"/>
        <Setter Property="Padding"    Value="14,0"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" CornerRadius="{StaticResource CornerRadiusDefault}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceContainerLowBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar nav item -->
    <Style TargetType="{x:Type RadioButton}" x:Key="SidebarNavItemStyle">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
        <Setter Property="Padding"    Value="12,8"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="bd" CornerRadius="{StaticResource CornerRadiusDefault}"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceContainerHighBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceContainerHighestBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab control (top tabs en pantallas Datos/Cargas/Niveles/Generar) -->
    <Style TargetType="{x:Type TabItem}" x:Key="MemoriaTabItemStyle">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
        <Setter Property="Padding"    Value="16,10"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="bd" Padding="{TemplateBinding Padding}"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}" x:Key="MemoriaTabControlStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource MemoriaTabItemStyle}"/>
    </Style>

    <!-- ================================================================
         Section card — Border con surface-container-lowest + outline-variant
         ================================================================ -->
    <Style TargetType="{x:Type Border}" x:Key="SectionCardStyle">
        <Setter Property="Background"      Value="{StaticResource SurfaceContainerLowestBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="{StaticResource CornerRadiusDefault}"/>
        <Setter Property="Padding"         Value="16"/>
    </Style>

    <!-- Field label encima del input (caption pequeña) -->
    <Style TargetType="{x:Type TextBlock}" x:Key="FieldLabelStyle">
        <Setter Property="FontFamily"    Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"      Value="{StaticResource FontSizeLabel}"/>
        <Setter Property="FontWeight"    Value="Medium"/>
        <Setter Property="Foreground"    Value="{StaticResource OnSurfaceVariantBrush}"/>
        <Setter Property="Margin"        Value="0,0,0,4"/>
    </Style>

    <!-- ================================================================
         TextBox — 32 px, hairline border, focus ring cobalt
         ================================================================ -->
    <Style TargetType="{x:Type TextBox}" x:Key="MemoriaTextBoxStyle">
        <Setter Property="Background"        Value="{StaticResource SurfaceContainerLowestBrush}"/>
        <Setter Property="Foreground"        Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="FontFamily"        Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"          Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Height"            Value="{StaticResource InputHeight}"/>
        <Setter Property="Padding"           Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush"       Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="SelectionBrush"    Value="{StaticResource PrimaryContainerBrush}"/>
        <Setter Property="CaretBrush"        Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="bd" CornerRadius="{StaticResource CornerRadiusDefault}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Background="Transparent"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox multilinea para Otros Parametros (auto-wrap, >32px) -->
    <Style TargetType="{x:Type TextBox}" x:Key="MemoriaTextAreaStyle"
           BasedOn="{StaticResource MemoriaTextBoxStyle}">
        <Setter Property="Height"             Value="Auto"/>
        <Setter Property="MinHeight"          Value="64"/>
        <Setter Property="MaxHeight"          Value="120"/>
        <Setter Property="Padding"            Value="10,8"/>
        <Setter Property="TextWrapping"       Value="Wrap"/>
        <Setter Property="AcceptsReturn"      Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- ================================================================
         ComboBox — 32 px, hairline border, dropdown estilizado
         ================================================================ -->
    <Style TargetType="{x:Type ComboBoxItem}" x:Key="MemoriaComboBoxItemStyle">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="Padding"    Value="10,6"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="bd"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceContainerHighBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceContainerHighestBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}" x:Key="MemoriaComboBoxStyle">
        <Setter Property="Background"      Value="{StaticResource SurfaceContainerLowestBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="FontFamily"      Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Height"          Value="{StaticResource InputHeight}"/>
        <Setter Property="Padding"         Value="10,0"/>
        <Setter Property="BorderBrush"     Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource MemoriaComboBoxItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="{StaticResource CornerRadiusDefault}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                <ToggleButton Grid.Column="1"
                                              Background="Transparent" BorderThickness="0"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent">
                                                <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{StaticResource OnSurfaceVariantBrush}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
                            <Border CornerRadius="{StaticResource CornerRadiusDefault}"
                                    Background="{StaticResource SurfaceContainerLowestBrush}"
                                    BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,2,0,0">
                                <ScrollViewer MaxHeight="240">
                                    <ItemsPresenter Margin="2"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         DataGrid — denso, sin lineas verticales, header surface-container-high
         row height 28 px, datos monospace
         ================================================================ -->
    <Style TargetType="{x:Type DataGridColumnHeader}" x:Key="MemoriaDataGridHeaderStyle">
        <Setter Property="Background"          Value="{StaticResource SurfaceContainerHighBrush}"/>
        <Setter Property="Foreground"          Value="{StaticResource OnSurfaceVariantBrush}"/>
        <Setter Property="FontFamily"          Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize"            Value="{StaticResource FontSizeLabel}"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="Height"              Value="28"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding"             Value="10,0"/>
        <Setter Property="BorderBrush"         Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness"     Value="0,0,0,1"/>
        <Setter Property="SeparatorBrush"      Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGridRow}" x:Key="MemoriaDataGridRowStyle">
        <Setter Property="Background" Value="{StaticResource SurfaceContainerLowestBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="Height"     Value="28"/>
        <Setter Property="MinHeight"  Value="28"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{StaticResource SurfaceContainerLowBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceContainerBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridCell}" x:Key="MemoriaDataGridCellStyle">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceContainerHighestBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGrid}" x:Key="MemoriaDataGridStyle">
        <Setter Property="Background"            Value="{StaticResource SurfaceContainerLowestBrush}"/>
        <Setter Property="Foreground"            Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="FontFamily"            Value="{StaticResource FontFamilyMono}"/>
        <Setter Property="FontSize"              Value="{StaticResource FontSizeData}"/>
        <Setter Property="BorderBrush"           Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness"       Value="1"/>
        <Setter Property="GridLinesVisibility"   Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="HeadersVisibility"     Value="Column"/>
        <Setter Property="AutoGenerateColumns"   Value="False"/>
        <Setter Property="CanUserAddRows"        Value="False"/>
        <Setter Property="CanUserDeleteRows"     Value="False"/>
        <Setter Property="CanUserResizeRows"     Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="SelectionUnit"         Value="Cell"/>
        <Setter Property="AlternationCount"      Value="2"/>
        <Setter Property="ColumnHeaderStyle"     Value="{StaticResource MemoriaDataGridHeaderStyle}"/>
        <Setter Property="RowStyle"              Value="{StaticResource MemoriaDataGridRowStyle}"/>
        <Setter Property="CellStyle"             Value="{StaticResource MemoriaDataGridCellStyle}"/>
        <Setter Property="RowHeaderWidth"        Value="0"/>
    </Style>

    <!-- ================================================================
         Hacer los estilos por default cuando no se especifica Style explicito
         (asi cualquier TextBox/ComboBox/Border en una vista hereda el look)
         ================================================================ -->
    <Style TargetType="{x:Type TextBox}"  BasedOn="{StaticResource MemoriaTextBoxStyle}"/>
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MemoriaComboBoxStyle}"/>
    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MemoriaDataGridStyle}"/>

</ResourceDictionary>
