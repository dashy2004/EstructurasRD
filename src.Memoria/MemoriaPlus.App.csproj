<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MemoriaPlus</AssemblyName>
    <RootNamespace>MemoriaPlus</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Authors>Emil Guillen De la Cruz</Authors>
    <Product>Memoria Plus</Product>
    <Description>
      Generador de memorias de calculo estructural en formato .docx, basado en
      el modelo de dominio compartido de LosasPlus.Core. Aplica fórmulas de espesor
      y carga, parsea salidas del software F. Perdomo (Losas v5.20), y rellena
      una plantilla Word con los placeholders por nivel.
    </Description>
    <Copyright>(c) 2026 Emil Guillen De la Cruz. Memoria Plus.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src.Core\LosasPlus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plantillas .docx empaquetadas con la app — disponibles en
         %APP_BASE%\Resources\templates\ tras el build / publish.
         El usuario eventualmente podra agregar las suyas via la pestaña
         Plantillas (commit dedicado). -->
    <Content Include="Resources\templates\*.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- DocumentFormat.OpenXml SDK para la generacion .docx (Content Controls / SDT,
         imagenes, fórmulas OMML). Version alineada con la transitiva de ClosedXML
         para evitar downgrade. Open-XML-PowerTools se agregara cuando se necesiten
         helpers de fusion de runs / clonado de secciones. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

</Project>
