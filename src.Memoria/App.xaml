<Application x:Class="MemoriaPlus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cmn="clr-namespace:MemoriaPlus.Common;assembly=MemoriaPlus.UI.Shared"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MemoriaPlus.UI.Shared;component/Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cmn:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
            <cmn:BordeKindToStrokeDashConverter       x:Key="BordeKindToStrokeDashConverter"/>
            <cmn:BordeKindToThicknessConverter        x:Key="BordeKindToThicknessConverter"/>
            <cmn:TipoLosaBordeStrokeDashConverter     x:Key="TipoLosaBordeStrokeDashConverter"/>
            <cmn:TipoLosaBordeThicknessConverter      x:Key="TipoLosaBordeThicknessConverter"/>
            <cmn:PathToImageConverter                 x:Key="PathToImageConverter"/>
            <cmn:StringNotEmptyToBoolConverter        x:Key="StringNotEmptyToBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
