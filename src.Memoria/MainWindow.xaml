<Window x:Class="MemoriaPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
        xmlns:vw="clr-namespace:MemoriaPlus.Views"
        Title="Memoria Plus"
        Height="900" Width="1440"
        MinHeight="640" MinWidth="1100"
        Style="{StaticResource MemoriaWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===========================================================
             Sidebar (240 px) — branding + navegacion + perfil
             =========================================================== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceContainerLowBrush}"
                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- header -->
                    <RowDefinition Height="Auto"/>  <!-- CTA Nuevo proyecto -->
                    <RowDefinition Height="Auto"/>  <!-- nav primary -->
                    <RowDefinition Height="*"/>     <!-- proyectos recientes -->
                    <RowDefinition Height="Auto"/>  <!-- footer -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="20,20,20,8">
                    <TextBlock Text="Memoria Plus"
                               FontFamily="{StaticResource FontFamilyUI}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding Version}"
                               FontFamily="{StaticResource FontFamilyMono}"
                               FontSize="11"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Nuevo proyecto -->
                <Button Grid.Row="1" Margin="16,4,16,12"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="+ Nuevo proyecto"/>

                <!-- Navegacion primaria -->
                <StackPanel Grid.Row="2" Margin="8,0,8,8">
                    <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                 GroupName="SidebarNav" IsChecked="True"
                                 Content="📂  Explorador"/>
                    <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                 GroupName="SidebarNav"
                                 Content="🔍  Búsqueda"/>
                    <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                 GroupName="SidebarNav"
                                 Content="🧮  Cálculos"/>
                    <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                 GroupName="SidebarNav"
                                 Content="📚  Plantillas"/>
                    <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                 GroupName="SidebarNav"
                                 Content="⚙  Configuración"/>
                </StackPanel>

                <!-- Proyectos recientes -->
                <Border Grid.Row="3" Margin="16,8,16,8" Padding="0"
                        Background="Transparent">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelCapsStyle}"
                                   Text="PROYECTOS RECIENTES"
                                   Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ProyectosRecientes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="0,1"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource CornerRadiusDefault}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontFamily="{StaticResource FontFamilyUI}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource OnSurfaceBrush}"/>
                                            <TextBlock FontFamily="{StaticResource FontFamilyMono}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                                       Margin="0,1,0,0">
                                                <Run Text="{Binding Ingeniero, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding UltimaEdicion, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Footer sidebar -->
                <Border Grid.Row="4" Padding="16,12"
                        BorderBrush="{StaticResource OutlineVariantBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   FontSize="11">
                            <Run Text="Soporte"/>  ·  <Run Text="Documentación"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===========================================================
             Contenido principal — tabs Datos/Cargas/Niveles/Generar
             =========================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- top bar (tabs + acciones) -->
                <RowDefinition Height="*"/>     <!-- contenido tab -->
                <RowDefinition Height="Auto"/>  <!-- statusbar -->
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Padding="16,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TabControl x:Name="TopTabs"
                                Grid.Column="0"
                                Style="{StaticResource MemoriaTabControlStyle}"
                                ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding TabActivo}"
                                Background="Transparent"
                                BorderThickness="0">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Titulo}"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <!-- Vacio: el contenido real se rendera abajo via ContentPresenter
                                 con DataTrigger por Slug, para evitar instanciar 4 veces. -->
                            <DataTemplate>
                                <Grid/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Guardar borrador" Margin="0,0,8,0"
                                Command="{Binding GuardarBorradorCommand}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding TextoBotonContinuar}"
                                Command="{Binding ContinuarCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenido del tab activo (switch por Slug) -->
            <ContentControl Grid.Row="1">
                <ContentControl.Style>
                    <Style TargetType="{x:Type ContentControl}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TabActivo.Slug}" Value="DatosGenerales">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:DatosGeneralesView/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TabActivo.Slug}" Value="Cargas">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:CargasView/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TabActivo.Slug}" Value="Niveles">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:NivelesView/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TabActivo.Slug}" Value="Generar">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:GenerarView/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- Statusbar inferior -->
            <Border Grid.Row="2" Padding="16,6"
                    Background="{StaticResource SurfaceContainerLowBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontFamily="{StaticResource FontFamilyMono}"
                               FontSize="11"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Text="© 2026 Memoria Plus Engineering"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Text="Sistema: Operativo"/>
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Margin="16,0,0,0"
                                   Text="{Binding Version}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
