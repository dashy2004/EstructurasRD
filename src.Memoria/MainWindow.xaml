<Window x:Class="MemoriaPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
        xmlns:vw="clr-namespace:MemoriaPlus.Views"
        Title="{Binding TituloVentana}"
        Height="900" Width="1440"
        MinHeight="640" MinWidth="1100"
        Style="{StaticResource MemoriaWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <!-- Atajos de teclado globales (commit 18: persistencia). -->
        <KeyBinding Modifiers="Ctrl"       Key="N" Command="{Binding NuevoProyectoCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="O" Command="{Binding AbrirProyectoCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="S" Command="{Binding GuardarBorradorCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding GuardarComoCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="G" Command="{Binding GenerarMemoriaCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===========================================================
             Sidebar (240 px) — branding + navegación + perfil
             =========================================================== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceContainerLowBrush}"
                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- header -->
                    <RowDefinition Height="Auto"/>  <!-- CTA Nuevo proyecto -->
                    <RowDefinition Height="Auto"/>  <!-- nav primary -->
                    <RowDefinition Height="*"/>     <!-- proyectos recientes -->
                    <RowDefinition Height="Auto"/>  <!-- footer -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="20,20,20,8">
                    <TextBlock Text="Memoria Plus"
                               FontFamily="{StaticResource FontFamilyUI}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding Version}"
                               FontFamily="{StaticResource FontFamilyMono}"
                               FontSize="11"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Nuevo proyecto / Abrir -->
                <StackPanel Grid.Row="1" Margin="16,4,16,12">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="+ Nuevo proyecto"
                            Command="{Binding NuevoProyectoCommand}"/>
                    <Button Margin="0,6,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="📂 Abrir proyecto…"
                            Command="{Binding AbrirProyectoCommand}"/>
                </StackPanel>

                <!-- =================== Navegación primaria ===================
                     Cada RadioButton enlaza IsChecked al enum ModoActivo via
                     EnumToBoolConverter. Click → ConvertBack devuelve el enum
                     correspondiente y actualiza el VM, lo cual dispara el
                     switch del contenido principal y el visible/oculto del
                     top bar de tabs.
                     =========================================================== -->
                <StackPanel Grid.Row="2" Margin="8,0,8,8">
                    <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                 GroupName="SidebarNav"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Explorador}"
                                 Content="📂  Explorador"/>
                    <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                 GroupName="SidebarNav"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Busqueda}"
                                 Content="🔍  Búsqueda"/>
                    <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                 GroupName="SidebarNav"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Calculos}"
                                 Content="🧮  Cálculos"/>
                    <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                 GroupName="SidebarNav"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Plantillas}"
                                 Content="📚  Plantillas"/>
                    <RadioButton Style="{StaticResource SidebarNavItemStyle}"
                                 GroupName="SidebarNav"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Configuracion}"
                                 Content="⚙  Configuración"/>
                </StackPanel>

                <!-- Proyectos recientes (lista compacta) -->
                <Border Grid.Row="3" Margin="16,8,16,8" Padding="0"
                        Background="Transparent">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelCapsStyle}"
                                   Text="PROYECTOS RECIENTES"
                                   Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ProyectosRecientes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Button con Command bind al ViewModel pasando el Path como
                                         parametro. Sin Button no hay click. Styled invisible para
                                         que se vea como el card original. -->
                                    <Button Margin="0,1" Padding="8,6" Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            ToolTip="{Binding Path}"
                                            Command="{Binding DataContext.AbrirProyectoRecienteCommand,
                                                              RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding Path}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="bd" Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="{StaticResource CornerRadiusDefault}">
                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background"
                                                                Value="{StaticResource SurfaceContainerHighBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontFamily="{StaticResource FontFamilyUI}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource OnSurfaceBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontFamily="{StaticResource FontFamilyMono}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                                       Margin="0,1,0,0">
                                                <Run Text="{Binding Ingeniero, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding UltimaEdicion, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Footer sidebar -->
                <Border Grid.Row="4" Padding="16,12"
                        BorderBrush="{StaticResource OutlineVariantBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   FontSize="11">
                            <Run Text="Soporte"/>  ·  <Run Text="Documentación"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===========================================================
             Contenido principal — switch por ModoActivo
             - Calculos: top bar (tabs + acciones) + 4 vistas internas
             - Explorador: hub de proyectos
             - Búsqueda/Plantillas/Configuración: ComingSoonView
             =========================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- top bar (visible solo en Calculos) -->
                <RowDefinition Height="*"/>     <!-- contenido switch -->
                <RowDefinition Height="Auto"/>  <!-- statusbar -->
            </Grid.RowDefinitions>

            <!-- ============================================================
                 Top bar — solo en modo Calculos
                 ============================================================ -->
            <Border Grid.Row="0" Padding="16,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModoActivo}" Value="Calculos">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TabControl x:Name="TopTabs"
                                Grid.Column="0"
                                Style="{StaticResource MemoriaTabControlStyle}"
                                ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding TabActivo}"
                                Background="Transparent"
                                BorderThickness="0">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Titulo}"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <Grid/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Guardar borrador" Margin="0,0,8,0"
                                Command="{Binding GuardarBorradorCommand}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding TextoBotonContinuar}"
                                Command="{Binding ContinuarCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================
                 Contenido principal — switch por ModoActivo
                 ============================================================ -->
            <ContentControl Grid.Row="1">
                <ContentControl.Style>
                    <Style TargetType="{x:Type ContentControl}">
                        <Style.Triggers>
                            <!-- ====== Modo Calculos: switch interno por TabActivo ====== -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ModoActivo}" Value="Calculos"/>
                                    <Condition Binding="{Binding TabActivo.Slug}" Value="DatosGenerales"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:DatosGeneralesView/>
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ModoActivo}" Value="Calculos"/>
                                    <Condition Binding="{Binding TabActivo.Slug}" Value="Cargas"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:CargasView/>
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ModoActivo}" Value="Calculos"/>
                                    <Condition Binding="{Binding TabActivo.Slug}" Value="Niveles"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:NivelesView/>
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ModoActivo}" Value="Calculos"/>
                                    <Condition Binding="{Binding TabActivo.Slug}" Value="Generar"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:GenerarView/>
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger>

                            <!-- ====== Modos sin top bar ====== -->
                            <DataTrigger Binding="{Binding ModoActivo}" Value="Explorador">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:ExploradorView/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ModoActivo}" Value="Busqueda">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:ComingSoonView Tag="Búsqueda global"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ModoActivo}" Value="Plantillas">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:ComingSoonView Tag="Gestión de plantillas .docx"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ModoActivo}" Value="Configuracion">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <vw:ConfiguracionView/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- Statusbar inferior -->
            <Border Grid.Row="2" Padding="16,6"
                    Background="{StaticResource SurfaceContainerLowBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontFamily="{StaticResource FontFamilyMono}"
                               FontSize="11"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Text="© 2026 Memoria Plus Engineering"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Text="Sistema: Operativo"/>
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Margin="16,0,0,0"
                                   Text="{Binding Version}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
