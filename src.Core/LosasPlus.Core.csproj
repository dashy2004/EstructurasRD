<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LosasPlus.Core</AssemblyName>
    <RootNamespace>LosasPlus</RootNamespace>
    <Version>0.1.0</Version>
    <!-- CA2255: ModuleInitializer en librería es intencional para registrar cp1252
         (requerido por el parser de .DL/.TXT). Comportamiento documentado en
         EncodingInit.cs y verificado en tests. -->
    <!-- CS0618: la fachada Proyecto.Sistemas y los campos Sistema.CotaMetros/
         Elevacion están marcados [Obsolete] (B3) pero se conservan FUNCIONANDO
         durante la ventana de deprecación (back-compat + migración v3→v4). El
         atributo sigue señalando el API en el IDE; aquí silenciamos sólo el ruido
         de los lectores internos legítimos. -->
    <NoWarn>$(NoWarn);CA2255;CS0618</NoWarn>
    <Authors>Emil Guillen De la Cruz</Authors>
    <Product>LosasPlus.Core</Product>
    <Description>
      Modelo de dominio y servicios sin dependencias de UI compartidos por LosasPlus
      (wrapper sobre Losas.exe de F. Perdomo) y MemoriaPlus (generador de memorias
      de calculo). Contiene Proyecto/Sistema/Losa, parsers de .DL y .TXT, exportadores
      CSV/XLSX, y sandbox de plugins Roslyn.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tablas de coeficientes Pieper-Martens (F. Perdomo) embebidas: las carga
         TablaPieperMartens vía GetManifestResourceStream. Logical name =
         LosasPlus.Calculo.PieperMartens.TablasPerdomo.json -->
    <EmbeddedResource Include="Calculo\PieperMartens\TablasPerdomo.json" />
    <!-- Logo de la aplicación (rasterizado del SVG de marca) para el encabezado
         de la Memoria de cálculo. Logical name = LosasPlus.Resources.EstructurasRD.png -->
    <EmbeddedResource Include="Resources\EstructurasRD.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- DocumentFormat.OpenXml: usado por MemoriaGenerator para sustituir
         placeholders y rellenar tablas en la plantilla .docx. Version alineada
         con la transitiva que ClosedXML pide (>=3.1.1 <4.0.0). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.10.0" />
    <PackageReference Include="netDxf" Version="2023.11.10" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
