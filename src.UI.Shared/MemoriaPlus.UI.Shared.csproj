<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Port WPF -> Avalonia: net8.0-windows + UseWPF reemplazados por net8.0
         multiplataforma. Avalonia corre en Linux/Windows/macOS. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MemoriaPlus.UI.Shared</AssemblyName>
    <!-- Namespace raíz mantenido como MemoriaPlus.* para no tocar los
         using/xmlns existentes en src.Memoria. -->
    <RootNamespace>MemoriaPlus</RootNamespace>
    <Version>0.5.0</Version>
    <Authors>Emil Guillen De la Cruz</Authors>
    <Product>Memoria Plus UI Shared</Product>
    <Description>
      Componentes Avalonia compartidos entre LosasPlus.App y MemoriaPlus.App:
      Validación normativa, Búsqueda global, Plantillas .docx,
      Configuración (perfil + apariencia + atajos), Selector visual de
      tipo de losa, converters y commands base.
    </Description>
    <Copyright>(c) 2026 Emil Guillen De la Cruz.</Copyright>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- CS0618: API legacy [Obsolete] (B3) conservada funcionando; ver src.Core. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src.Core\LosasPlus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.*" />
    <!-- SVG (reemplaza SharpVectors): render de los iconos de tipo de losa.
         OJO: se fija a 11.2.0.x porque Avalonia.Svg.Skia 11.3.0 saltó a
         SkiaSharp 3.116, incompatible con el SkiaSharp 2.88.9 que usa
         Avalonia 11.3 core (provoca crash de versión del nativo libSkiaSharp). -->
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Iconos de tipos de losa (catálogo Pieper-Martens) + tema compartido,
         empaquetados como recursos Avalonia (avares://). -->
    <AvaloniaResource Include="Resources\icons\*.svg" />
    <AvaloniaResource Include="Resources\Theme.axaml" />
  </ItemGroup>

</Project>
