<UserControl x:Class="MemoriaPlus.Views.AparienciaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ConfiguracionViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource SurfaceBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel>

            <TextBlock Style="{StaticResource H1Style}" Text="Apariencia"/>
            <TextBlock Margin="0,4,0,24"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="13"
                       Text="Personaliza el aspecto de Memoria Plus."/>

            <!-- 3 cards horizontales -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: TEMA -->
                <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelCapsStyle}" Text="🎨  TEMA"/>
                        <TextBlock Margin="0,4,0,16"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Text="Selecciona el modo de color de la interfaz."/>
                        <UniformGrid Rows="1" Columns="2">
                            <RadioButton GroupName="Tema"
                                         IsChecked="{Binding Apariencia.Tema, ConverterParameter=Claro,
                                                     Converter={StaticResource EnumToBoolConverter}}"
                                         Margin="0,0,4,0">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="bd" Padding="0,18"
                                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                                BorderBrush="{StaticResource OutlineVariantBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CornerRadiusDefault}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="☀" FontSize="28" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                                                <TextBlock Text="Claro" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontFamily="{StaticResource FontFamilyUI}" FontSize="12"
                                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceContainerLowBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <RadioButton GroupName="Tema"
                                         IsChecked="{Binding Apariencia.Tema, ConverterParameter=Oscuro,
                                                     Converter={StaticResource EnumToBoolConverter}}"
                                         Margin="4,0,0,0">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="bd" Padding="0,18"
                                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                                BorderBrush="{StaticResource OutlineVariantBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CornerRadiusDefault}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="☾" FontSize="28" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                                                <TextBlock Text="Oscuro" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                           FontFamily="{StaticResource FontFamilyUI}" FontSize="12"
                                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceContainerLowBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: TIPOGRAFÍA -->
                <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelCapsStyle}" Text="🔤  TIPOGRAFÍA (DATOS)"/>
                        <TextBlock Margin="0,4,0,16"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Text="Fuente monoespaciada para tablas de cálculo."/>
                        <StackPanel>
                            <RadioButton GroupName="Tipografia" Margin="0,0,0,6"
                                         IsChecked="{Binding Apariencia.TipografiaDatos, ConverterParameter=JetBrains Mono,
                                                     Converter={StaticResource EnumToBoolConverter}}"
                                         Content="JetBrains Mono — 0123456789"
                                         FontFamily="JetBrains Mono, Consolas"/>
                            <RadioButton GroupName="Tipografia" Margin="0,0,0,6"
                                         IsChecked="{Binding Apariencia.TipografiaDatos, ConverterParameter=Iosevka,
                                                     Converter={StaticResource EnumToBoolConverter}}"
                                         Content="Iosevka — 0123456789"
                                         FontFamily="Iosevka, Consolas"/>
                            <RadioButton GroupName="Tipografia"
                                         IsChecked="{Binding Apariencia.TipografiaDatos, ConverterParameter=Consolas,
                                                     Converter={StaticResource EnumToBoolConverter}}"
                                         Content="Consolas — 0123456789"
                                         FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 3: DENSIDAD -->
                <Border Grid.Column="4" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelCapsStyle}" Text="📏  DENSIDAD"/>
                        <TextBlock Margin="0,4,0,16"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Text="Ajuste de altura de filas en tablas de datos."/>
                        <StackPanel>
                            <RadioButton GroupName="Densidad" Margin="0,0,0,6"
                                         IsChecked="{Binding Apariencia.Densidad, ConverterParameter=Compacto,
                                                     Converter={StaticResource EnumToBoolConverter}}">
                                <Grid HorizontalAlignment="Stretch">
                                    <TextBlock Text="Compacto" HorizontalAlignment="Left"/>
                                    <TextBlock Text="24 px" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource FontFamilyMono}"
                                               Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                                </Grid>
                            </RadioButton>
                            <RadioButton GroupName="Densidad" Margin="0,0,0,6"
                                         IsChecked="{Binding Apariencia.Densidad, ConverterParameter=Medio,
                                                     Converter={StaticResource EnumToBoolConverter}}">
                                <Grid HorizontalAlignment="Stretch">
                                    <TextBlock Text="Medio" HorizontalAlignment="Left"/>
                                    <TextBlock Text="28 px" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource FontFamilyMono}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </RadioButton>
                            <RadioButton GroupName="Densidad"
                                         IsChecked="{Binding Apariencia.Densidad, ConverterParameter=Cómodo,
                                                     Converter={StaticResource EnumToBoolConverter}}">
                                <Grid HorizontalAlignment="Stretch">
                                    <TextBlock Text="Cómodo" HorizontalAlignment="Left"/>
                                    <TextBlock Text="32 px" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource FontFamilyMono}"
                                               Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====================================================================
                 CARD 4: COLOR DE ACENTO — paleta visual + entrada hex personalizada
                 ==================================================================== -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="🎯  COLOR DE ACENTO"/>
                    <TextBlock Margin="0,4,0,12"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="11" TextWrapping="Wrap"
                               Text="Click en un color para usarlo como acento, o ingresa un hex personalizado."/>

                    <!-- 8 swatches en grid horizontal -->
                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!-- Paleta default: 8 colores diseñados para legibilidad sobre claro/oscuro -->
                        <Button Tag="#0E639C" Background="#0E639C" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip="Azul VS Code (#0E639C)"
                                Command="{Binding AplicarColorAcentoHexCommand}"
                                CommandParameter="#0E639C"/>
                        <Button Tag="#2E7D32" Background="#2E7D32" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip="Verde estructural (#2E7D32)"
                                Command="{Binding AplicarColorAcentoHexCommand}"
                                CommandParameter="#2E7D32"/>
                        <Button Tag="#C62828" Background="#C62828" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip="Rojo alerta (#C62828)"
                                Command="{Binding AplicarColorAcentoHexCommand}"
                                CommandParameter="#C62828"/>
                        <Button Tag="#EF6C00" Background="#EF6C00" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip="Naranja construcción (#EF6C00)"
                                Command="{Binding AplicarColorAcentoHexCommand}"
                                CommandParameter="#EF6C00"/>
                        <Button Tag="#6A1B9A" Background="#6A1B9A" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip="Púrpura ingeniería (#6A1B9A)"
                                Command="{Binding AplicarColorAcentoHexCommand}"
                                CommandParameter="#6A1B9A"/>
                        <Button Tag="#AD1457" Background="#AD1457" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip="Magenta diseño (#AD1457)"
                                Command="{Binding AplicarColorAcentoHexCommand}"
                                CommandParameter="#AD1457"/>
                        <Button Tag="#37474F" Background="#37474F" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip="Gris hormigón (#37474F)"
                                Command="{Binding AplicarColorAcentoHexCommand}"
                                CommandParameter="#37474F"/>
                        <Button Tag="#B8860B" Background="#B8860B" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip="Dorado clásico (#B8860B)"
                                Command="{Binding AplicarColorAcentoHexCommand}"
                                CommandParameter="#B8860B"/>
                    </ItemsControl>

                    <!-- Entrada hex personalizada + chip preview del color actual -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="Hex personalizado:"/>
                        <TextBox Grid.Column="1" Margin="0,0,8,0"
                                 Text="{Binding Apariencia.ColorAcentoHex, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Formato #RRGGBB (ej. #0E639C). Vacío = usar default del tema."
                                 FontFamily="{StaticResource FontFamilyMono}"/>
                        <Button Grid.Column="2" Content="Limpiar" Padding="10,4"
                                Command="{Binding AplicarColorAcentoHexCommand}"
                                CommandParameter=""/>
                        <Border Grid.Column="3" Width="32" Height="32" Margin="8,0,0,0"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusDefault}">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding Apariencia.ColorAcentoHex, FallbackValue=Transparent, TargetNullValue=Transparent}"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ====================================================================
                 CARD 5: PRESETS — guardar combinaciones nombradas y alternar
                 ==================================================================== -->
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelCapsStyle}" Text="💾  PRESETS"/>
                    <TextBlock Margin="0,4,0,12"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="11" TextWrapping="Wrap"
                               Text="Guarda esta combinación (tema + tipografía + densidad + color) con un nombre y alternalo después con un click."/>

                    <!-- Guardar como nuevo preset -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0"
                                 Text="{Binding NombrePresetNuevo, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Ej. 'Estructural oscuro', 'Daylight oficina'..."/>
                        <Button Grid.Column="1" Content="Guardar como preset"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,4"
                                Command="{Binding GuardarComoPresetCommand}"/>
                    </Grid>

                    <!-- Cargar/eliminar preset existente -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,8,0"
                                  ItemsSource="{Binding PresetsDisponibles}"
                                  SelectedItem="{Binding PresetSeleccionado, Mode=TwoWay}"
                                  ToolTip="Presets guardados (se almacenan en %APPDATA%/LosasPlus/themes.json)"/>
                        <Button Grid.Column="1" Content="Cargar" Padding="12,4" Margin="0,0,4,0"
                                Command="{Binding CargarPresetCommand}"
                                CommandParameter="{Binding PresetSeleccionado}"/>
                        <Button Grid.Column="2" Content="Eliminar" Padding="12,4"
                                Command="{Binding EliminarPresetCommand}"
                                CommandParameter="{Binding PresetSeleccionado}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- FOOTER: Acciones -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="↺ Restaurar defaults"
                        Padding="14,0" Margin="0,0,8,0"
                        Command="{Binding RestaurarAparienciaCommand}"/>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="💾 Aplicar y guardar"
                        Padding="16,0"
                        Command="{Binding GuardarAparienciaCommand}"/>
            </StackPanel>

            <TextBlock Margin="0,16,0,0"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="11" TextWrapping="Wrap"
                       Text="Algunos cambios (tema oscuro completo, fuentes) requieren reiniciar la app para aplicarse al ResourceDictionary global. La densidad y el color de acento aplican en vivo."/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
