<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
             xmlns:cmn="clr-namespace:MemoriaPlus.Common"
             x:Class="MemoriaPlus.Views.DatosIngenieroView"
             x:CompileBindings="False"
             Background="{StaticResource SurfaceBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Theme="{StaticResource H1Style}" Text="Datos del ingeniero"/>
            <TextBlock Margin="0,4,0,16"
                       Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="13"
                       Text="Este perfil precarga automáticamente los campos de proyectos nuevos."/>

            <!-- IDENTIDAD -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="🆔  IDENTIDAD"/>
                    <Grid Margin="0,12,0,0" RowDefinitions="Auto,8,Auto" ColumnDefinitions="*,12,*,12,*">
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Nombre completo"/>
                            <TextBox Text="{Binding Perfil.Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="CODIA"/>
                            <TextBox Text="{Binding Perfil.Codia, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Especialidad"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      SelectedValue="{Binding Perfil.Especialidad, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="Estructural"/>
                                <ComboBoxItem Content="Hidráulico"/>
                                <ComboBoxItem Content="Eléctrico"/>
                                <ComboBoxItem Content="Sanitario"/>
                                <ComboBoxItem Content="Vial"/>
                                <ComboBoxItem Content="Otro"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CONTACTO -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="📞  CONTACTO"/>
                    <Grid Margin="0,12,0,0" RowDefinitions="Auto,8,Auto" ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Teléfono fijo"/>
                            <TextBox Text="{Binding Perfil.TelefonoFijo, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Teléfono celular"/>
                            <TextBox Text="{Binding Perfil.TelefonoCelular, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Email"/>
                            <TextBox Text="{Binding Perfil.Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Ciudad / oficina"/>
                            <TextBox Text="{Binding Perfil.Ciudad, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- FIRMA Y SELLO con drag-drop + preview -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="✍  FIRMA Y SELLO"/>
                    <TextBlock Margin="0,4,0,12"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="11" TextWrapping="Wrap"
                               Text="Arrastra los archivos PNG/JPG aquí o usa el botón Examinar. La firma se imprime sobre las hojas finales de la memoria; el sello identifica tu oficina."/>
                    <Grid ColumnDefinitions="*,16,*">
                        <!-- DROP ZONE: FIRMA -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Firma (PNG con fondo transparente)"/>
                            <Border x:Name="FirmaDropZone" Height="180"
                                    DragDrop.AllowDrop="True"
                                    Background="{StaticResource SurfaceContainerLowestBrush}"
                                    BorderBrush="{StaticResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadiusDefault}">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                                IsVisible="{Binding Perfil.FirmaPath, Converter={x:Static cmn:StringConverters.IsNullOrEmpty}}">
                                        <TextBlock Text="📥" FontSize="28" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource OutlineBrush}"/>
                                        <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                                   FontSize="11" Foreground="{StaticResource OnSurfaceVariantBrush}"
                                                   Text="Arrastra un PNG aquí o usa Examinar"/>
                                    </StackPanel>
                                    <Border Padding="8"
                                            IsVisible="{Binding Perfil.FirmaPath, Converter={x:Static cmn:StringConverters.NotNullOrEmpty}}">
                                        <Image Source="{Binding Perfil.FirmaPath, Converter={x:Static cmn:PathToImageConverter.Instance}}"
                                               Stretch="Uniform" StretchDirection="DownOnly"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="10"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Perfil.FirmaPath}"
                                       Text="{Binding Perfil.FirmaPath, TargetNullValue='(sin firma)'}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Theme="{StaticResource SecondaryButtonStyle}"
                                        Content="📂 Examinar…" Padding="10,2" Click="ExaminarFirma_Click"/>
                                <Button Theme="{StaticResource SecondaryButtonStyle}"
                                        Content="✕ Quitar" Padding="10,2" Margin="6,0,0,0" Click="QuitarFirma_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- DROP ZONE: SELLO -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Sello / logo de oficina"/>
                            <Border x:Name="SelloDropZone" Height="180"
                                    DragDrop.AllowDrop="True"
                                    Background="{StaticResource SurfaceContainerLowestBrush}"
                                    BorderBrush="{StaticResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadiusDefault}">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                                IsVisible="{Binding Perfil.SelloPath, Converter={x:Static cmn:StringConverters.IsNullOrEmpty}}">
                                        <TextBlock Text="📥" FontSize="28" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource OutlineBrush}"/>
                                        <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                                   FontSize="11" Foreground="{StaticResource OnSurfaceVariantBrush}"
                                                   Text="Arrastra un PNG/JPG aquí o usa Examinar"/>
                                    </StackPanel>
                                    <Border Padding="8"
                                            IsVisible="{Binding Perfil.SelloPath, Converter={x:Static cmn:StringConverters.NotNullOrEmpty}}">
                                        <Image Source="{Binding Perfil.SelloPath, Converter={x:Static cmn:PathToImageConverter.Instance}}"
                                               Stretch="Uniform" StretchDirection="DownOnly"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="10"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Perfil.SelloPath}"
                                       Text="{Binding Perfil.SelloPath, TargetNullValue='(sin sello)'}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Theme="{StaticResource SecondaryButtonStyle}"
                                        Content="📂 Examinar…" Padding="10,2" Click="ExaminarSello_Click"/>
                                <Button Theme="{StaticResource SecondaryButtonStyle}"
                                        Content="✕ Quitar" Padding="10,2" Margin="6,0,0,0" Click="QuitarSello_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- FORMACIÓN (opcional) -->
            <Expander Margin="0,0,0,12" IsExpanded="False"
                      Foreground="{StaticResource OnSurfaceBrush}">
                <Expander.Header>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="🎓  FORMACIÓN (opcional)"/>
                </Expander.Header>
                <Border Theme="{StaticResource SectionCardStyle}" Margin="0,8,0,0">
                    <Grid RowDefinitions="Auto,8,Auto" ColumnDefinitions="2*,12,*">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Universidad"/>
                            <TextBox Text="{Binding Perfil.Universidad, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Año de graduación"/>
                            <TextBox Text="{Binding Perfil.AnoGraduacion, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Theme="{StaticResource FieldLabelStyle}" Text="Maestría / Postgrado"/>
                            <TextBox Text="{Binding Perfil.PostGrado, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>

            <!-- FOOTER -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                <Button Theme="{StaticResource PrimaryButtonStyle}"
                        Content="💾 Guardar perfil" Padding="16,0"
                        Command="{Binding GuardarPerfilCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
