<Window x:Class="MemoriaPlus.Views.SelectorTipoLosaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:SelectorTipoLosaViewModel}"
        mc:Ignorable="d"
        Title="Seleccionar tipo de losa"
        Width="780" Height="620"
        MinWidth="640" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Pill style reused from validation panel (commit 21) -->
        <Style x:Key="GrupoPillStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="bd" Padding="10,4"
                                Background="{StaticResource SurfaceContainerLowBrush}"
                                BorderBrush="{StaticResource OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusSm}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card de tipo de losa: icono visual con 4 bordes (N/E/S/W) + número.
             Cada Line bindea sobre el TipoLosa (DataContext) con ConverterParameter
             0/1/2/3 para extraer el BordeKind del lado correspondiente y traducirlo
             a StrokeDashArray + StrokeThickness. -->
        <Style x:Key="TipoCardContainerStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="bd" Width="110" Height="110"
                                Background="{StaticResource SurfaceContainerLowestBrush}"
                                BorderBrush="{StaticResource OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusDefault}"
                                ToolTip="{Binding Descripcion}">
                            <Grid>
                                <!-- Icono visual: cuadrado 68×68 con los 4 lados.
                                     Origen 0,0 en esquina sup-izq. Convención NESW. -->
                                <Grid Width="68" Height="68"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="0,0,0,16">
                                    <!-- Norte (idx 0) -->
                                    <Line X1="0" Y1="0" X2="68" Y2="0"
                                          Stroke="{StaticResource OnSurfaceBrush}"
                                          StrokeDashArray="{Binding Converter={StaticResource TipoLosaBordeStrokeDashConverter}, ConverterParameter=0}"
                                          StrokeThickness="{Binding Converter={StaticResource TipoLosaBordeThicknessConverter}, ConverterParameter=0}"/>
                                    <!-- Este (idx 1) -->
                                    <Line X1="68" Y1="0" X2="68" Y2="68"
                                          Stroke="{StaticResource OnSurfaceBrush}"
                                          StrokeDashArray="{Binding Converter={StaticResource TipoLosaBordeStrokeDashConverter}, ConverterParameter=1}"
                                          StrokeThickness="{Binding Converter={StaticResource TipoLosaBordeThicknessConverter}, ConverterParameter=1}"/>
                                    <!-- Sur (idx 2) -->
                                    <Line X1="0" Y1="68" X2="68" Y2="68"
                                          Stroke="{StaticResource OnSurfaceBrush}"
                                          StrokeDashArray="{Binding Converter={StaticResource TipoLosaBordeStrokeDashConverter}, ConverterParameter=2}"
                                          StrokeThickness="{Binding Converter={StaticResource TipoLosaBordeThicknessConverter}, ConverterParameter=2}"/>
                                    <!-- Oeste (idx 3) -->
                                    <Line X1="0" Y1="0" X2="0" Y2="68"
                                          Stroke="{StaticResource OnSurfaceBrush}"
                                          StrokeDashArray="{Binding Converter={StaticResource TipoLosaBordeStrokeDashConverter}, ConverterParameter=3}"
                                          StrokeThickness="{Binding Converter={StaticResource TipoLosaBordeThicknessConverter}, ConverterParameter=3}"/>
                                    <!-- Código numérico al centro del cuadrado -->
                                    <TextBlock Text="{Binding Codigo}"
                                               FontFamily="{StaticResource FontFamilyMono}"
                                               FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource OnSurfaceBrush}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceContainerHighBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceContainerLowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- filtros + busqueda -->
            <RowDefinition Height="*"/>     <!-- grid de cards -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource H2Style}"
                       Text="Seleccionar tipo de losa"
                       VerticalAlignment="Center"/>
            <Border Grid.Column="1" Margin="12,0,0,0"
                    Padding="8,2" VerticalAlignment="Center"
                    Background="#26FFA000"
                    CornerRadius="{StaticResource CornerRadiusSm}">
                <TextBlock Text="Catálogo Pieper-Martens"
                           FontFamily="{StaticResource FontFamilyMono}"
                           FontSize="11"
                           Foreground="{StaticResource OnSurfaceBrush}"/>
            </Border>
            <TextBox Grid.Column="3"
                     VerticalContentAlignment="Center"
                     Padding="8,4"
                     Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Buscar por código o descripción"/>
        </Grid>

        <!-- FILTROS (pills) -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <RadioButton Style="{StaticResource GrupoPillStyle}"
                         GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoTodos, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}"
                         CommandParameter="Todos">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
                    <Run Text="Todos · "/>
                    <Run Text="{Binding ConteoTotal, Mode=OneWay}"/>
                </TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource GrupoPillStyle}"
                         GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoApoyoSimple, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}"
                         CommandParameter="ApoyoSimple">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
                    <Run Text="Apoyo simple · "/>
                    <Run Text="{Binding ConteoApoyoSimple, Mode=OneWay}"/>
                </TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource GrupoPillStyle}"
                         GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoUnBorde, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}"
                         CommandParameter="UnBordeContinuo">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
                    <Run Text="1 borde continuo · "/>
                    <Run Text="{Binding ConteoUnBorde, Mode=OneWay}"/>
                </TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource GrupoPillStyle}"
                         GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoDosBordes, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}"
                         CommandParameter="DosBordes">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
                    <Run Text="2 bordes · "/>
                    <Run Text="{Binding ConteoDosBordes, Mode=OneWay}"/>
                </TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource GrupoPillStyle}"
                         GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoTresBordes, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}"
                         CommandParameter="TresBordes">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
                    <Run Text="3 bordes · "/>
                    <Run Text="{Binding ConteoTresBordes, Mode=OneWay}"/>
                </TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource GrupoPillStyle}"
                         GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoCuatroBordes, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}"
                         CommandParameter="CuatroBordes">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
                    <Run Text="4 bordes · "/>
                    <Run Text="{Binding ConteoCuatroBordes, Mode=OneWay}"/>
                </TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource GrupoPillStyle}"
                         GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoVoladizos, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}"
                         CommandParameter="Voladizos">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11">
                    <Run Text="Voladizos · "/>
                    <Run Text="{Binding ConteoVoladizos, Mode=OneWay}"/>
                </TextBlock>
            </RadioButton>
        </WrapPanel>

        <!-- GRID DE CARDS -->
        <Border Grid.Row="2" BorderBrush="{StaticResource OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusDefault}"
                Padding="8">
            <ListBox ItemsSource="{Binding TiposFiltrados}"
                     SelectedItem="{Binding TipoSeleccionado}"
                     ItemContainerStyle="{StaticResource TipoCardContainerStyle}"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Margin="4,0,12,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource OnSurfaceBrush}"
                       FontFamily="{StaticResource FontFamilyMono}"
                       FontSize="12"
                       Text="{Binding EtiquetaTipoActivo}"/>
            <Button Grid.Column="1"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="Cancelar"
                    Padding="16,0" Margin="0,0,8,0"
                    Command="{Binding CancelarCommand}"
                    IsCancel="True"/>
            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Confirmar tipo"
                    Padding="16,0"
                    Command="{Binding ConfirmarCommand}"
                    IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
