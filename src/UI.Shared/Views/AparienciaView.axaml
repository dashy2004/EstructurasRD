<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Shared.UI.ViewModels"
             xmlns:cmn="clr-namespace:Shared.UI.Common"
             x:Class="Shared.UI.Views.AparienciaView"
             x:CompileBindings="False"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <!-- Card de selección de tema (RadioButton con icono + label). -->
        <ControlTheme x:Key="ThemeCardStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Name="bd" Padding="0,18"
                            Background="{StaticResource SurfaceContainerLowestBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusDefault}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ Border#bd">
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#bd">
                <Setter Property="Background" Value="{StaticResource SurfaceContainerLowBrush}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel>

            <TextBlock Theme="{StaticResource H1Style}" Text="Apariencia"/>
            <TextBlock Margin="0,4,0,24"
                       Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="13"
                       Text="Personaliza el aspecto de Memoria Plus."/>

            <!-- 3 cards horizontales -->
            <Grid ColumnDefinitions="*,12,*,12,*">
                <!-- CARD 1: TEMA -->
                <Border Grid.Column="0" Theme="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="🎨  TEMA"/>
                        <TextBlock Margin="0,4,0,16"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Text="Selecciona el modo de color de la interfaz."/>
                        <UniformGrid Rows="1" Columns="2">
                            <RadioButton GroupName="Tema" Theme="{StaticResource ThemeCardStyle}" Margin="0,0,4,0"
                                         IsChecked="{Binding Apariencia.Tema, ConverterParameter=Claro, Converter={x:Static cmn:EnumToBoolConverter.Instance}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☀" FontSize="28" HorizontalAlignment="Center"
                                               Foreground="{StaticResource OnSurfaceBrush}"/>
                                    <TextBlock Text="Claro" HorizontalAlignment="Center" Margin="0,6,0,0"
                                               FontFamily="{StaticResource FontFamilyUI}" FontSize="12"
                                               Foreground="{StaticResource OnSurfaceBrush}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Tema" Theme="{StaticResource ThemeCardStyle}" Margin="4,0,0,0"
                                         IsChecked="{Binding Apariencia.Tema, ConverterParameter=Oscuro, Converter={x:Static cmn:EnumToBoolConverter.Instance}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☾" FontSize="28" HorizontalAlignment="Center"
                                               Foreground="{StaticResource OnSurfaceBrush}"/>
                                    <TextBlock Text="Oscuro" HorizontalAlignment="Center" Margin="0,6,0,0"
                                               FontFamily="{StaticResource FontFamilyUI}" FontSize="12"
                                               Foreground="{StaticResource OnSurfaceBrush}"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: TIPOGRAFÍA -->
                <Border Grid.Column="2" Theme="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="🔤  TIPOGRAFÍA (DATOS)"/>
                        <TextBlock Margin="0,4,0,16"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Text="Fuente monoespaciada para tablas de cálculo."/>
                        <StackPanel>
                            <RadioButton GroupName="Tipografia" Margin="0,0,0,6"
                                         IsChecked="{Binding Apariencia.TipografiaDatos, ConverterParameter=JetBrains Mono, Converter={x:Static cmn:EnumToBoolConverter.Instance}}"
                                         Content="JetBrains Mono — 0123456789"
                                         FontFamily="JetBrains Mono, Consolas"/>
                            <RadioButton GroupName="Tipografia" Margin="0,0,0,6"
                                         IsChecked="{Binding Apariencia.TipografiaDatos, ConverterParameter=Iosevka, Converter={x:Static cmn:EnumToBoolConverter.Instance}}"
                                         Content="Iosevka — 0123456789"
                                         FontFamily="Iosevka, Consolas"/>
                            <RadioButton GroupName="Tipografia"
                                         IsChecked="{Binding Apariencia.TipografiaDatos, ConverterParameter=Consolas, Converter={x:Static cmn:EnumToBoolConverter.Instance}}"
                                         Content="Consolas — 0123456789"
                                         FontFamily="Consolas"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 3: DENSIDAD -->
                <Border Grid.Column="4" Theme="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="📏  DENSIDAD"/>
                        <TextBlock Margin="0,4,0,16"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Text="Ajuste de altura de filas en tablas de datos."/>
                        <StackPanel>
                            <RadioButton GroupName="Densidad" Margin="0,0,0,6"
                                         IsChecked="{Binding Apariencia.Densidad, ConverterParameter=Compacto, Converter={x:Static cmn:EnumToBoolConverter.Instance}}">
                                <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Compacto"/>
                                    <TextBlock Grid.Column="1" Text="24 px"
                                               FontFamily="{StaticResource FontFamilyMono}"
                                               Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                                </Grid>
                            </RadioButton>
                            <RadioButton GroupName="Densidad" Margin="0,0,0,6"
                                         IsChecked="{Binding Apariencia.Densidad, ConverterParameter=Medio, Converter={x:Static cmn:EnumToBoolConverter.Instance}}">
                                <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Medio"/>
                                    <TextBlock Grid.Column="1" Text="28 px"
                                               FontFamily="{StaticResource FontFamilyMono}"
                                               Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                </Grid>
                            </RadioButton>
                            <RadioButton GroupName="Densidad"
                                         IsChecked="{Binding Apariencia.Densidad, ConverterParameter=Cómodo, Converter={x:Static cmn:EnumToBoolConverter.Instance}}">
                                <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Cómodo"/>
                                    <TextBlock Grid.Column="1" Text="32 px"
                                               FontFamily="{StaticResource FontFamilyMono}"
                                               Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CARD 4: COLOR DE ACENTO -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="🎯  COLOR DE ACENTO"/>
                    <TextBlock Margin="0,4,0,12"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="11" TextWrapping="Wrap"
                               Text="Click en un color para usarlo como acento, o ingresa un hex personalizado."/>

                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Button Background="#0E639C" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip.Tip="Azul VS Code (#0E639C)"
                                Command="{Binding AplicarColorAcentoHexCommand}" CommandParameter="#0E639C"/>
                        <Button Background="#2E7D32" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip.Tip="Verde estructural (#2E7D32)"
                                Command="{Binding AplicarColorAcentoHexCommand}" CommandParameter="#2E7D32"/>
                        <Button Background="#C62828" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip.Tip="Rojo alerta (#C62828)"
                                Command="{Binding AplicarColorAcentoHexCommand}" CommandParameter="#C62828"/>
                        <Button Background="#EF6C00" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip.Tip="Naranja construcción (#EF6C00)"
                                Command="{Binding AplicarColorAcentoHexCommand}" CommandParameter="#EF6C00"/>
                        <Button Background="#6A1B9A" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip.Tip="Púrpura ingeniería (#6A1B9A)"
                                Command="{Binding AplicarColorAcentoHexCommand}" CommandParameter="#6A1B9A"/>
                        <Button Background="#AD1457" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip.Tip="Magenta diseño (#AD1457)"
                                Command="{Binding AplicarColorAcentoHexCommand}" CommandParameter="#AD1457"/>
                        <Button Background="#37474F" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip.Tip="Gris hormigón (#37474F)"
                                Command="{Binding AplicarColorAcentoHexCommand}" CommandParameter="#37474F"/>
                        <Button Background="#B8860B" Width="36" Height="36" Margin="0,0,8,8"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                ToolTip.Tip="Dorado clásico (#B8860B)"
                                Command="{Binding AplicarColorAcentoHexCommand}" CommandParameter="#B8860B"/>
                    </ItemsControl>

                    <Grid Margin="0,8,0,0" ColumnDefinitions="120,*,Auto,Auto">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Hex personalizado:"/>
                        <TextBox Grid.Column="1" Margin="0,0,8,0"
                                 Text="{Binding Apariencia.ColorAcentoHex, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip.Tip="Formato #RRGGBB (ej. #0E639C). Vacío = usar default del tema."
                                 FontFamily="{StaticResource FontFamilyMono}"/>
                        <Button Grid.Column="2" Content="Limpiar" Padding="10,4"
                                Command="{Binding AplicarColorAcentoHexCommand}" CommandParameter=""/>
                        <Border Grid.Column="3" Width="32" Height="32" Margin="8,0,0,0"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadiusDefault}"
                                Background="{Binding Apariencia.ColorAcentoHex, Converter={x:Static cmn:ColorConverters.HexToBrush}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CARD 5: PRESETS -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="💾  PRESETS"/>
                    <TextBlock Margin="0,4,0,12"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               FontSize="11" TextWrapping="Wrap"
                               Text="Guarda esta combinación (tema + tipografía + densidad + color) con un nombre y alternalo después con un click."/>

                    <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Margin="0,0,8,0"
                                 Text="{Binding NombrePresetNuevo, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip.Tip="Ej. 'Estructural oscuro', 'Daylight oficina'..."/>
                        <Button Grid.Column="1" Content="Guardar como preset"
                                Theme="{StaticResource SecondaryButtonStyle}" Padding="12,4"
                                Command="{Binding GuardarComoPresetCommand}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <ComboBox Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding PresetsDisponibles}"
                                  SelectedItem="{Binding PresetSeleccionado, Mode=TwoWay}"
                                  ToolTip.Tip="Presets guardados (se almacenan en %APPDATA%/LosasPlus/themes.json)"/>
                        <Button Grid.Column="1" Content="Cargar" Padding="12,4" Margin="0,0,4,0"
                                Command="{Binding CargarPresetCommand}"
                                CommandParameter="{Binding PresetSeleccionado}"/>
                        <Button Grid.Column="2" Content="Eliminar" Padding="12,4"
                                Command="{Binding EliminarPresetCommand}"
                                CommandParameter="{Binding PresetSeleccionado}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- FOOTER -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Right">
                <Button Theme="{StaticResource SecondaryButtonStyle}"
                        Content="↺ Restaurar defaults" Padding="14,0" Margin="0,0,8,0"
                        Command="{Binding RestaurarAparienciaCommand}"/>
                <Button Theme="{StaticResource PrimaryButtonStyle}"
                        Content="💾 Aplicar y guardar" Padding="16,0"
                        Command="{Binding GuardarAparienciaCommand}"/>
            </StackPanel>

            <TextBlock Margin="0,16,0,0"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="11" TextWrapping="Wrap"
                       Text="Algunos cambios (tema oscuro completo, fuentes) requieren reiniciar la app para aplicarse al ResourceDictionary global. La densidad y el color de acento aplican en vivo."/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
