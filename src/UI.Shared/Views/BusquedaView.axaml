<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
             xmlns:cmn="clr-namespace:MemoriaPlus.Common"
             x:Class="MemoriaPlus.Views.BusquedaView"
             x:CompileBindings="False"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <!-- Card de resultado (ListBoxItem) — usado por las 3 secciones. -->
        <ControlTheme x:Key="ResultadoCardStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Name="bd" Padding="12,8"
                            Background="{StaticResource SurfaceContainerLowestBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusDefault}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Margin="0,0,10,0"
                                    Background="{StaticResource SurfaceContainerBrush}"
                                    CornerRadius="{StaticResource CornerRadiusSm}"
                                    Padding="6,2" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource FontFamilyMono}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource OnSurfaceBrush}"
                                           Text="{Binding Tipo}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Titulo}"
                                           FontFamily="{StaticResource FontFamilyUI}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource OnSurfaceBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitulo}"
                                           FontFamily="{StaticResource FontFamilyMono}"
                                           FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="14"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}" Text="→"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#bd">
                <Setter Property="Background" Value="{StaticResource SurfaceContainerLowBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <Grid Margin="32,24" RowDefinitions="Auto,Auto,*">

        <!-- HEADER -->
        <StackPanel Grid.Row="0">
            <TextBlock Theme="{StaticResource H1Style}" Text="Búsqueda global"/>
            <TextBlock Margin="0,4,0,16"
                       Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="13"
                       Text="Busca simultáneamente en proyectos recientes, niveles y losas del proyecto activo."/>

            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="SearchBox" Grid.Column="0"
                         FontSize="14" Padding="12,8" VerticalContentAlignment="Center"
                         Text="{Binding Busqueda.TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip.Tip="Tipea para filtrar — Esc limpia">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding Busqueda.LimpiarCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Margin="8,0,0,0"
                        Theme="{StaticResource SecondaryButtonStyle}"
                        Padding="14,0" Content="✕ Limpiar"
                        Command="{Binding Busqueda.LimpiarCommand}"/>
            </Grid>
        </StackPanel>

        <!-- CONTEO TOTAL -->
        <TextBlock Grid.Row="1" Margin="0,12,0,12"
                   FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                   IsVisible="{Binding !Busqueda.BusquedaVacia}">
            <Run Text="Resultados: "/>
            <Run Text="{Binding Busqueda.ConteoTotal, Mode=OneWay}"
                 Foreground="{StaticResource OnSurfaceBrush}" FontWeight="SemiBold"/>
            <Run Text=" ("/>
            <Run Text="{Binding Busqueda.ConteoProyectos, Mode=OneWay}"/>
            <Run Text=" proyectos · "/>
            <Run Text="{Binding Busqueda.ConteoSistemas, Mode=OneWay}"/>
            <Run Text=" niveles · "/>
            <Run Text="{Binding Busqueda.ConteoLosas, Mode=OneWay}"/>
            <Run Text=" losas)"/>
        </TextBlock>

        <!-- RESULTADOS -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Empty state: texto vacío -->
                <Border Padding="32" CornerRadius="{StaticResource CornerRadiusDefault}"
                        Background="{StaticResource SurfaceContainerLowestBrush}"
                        BorderBrush="{StaticResource OutlineVariantBrush}"
                        BorderThickness="1" MaxWidth="480"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        IsVisible="{Binding Busqueda.BusquedaVacia}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource OutlineBrush}"/>
                        <TextBlock Text="Empieza a buscar"
                                   FontFamily="{StaticResource FontFamilyUI}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,12,0,4" HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Text="Tipea cualquier término para buscar en proyectos recientes (nombre / ingeniero / CODIA), niveles (nombre) y losas (id) del proyecto activo. Atajo Ctrl+F."/>
                    </StackPanel>
                </Border>

                <!-- Empty state: con texto pero 0 resultados -->
                <Border Padding="32" CornerRadius="{StaticResource CornerRadiusDefault}"
                        Background="{StaticResource SurfaceContainerLowestBrush}"
                        BorderBrush="{StaticResource OutlineVariantBrush}"
                        BorderThickness="1" MaxWidth="480"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static cmn:MultiBoolConverters.NingunoTrue}">
                            <Binding Path="Busqueda.BusquedaVacia"/>
                            <Binding Path="Busqueda.HayResultados"/>
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⊘" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource OutlineBrush}"/>
                        <TextBlock Text="Sin resultados"
                                   FontFamily="{StaticResource FontFamilyUI}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,12,0,4" HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Text="Ningún proyecto, nivel o losa coincide con el término actual."/>
                    </StackPanel>
                </Border>

                <!-- 3 secciones con resultados -->
                <StackPanel IsVisible="{Binding Busqueda.HayResultados}">
                    <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*">
                            <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="📂  PROYECTOS"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       Text="{Binding Busqueda.ConteoProyectos, StringFormat='{}{0} resultados', Mode=OneWay}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding Busqueda.ResultadosProyectos}"
                                 ItemContainerTheme="{StaticResource ResultadoCardStyle}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 DoubleTapped="Resultados_OnDoubleTapped"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*">
                            <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="🏗  NIVELES"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       Text="{Binding Busqueda.ConteoSistemas, StringFormat='{}{0} resultados', Mode=OneWay}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding Busqueda.ResultadosSistemas}"
                                 ItemContainerTheme="{StaticResource ResultadoCardStyle}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 DoubleTapped="Resultados_OnDoubleTapped"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*">
                            <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="📐  LOSAS"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       Text="{Binding Busqueda.ConteoLosas, StringFormat='{}{0} resultados', Mode=OneWay}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding Busqueda.ResultadosLosas}"
                                 ItemContainerTheme="{StaticResource ResultadoCardStyle}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 DoubleTapped="Resultados_OnDoubleTapped"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
