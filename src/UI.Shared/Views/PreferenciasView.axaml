<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cmn="clr-namespace:Shared.UI.Common"
             x:Class="Shared.UI.Views.PreferenciasView"
             x:CompileBindings="False"
             Background="{StaticResource SurfaceBrush}">

    <!-- H4 — Preferencias de cálculo/locale (convergencia v0.8.1). DataContext heredado:
         ConfiguracionViewModel. Persiste vía PreferenciasService al Guardar. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel>
            <TextBlock Theme="{StaticResource H1Style}" Text="Preferencias"/>
            <TextBlock Margin="0,4,0,24"
                       Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="13"
                       Text="Formato numérico, sistema de unidades y respaldo automático."/>

            <!-- Formato numérico -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="🔢  FORMATO NUMÉRICO"/>
                    <Grid ColumnDefinitions="*,16,*" Margin="0,12,0,0">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Decimales (1–4)" FontSize="12"
                                       Foreground="{StaticResource OnSurfaceBrush}" Margin="0,0,0,4"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OpcionesDecimales}"
                                      SelectedItem="{Binding Preferencias.Decimales, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cultura" FontSize="12"
                                       Foreground="{StaticResource OnSurfaceBrush}" Margin="0,0,0,4"/>
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding CulturasDisponibles}"
                                      SelectedItem="{Binding Preferencias.Cultura, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sistema de unidades -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="📏  SISTEMA DE UNIDADES"/>
                    <ComboBox Margin="0,12,0,0" HorizontalAlignment="Left" Width="220"
                              ItemsSource="{Binding SistemasUnidadesDisponibles}"
                              SelectedItem="{Binding Preferencias.SistemaUnidades, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Auto-backup -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="💾  AUTO-BACKUP"/>
                    <TextBlock Margin="0,4,0,8"
                               Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="11"
                               TextWrapping="Wrap"
                               Text="Intervalo en minutos para el respaldo automático del proyecto. 0 = desactivado."/>
                    <TextBox Width="120" HorizontalAlignment="Left"
                             Text="{Binding Preferencias.AutoBackupMinutos, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Theme="{StaticResource SecondaryButtonStyle}" Content="Restaurar defaults"
                        Command="{Binding RestaurarPreferenciasCommand}" Margin="0,0,8,0"/>
                <Button Theme="{StaticResource PrimaryButtonStyle}" Content="Guardar preferencias"
                        Command="{Binding GuardarPreferenciasCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
