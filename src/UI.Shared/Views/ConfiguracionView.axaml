<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
             xmlns:vw="clr-namespace:MemoriaPlus.Views"
             xmlns:cmn="clr-namespace:MemoriaPlus.Common"
             x:Class="MemoriaPlus.Views.ConfiguracionView"
             x:CompileBindings="False"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.DataContext>
        <vm:ConfiguracionViewModel/>
    </UserControl.DataContext>

    <Grid ColumnDefinitions="260,*">

        <!-- Sub-sidebar interno -->
        <Border Grid.Column="0" Padding="16,20"
                BorderBrush="{StaticResource OutlineVariantBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="CONFIGURACIÓN" Margin="0,0,0,12"/>

                <RadioButton Theme="{StaticResource SidebarNavItemStyle}" GroupName="ConfigSubTab"
                             IsChecked="{Binding SubTabActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=DatosIngeniero}"
                             IsVisible="{Binding MostrarDatosIngeniero}"
                             Content="👤  Datos del ingeniero"/>
                <RadioButton Theme="{StaticResource SidebarNavItemStyle}" GroupName="ConfigSubTab"
                             IsChecked="{Binding SubTabActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Apariencia}"
                             Content="🎨  Apariencia"/>
                <RadioButton Theme="{StaticResource SidebarNavItemStyle}" GroupName="ConfigSubTab"
                             IsChecked="{Binding SubTabActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Atajos}"
                             Content="⌨  Atajos de teclado"/>
                <RadioButton Theme="{StaticResource SidebarNavItemStyle}" GroupName="ConfigSubTab"
                             IsChecked="{Binding SubTabActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Preferencias}"
                             Content="⚙  Preferencias"/>

                <!-- Status del último guardado -->
                <Border Margin="0,24,0,0" Padding="10,8"
                        Background="{StaticResource SuccessBrush}" Opacity="0.12"
                        CornerRadius="{StaticResource CornerRadiusDefault}"
                        IsVisible="{Binding MostrarStatus}">
                    <TextBlock Text="{Binding StatusGuardado}"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                               Foreground="{StaticResource OnSurfaceBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Contenido del sub-tab activo (las 3 sub-vistas apiladas; toggle por IsVisible) -->
        <Panel Grid.Column="1">
            <vw:DatosIngenieroView
                IsVisible="{Binding SubTabActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=DatosIngeniero}"/>
            <vw:AparienciaView
                IsVisible="{Binding SubTabActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Apariencia}"/>
            <vw:AtajosView
                IsVisible="{Binding SubTabActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Atajos}"/>
            <vw:PreferenciasView
                IsVisible="{Binding SubTabActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Preferencias}"/>
        </Panel>
    </Grid>
</UserControl>
