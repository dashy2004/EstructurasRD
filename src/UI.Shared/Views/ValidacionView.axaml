<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Shared.UI.ViewModels"
             xmlns:cmn="clr-namespace:Shared.UI.Common"
             x:Class="Shared.UI.Views.ValidacionView"
             x:CompileBindings="False"
             Width="420"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <!-- Pill de filtro: Todas/Errores/Observaciones -->
        <ControlTheme x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Name="bd" Padding="10,4"
                            Background="{StaticResource SurfaceContainerLowBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusSm}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ Border#bd">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#bd">
                <Setter Property="Opacity" Value="0.85"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="IssueCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceContainerLowestBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusDefault}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </ControlTheme>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

            <!-- HEADER -->
            <Border Grid.Row="0" Padding="16,14"
                    BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock FontFamily="{StaticResource FontFamilyUI}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource OnSurfaceBrush}"
                                   Text="🛡  Validación normativa"/>
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="11"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Margin="0,2,0,0"
                                   Text="{Binding Reporte.ReglamentoAplicable}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Padding="8,2"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" FontSize="14"
                            Foreground="{StaticResource OnSurfaceVariantBrush}"
                            Command="{Binding CerrarPanelCommand}"
                            ToolTip.Tip="Cerrar panel"/>
                </Grid>
            </Border>

            <!-- 3 CARDS DE CONTEOS -->
            <Grid Grid.Row="1" Margin="16,16,16,8"
                  ColumnDefinitions="*,8,*,8,*"
                  IsVisible="{Binding !EnModoDetalle}">
                <Border Grid.Column="0" Padding="10"
                        Background="{StaticResource SurfaceContainerLowestBrush}"
                        BorderBrush="{StaticResource ErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusDefault}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⊘" FontSize="18" HorizontalAlignment="Center"
                                   Foreground="{StaticResource ErrorBrush}"/>
                        <TextBlock Text="{Binding TotalErrores}"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="ERRORES"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="10"
                        Background="{StaticResource SurfaceContainerLowestBrush}"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusDefault}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="18" HorizontalAlignment="Center"
                                   Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="{Binding TotalObservaciones}"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="OBS."
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Padding="10"
                        Background="{StaticResource SurfaceContainerLowestBrush}"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusDefault}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="18" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="{Binding TotalConformes}"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}"/>
                        <TextBlock Text="CONFORME"
                                   FontFamily="{StaticResource FontFamilyMono}"
                                   FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FILTROS (pills) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,4,16,8"
                        IsVisible="{Binding !EnModoDetalle}">
                <RadioButton Theme="{StaticResource FilterPillStyle}"
                             GroupName="ValidationFilter"
                             IsChecked="{Binding EsFiltroTodas, Mode=OneWay}"
                             Command="{Binding FiltrarCommand}"
                             CommandParameter="Todas">
                    <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                               Text="{Binding Issues.Count, Mode=OneWay, StringFormat='Todas · {0}'}"/>
                </RadioButton>
                <RadioButton Theme="{StaticResource FilterPillStyle}"
                             GroupName="ValidationFilter"
                             IsChecked="{Binding EsFiltroErrores, Mode=OneWay}"
                             Command="{Binding FiltrarCommand}"
                             CommandParameter="Errores">
                    <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                               Text="{Binding TotalErrores, Mode=OneWay, StringFormat='Errores · {0}'}"/>
                </RadioButton>
                <RadioButton Theme="{StaticResource FilterPillStyle}"
                             GroupName="ValidationFilter"
                             IsChecked="{Binding EsFiltroObservaciones, Mode=OneWay}"
                             Command="{Binding FiltrarCommand}"
                             CommandParameter="Observaciones">
                    <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                               Text="{Binding TotalObservaciones, Mode=OneWay, StringFormat='Observaciones · {0}'}"/>
                </RadioButton>
            </StackPanel>

            <!-- LISTA DE ISSUES -->
            <ScrollViewer Grid.Row="3" Padding="16,8,16,8"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding !EnModoDetalle}">
                <Grid>
                    <!-- Empty state -->
                    <Border Padding="16" CornerRadius="{StaticResource CornerRadiusDefault}"
                            Background="{StaticResource SurfaceContainerLowestBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding IssuesFiltrados.Count, Converter={x:Static cmn:ValidacionConverters.EsCero}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontSize="32" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Sin hallazgos"
                                       FontFamily="{StaticResource FontFamilyUI}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Foreground="{StaticResource OnSurfaceBrush}"/>
                            <TextBlock Text="El proyecto cumple con todas las reglas chequeadas en este filtro."
                                       FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Issue cards -->
                    <ItemsControl ItemsSource="{Binding IssuesFiltrados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Theme="{StaticResource IssueCardStyle}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Margin="0,0,10,0"
                                                   VerticalAlignment="Top" FontSize="18"
                                                   Text="{Binding Severidad, Converter={x:Static cmn:ValidacionConverters.Icono}}"
                                                   Foreground="{Binding Severidad, Converter={x:Static cmn:ValidacionConverters.Brush}}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Titulo}"
                                                       FontFamily="{StaticResource FontFamilyUI}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource OnSurfaceBrush}"/>
                                            <TextBlock Text="{Binding UbicacionFormateada}"
                                                       FontFamily="{StaticResource FontFamilyMono}"
                                                       FontSize="11" Margin="0,4,0,0"
                                                       Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                                            <Border Margin="0,8,0,0" Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource SurfaceContainerHighBrush}"
                                                    CornerRadius="{StaticResource CornerRadiusSm}">
                                                <TextBlock Text="{Binding ReferenciaNormativa}"
                                                           FontFamily="{StaticResource FontFamilyMono}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource OnSurfaceBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" VerticalAlignment="Center"
                                                Theme="{StaticResource SecondaryButtonStyle}"
                                                Content="→ Ir" Padding="10,4"
                                                Command="{Binding $parent[ItemsControl].DataContext.SeleccionarIssueCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Ver detalle de la violación normativa"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- DETALLE DEL ISSUE SELECCIONADO -->
            <ScrollViewer Grid.Row="3" Padding="16,8,16,8"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding EnModoDetalle}">
                <StackPanel>
                    <TextBlock FontFamily="{StaticResource FontFamilyUI}"
                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource OnSurfaceBrush}"
                               Text="{Binding IssueSeleccionado.Titulo}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,16">
                        <Border Padding="8,2"
                                Background="{StaticResource SurfaceContainerHighBrush}"
                                CornerRadius="{StaticResource CornerRadiusSm}"
                                Margin="0,0,6,0">
                            <TextBlock Text="{Binding IssueSeleccionado.ReferenciaNormativa}"
                                       FontFamily="{StaticResource FontFamilyMono}"
                                       FontSize="11"
                                       Foreground="{StaticResource OnSurfaceBrush}"/>
                        </Border>
                        <Border Padding="8,2" CornerRadius="{StaticResource CornerRadiusSm}"
                                Background="{Binding IssueSeleccionado.Severidad, Converter={x:Static cmn:ValidacionConverters.BadgeFondo}}">
                            <TextBlock FontFamily="{StaticResource FontFamilyMono}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnSurfaceBrush}"
                                       Text="{Binding IssueSeleccionado.Severidad, Converter={x:Static cmn:ValidacionConverters.Etiqueta}}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="UBICACIÓN"/>
                    <Border Margin="0,4,0,12" Padding="10"
                            Background="{StaticResource SurfaceContainerLowestBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusDefault}">
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="12"
                                   Foreground="{StaticResource OnSurfaceBrush}"
                                   Text="{Binding IssueSeleccionado.UbicacionFormateada}"/>
                    </Border>

                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="VALOR ACTUAL"/>
                    <Border Margin="0,4,0,12" Padding="10"
                            Background="{StaticResource SurfaceContainerLowestBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusDefault}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       Text="Configurado:"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnSurfaceBrush}"
                                       Text="{Binding IssueSeleccionado.ValorActual, Mode=OneWay, StringFormat=0.000, TargetNullValue=—}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       Text="Mínimo norma:"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnSurfaceBrush}"
                                       Text="{Binding IssueSeleccionado.ValorRequerido, Mode=OneWay, StringFormat=0.000, TargetNullValue=—}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       Text="Déficit:"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                       FontFamily="{StaticResource FontFamilyMono}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ErrorBrush}"
                                       Text="{Binding IssueSeleccionadoDeficit, Mode=OneWay, StringFormat='+0.000;-0.000;0.000', TargetNullValue=—}"/>
                        </Grid>
                    </Border>

                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="CLÁUSULA DEL REGLAMENTO"/>
                    <Border Margin="0,4,0,12" Padding="10"
                            Background="{StaticResource SurfaceContainerLowestBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusDefault}">
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                   TextWrapping="Wrap" FontStyle="Italic"
                                   Foreground="{StaticResource OnSurfaceBrush}"
                                   Text="{Binding IssueSeleccionado.ClausulaCita}"/>
                    </Border>

                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="DETALLE"/>
                    <Border Margin="0,4,0,16" Padding="10"
                            Background="{StaticResource SurfaceContainerLowestBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusDefault}">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource OnSurfaceBrush}"
                                   Text="{Binding IssueSeleccionado.Descripcion}"/>
                    </Border>

                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="OPCIONES PARA RESOLVER"/>
                    <Button Margin="0,8,0,6" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Padding="0,8"
                            Theme="{StaticResource PrimaryButtonStyle}"
                            IsVisible="{Binding IssueSeleccionadoTieneAutoFix}"
                            Command="{Binding AplicarMinimoCommand}"
                            ToolTip.Tip="Setea el espesor de la losa al mínimo requerido por la norma">
                        <TextBlock Text="{Binding IssueSeleccionado.ReferenciaNormativa, Mode=OneWay, StringFormat='✓ Aplicar mínimo {0}'}"/>
                    </Button>

                    <Button Margin="0,4,0,12" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Theme="{StaticResource SecondaryButtonStyle}"
                            Padding="0,8" Content="← Volver a la lista"
                            Command="{Binding VolverALaListaCommand}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="4" Padding="16,10"
                    Background="{StaticResource SurfaceContainerLowBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0"
                            Theme="{StaticResource SecondaryButtonStyle}"
                            Content="📋 Copiar reporte" Padding="10,0"
                            Command="{Binding CopiarReporteCommand}"
                            ToolTip.Tip="Copiar el reporte plano al portapapeles"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="10"
                               TextAlignment="Center"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Text="{Binding FechaGeneradoTexto, StringFormat='Generado · {0}'}"/>
                    <Button Grid.Column="2"
                            Theme="{StaticResource PrimaryButtonStyle}"
                            Content="↻ Re-validar" Padding="10,0"
                            Command="{Binding RevalidarCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
