<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MemoriaPlus.ViewModels"
             x:Class="MemoriaPlus.Views.AtajosView"
             x:CompileBindings="False"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <!-- Botón "tecla" editable: muestra el gesture y al click abre el captor. -->
        <ControlTheme x:Key="EditableKeyCapStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceContainerLowBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip.Tip" Value="Click para reasignar"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto">
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       Text="✎" FontSize="10"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#bd">
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Background" Value="{StaticResource SurfaceContainerHighBrush}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Theme="{StaticResource H1Style}" Text="Atajos de teclado"/>
            <TextBlock Margin="0,4,0,20"
                       Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="13"
                       Text="Click en cualquier tecla para reasignarla. Esc cancela la captura. No olvides Guardar."/>

            <!-- GESTIÓN DE PROYECTO -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="📂  GESTIÓN DE PROYECTO"/>
                    <StackPanel Margin="0,12,0,0">
                        <Grid Margin="0,4" ColumnDefinitions="*,200">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{StaticResource OnSurfaceBrush}" FontSize="13"
                                       Text="Nuevo proyecto"/>
                            <Button Grid.Column="1" Theme="{StaticResource EditableKeyCapStyle}"
                                    Content="{Binding Atajos.NuevoProyecto}" Tag="NuevoProyecto"
                                    Click="EditableKeyCap_Click"/>
                        </Grid>
                        <Grid Margin="0,4" ColumnDefinitions="*,200">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{StaticResource OnSurfaceBrush}" FontSize="13"
                                       Text="Abrir proyecto…"/>
                            <Button Grid.Column="1" Theme="{StaticResource EditableKeyCapStyle}"
                                    Content="{Binding Atajos.Abrir}" Tag="Abrir"
                                    Click="EditableKeyCap_Click"/>
                        </Grid>
                        <Grid Margin="0,4" ColumnDefinitions="*,200">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{StaticResource OnSurfaceBrush}" FontSize="13"
                                       Text="Guardar borrador (.lpx.json)"/>
                            <Button Grid.Column="1" Theme="{StaticResource EditableKeyCapStyle}"
                                    Content="{Binding Atajos.Guardar}" Tag="Guardar"
                                    Click="EditableKeyCap_Click"/>
                        </Grid>
                        <Grid Margin="0,4" ColumnDefinitions="*,200">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{StaticResource OnSurfaceBrush}" FontSize="13"
                                       Text="Guardar como…"/>
                            <Button Grid.Column="1" Theme="{StaticResource EditableKeyCapStyle}"
                                    Content="{Binding Atajos.GuardarComo}" Tag="GuardarComo"
                                    Click="EditableKeyCap_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- EDICIÓN -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="✏  EDICIÓN"/>
                    <Grid Margin="0,12,0,0" ColumnDefinitions="*,200">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}" FontSize="13"
                                   Text="Agregar losa al nivel activo"/>
                        <Button Grid.Column="1" Theme="{StaticResource EditableKeyCapStyle}"
                                Content="{Binding Atajos.AgregarLosa}" Tag="AgregarLosa"
                                Click="EditableKeyCap_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- BÚSQUEDA -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="🔍  BÚSQUEDA"/>
                    <Grid Margin="0,12,0,0" ColumnDefinitions="*,200">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}" FontSize="13"
                                   Text="Búsqueda global"/>
                        <Button Grid.Column="1" Theme="{StaticResource EditableKeyCapStyle}"
                                Content="{Binding Atajos.Busqueda}" Tag="Busqueda"
                                Click="EditableKeyCap_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GENERACIÓN DE MEMORIA -->
            <Border Theme="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="📄  GENERACIÓN DE MEMORIA"/>
                    <Grid Margin="0,12,0,0" ColumnDefinitions="*,200">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{StaticResource OnSurfaceBrush}" FontSize="13"
                                   Text="Generar memoria (.docx)"/>
                        <Button Grid.Column="1" Theme="{StaticResource EditableKeyCapStyle}"
                                Content="{Binding Atajos.Generar}" Tag="Generar"
                                Click="EditableKeyCap_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- FOOTER -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,8" HorizontalAlignment="Right">
                <Button Theme="{StaticResource SecondaryButtonStyle}"
                        Content="↺ Restaurar defaults" Padding="14,0" Margin="0,0,8,0"
                        Command="{Binding RestaurarAtajosCommand}"/>
                <Button Theme="{StaticResource PrimaryButtonStyle}"
                        Content="💾 Guardar atajos" Padding="16,0"
                        Command="{Binding GuardarAtajosCommand}"/>
            </StackPanel>

            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                       FontSize="11" TextWrapping="Wrap"
                       Text="Las combinaciones se aplican mientras la ventana principal tenga foco. Esc en el modal de captura cancela. Algunas combinaciones reservadas por el SO pueden no funcionar."/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
