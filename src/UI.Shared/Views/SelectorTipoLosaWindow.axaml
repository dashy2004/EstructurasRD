<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Shared.UI.ViewModels"
        xmlns:cmn="clr-namespace:Shared.UI.Common"
        x:Class="Shared.UI.Views.SelectorTipoLosaWindow"
        x:CompileBindings="False"
        Title="Seleccionar tipo de losa"
        Width="780" Height="620"
        MinWidth="640" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        CanResize="True">

    <Window.Resources>
        <!-- int Codigo → SvgImage del tipo_NN.svg embebido (avares://). -->
        <cmn:TipoCodigoToSvgUriConverter x:Key="TipoCodigoToSvgUriConverter"/>

        <!-- Pill de grupo -->
        <ControlTheme x:Key="GrupoPillStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Name="bd" Padding="10,4"
                            Background="{StaticResource SurfaceContainerLowBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusSm}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ Border#bd">
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#bd">
                <Setter Property="Opacity" Value="0.85"/>
            </Style>
        </ControlTheme>

        <!-- Card de tipo de losa (ListBoxItem): icono SVG centrado. -->
        <ControlTheme x:Key="TipoCardContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Name="bd" Width="110" Height="110"
                            Background="{StaticResource SurfaceContainerLowestBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusDefault}"
                            ToolTip.Tip="{Binding Descripcion}">
                        <Image Width="76" Height="76"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Stretch="Uniform"
                               Source="{Binding Codigo, Converter={StaticResource TipoCodigoToSvgUriConverter}}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:selected /template/ Border#bd">
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="{StaticResource SurfaceContainerHighBrush}"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#bd">
                <Setter Property="Background" Value="{StaticResource SurfaceContainerLowBrush}"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnDefinitions="Auto,Auto,*,220">
            <TextBlock Grid.Column="0" Theme="{StaticResource H2Style}"
                       Text="Seleccionar tipo de losa" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="8,2" VerticalAlignment="Center"
                    Background="#26FFA000" CornerRadius="{StaticResource CornerRadiusSm}">
                <TextBlock Text="Catálogo Pieper-Martens"
                           FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                           Foreground="{StaticResource OnSurfaceBrush}"/>
            </Border>
            <TextBox Grid.Column="3" VerticalContentAlignment="Center" Padding="8,4"
                     Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip.Tip="Buscar por código o descripción"/>
        </Grid>

        <!-- FILTROS (pills) -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <RadioButton Theme="{StaticResource GrupoPillStyle}" GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoTodos, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}" CommandParameter="Todos">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                           Text="{Binding ConteoTotal, Mode=OneWay, StringFormat='Todos · {0}'}"/>
            </RadioButton>
            <RadioButton Theme="{StaticResource GrupoPillStyle}" GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoApoyoSimple, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}" CommandParameter="ApoyoSimple">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                           Text="{Binding ConteoApoyoSimple, Mode=OneWay, StringFormat='Apoyo simple · {0}'}"/>
            </RadioButton>
            <RadioButton Theme="{StaticResource GrupoPillStyle}" GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoUnBorde, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}" CommandParameter="UnBordeContinuo">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                           Text="{Binding ConteoUnBorde, Mode=OneWay, StringFormat='1 borde continuo · {0}'}"/>
            </RadioButton>
            <RadioButton Theme="{StaticResource GrupoPillStyle}" GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoDosBordes, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}" CommandParameter="DosBordes">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                           Text="{Binding ConteoDosBordes, Mode=OneWay, StringFormat='2 bordes · {0}'}"/>
            </RadioButton>
            <RadioButton Theme="{StaticResource GrupoPillStyle}" GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoTresBordes, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}" CommandParameter="TresBordes">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                           Text="{Binding ConteoTresBordes, Mode=OneWay, StringFormat='3 bordes · {0}'}"/>
            </RadioButton>
            <RadioButton Theme="{StaticResource GrupoPillStyle}" GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoCuatroBordes, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}" CommandParameter="CuatroBordes">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                           Text="{Binding ConteoCuatroBordes, Mode=OneWay, StringFormat='4 bordes · {0}'}"/>
            </RadioButton>
            <RadioButton Theme="{StaticResource GrupoPillStyle}" GroupName="GrupoTipo"
                         IsChecked="{Binding EsGrupoVoladizos, Mode=OneWay}"
                         Command="{Binding FiltrarPorGrupoCommand}" CommandParameter="Voladizos">
                <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                           Text="{Binding ConteoVoladizos, Mode=OneWay, StringFormat='Voladizos · {0}'}"/>
            </RadioButton>
        </WrapPanel>

        <!-- GRID DE CARDS -->
        <Border Grid.Row="2" BorderBrush="{StaticResource OutlineVariantBrush}"
                BorderThickness="1" CornerRadius="{StaticResource CornerRadiusDefault}" Padding="8">
            <ListBox ItemsSource="{Binding TiposFiltrados}"
                     SelectedItem="{Binding TipoSeleccionado}"
                     ItemContainerTheme="{StaticResource TipoCardContainerStyle}"
                     BorderThickness="0" Background="Transparent"
                     HorizontalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="3" Margin="0,16,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="4,0,12,0"
                       TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceBrush}"
                       FontFamily="{StaticResource FontFamilyMono}" FontSize="12"
                       Text="{Binding EtiquetaTipoActivo}"/>
            <Button Grid.Column="1" Theme="{StaticResource SecondaryButtonStyle}"
                    Content="Cancelar" Padding="16,0" Margin="0,0,8,0"
                    Command="{Binding CancelarCommand}" IsCancel="True"/>
            <Button Grid.Column="2" Theme="{StaticResource PrimaryButtonStyle}"
                    Content="Confirmar tipo" Padding="16,0"
                    Command="{Binding ConfirmarCommand}" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
