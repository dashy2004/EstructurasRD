<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Shared.UI.ViewModels"
        xmlns:vws="clr-namespace:Shared.UI.Views;assembly=MemoriaPlus.UI.Shared"
        xmlns:cmn="clr-namespace:Shared.UI.Common;assembly=MemoriaPlus.UI.Shared"
        x:Class="MemoriaPlus.MainWindow"
        x:CompileBindings="False"
        Title="{Binding TituloVentana}"
        Height="900" Width="1440"
        MinHeight="640" MinWidth="1100"
        FontFamily="{StaticResource FontFamilyUI}"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource OnSurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="240,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceContainerLowBrush}"
                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

                <StackPanel Grid.Row="0" Margin="20,20,20,8">
                    <TextBlock Text="Memoria Plus"
                               FontFamily="{StaticResource FontFamilyUI}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding Version}"
                               FontFamily="{StaticResource FontFamilyMono}"
                               FontSize="11" Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="16,4,16,12">
                    <Button Theme="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"
                            Content="+ Nuevo proyecto" Command="{Binding NuevoProyectoCommand}"/>
                    <Button Margin="0,6,0,0" Theme="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                            Content="📂 Abrir proyecto…" Command="{Binding AbrirProyectoCommand}"/>
                </StackPanel>

                <!-- Navegación primaria -->
                <StackPanel Grid.Row="2" Margin="8,0,8,8">
                    <RadioButton Theme="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav"
                                 IsChecked="{Binding ModoActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Explorador}"
                                 Content="📂  Explorador"/>
                    <RadioButton Theme="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav"
                                 IsChecked="{Binding ModoActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Busqueda}"
                                 Content="🔍  Búsqueda"/>
                    <RadioButton Theme="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav"
                                 IsChecked="{Binding ModoActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Calculos}"
                                 Content="🧮  Cálculos"/>
                    <RadioButton Theme="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav"
                                 IsChecked="{Binding ModoActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Plantillas}"
                                 Content="📚  Plantillas"/>
                    <RadioButton Theme="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav"
                                 IsChecked="{Binding ModoActivo, Converter={x:Static cmn:EnumToBoolConverter.Instance}, ConverterParameter=Configuracion}"
                                 Content="⚙  Configuración"/>
                </StackPanel>

                <!-- Proyectos recientes -->
                <Border Grid.Row="3" Margin="16,8,16,8" Padding="0" Background="Transparent">
                    <StackPanel>
                        <TextBlock Theme="{StaticResource LabelCapsStyle}" Text="PROYECTOS RECIENTES" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ProyectosRecientes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,1" Padding="8,6" Cursor="Hand"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            BorderThickness="0" Background="Transparent"
                                            ToolTip.Tip="{Binding Path}"
                                            Command="{Binding $parent[Window].DataContext.AbrirProyectoRecienteCommand}"
                                            CommandParameter="{Binding Path}">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontFamily="{StaticResource FontFamilyUI}"
                                                       FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource OnSurfaceBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                                       Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,1,0,0">
                                                <Run Text="{Binding Ingeniero, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding UltimaEdicion, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="4" Padding="16,12"
                        BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="11"
                               Text="Soporte · Documentación"/>
                </Border>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

            <!-- Top bar (solo modo Cálculos) -->
            <Border Grid.Row="0" Padding="16,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding MostrarTopBarTabs}">
                <Grid ColumnDefinitions="*,Auto">
                    <TabControl x:Name="TopTabs" Grid.Column="0"
                                Background="Transparent" BorderThickness="0"
                                ItemContainerTheme="{StaticResource MemoriaTabItemStyle}"
                                ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding TabActivo}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Titulo}"/>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <Grid/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Chip de validación -->
                        <Button Margin="0,0,12,0" Padding="10,4" Cursor="Hand" BorderThickness="1"
                                Background="{Binding Validacion.ColorIndicador, Converter={x:Static cmn:ValidacionConverters.ChipFondo}}"
                                BorderBrush="{Binding Validacion.ColorIndicador, Converter={x:Static cmn:ValidacionConverters.ChipBorde}}"
                                Command="{Binding Validacion.AbrirPanelCommand}"
                                ToolTip.Tip="Abrir panel de validación normativa">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontFamilyMono}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnSurfaceBrush}"
                                       Text="{Binding Validacion.ResumenIndicador}"/>
                        </Button>

                        <Button Theme="{StaticResource SecondaryButtonStyle}"
                                Content="Guardar borrador" Margin="0,0,8,0"
                                Command="{Binding GuardarBorradorCommand}"/>
                        <Button Theme="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding TextoBotonContinuar}"
                                Command="{Binding ContinuarCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenido switch (router CurrentView) -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>

            <!-- Statusbar -->
            <Border Grid.Row="2" Padding="16,6"
                    Background="{StaticResource SurfaceContainerLowBrush}"
                    BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Text="{Binding CopyrightTexto}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}" Text="Sistema: Operativo"/>
                        <TextBlock FontFamily="{StaticResource FontFamilyMono}" FontSize="11"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="16,0,0,0"
                                   Text="{Binding Version}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay panel de Validación -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              IsVisible="{Binding Validacion.PanelAbierto}">
            <Button Background="#40000000" BorderThickness="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Command="{Binding Validacion.CerrarPanelCommand}">
                <Button.Template>
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <vws:ValidacionView HorizontalAlignment="Right" DataContext="{Binding Validacion}"/>
        </Grid>
    </Grid>
</Window>
