<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta oscura — alto contraste, texto siempre legible -->
    <SolidColorBrush x:Key="BgPrimary"   Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#252526"/>
    <SolidColorBrush x:Key="BgTertiary"  Color="#3A3A3D"/>
    <SolidColorBrush x:Key="BgInput"     Color="#2D2D30"/>
    <SolidColorBrush x:Key="FgPrimary"   Color="#F2F2F2"/>
    <SolidColorBrush x:Key="FgSecondary" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="FgMuted"     Color="#9C9C9C"/>
    <SolidColorBrush x:Key="FgOnAccent"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent"      Color="#0E7DB8"/>
    <SolidColorBrush x:Key="AccentHi"    Color="#3DB1F2"/>
    <SolidColorBrush x:Key="Border"      Color="#4A4A4F"/>
    <SolidColorBrush x:Key="Warn"        Color="#E2B93B"/>
    <SolidColorBrush x:Key="Err"         Color="#E54B4B"/>
    <SolidColorBrush x:Key="Ok"          Color="#4CAF50"/>
    <SolidColorBrush x:Key="RowAlt"      Color="#2D2D30"/>
    <SolidColorBrush x:Key="Selection"   Color="#0E7DB8"/>
</ResourceDictionary>
