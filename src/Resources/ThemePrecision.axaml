<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Precision Engineering System (Stitch) — paleta light. Port 1:1 a Avalonia. -->
    <SolidColorBrush x:Key="BgPrimary"   Color="#F8F9FF"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#EFF4FF"/>
    <SolidColorBrush x:Key="BgTertiary"  Color="#DCE9FF"/>
    <SolidColorBrush x:Key="BgInput"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FgPrimary"   Color="#0B1C30"/>
    <SolidColorBrush x:Key="FgSecondary" Color="#45464D"/>
    <SolidColorBrush x:Key="FgMuted"     Color="#76777D"/>
    <SolidColorBrush x:Key="FgOnAccent"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent"      Color="#006591"/>
    <SolidColorBrush x:Key="AccentHi"    Color="#39B8FD"/>
    <SolidColorBrush x:Key="Border"      Color="#C6C6CD"/>
    <SolidColorBrush x:Key="Warn"        Color="#D97706"/>
    <SolidColorBrush x:Key="Err"         Color="#BA1A1A"/>
    <SolidColorBrush x:Key="Ok"          Color="#06914A"/>
    <SolidColorBrush x:Key="RowAlt"      Color="#F8F9FF"/>
    <SolidColorBrush x:Key="Selection"   Color="#006591"/>
    <SolidColorBrush x:Key="ActiveBar"   Color="#006591"/>

    <FontFamily x:Key="UiFont">Inter, Segoe UI, Tahoma, Helvetica, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">JetBrains Mono, Consolas, Cascadia Mono, Courier New</FontFamily>
</ResourceDictionary>
