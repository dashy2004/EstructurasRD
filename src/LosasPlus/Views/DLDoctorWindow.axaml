<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LosasPlus.Views.DLDoctorWindow"
        x:CompileBindings="False"
        Title="🩺 Doctor de archivos .DL"
        Width="780" Height="520" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource FgPrimary}">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderTitle" FontSize="16" FontWeight="Bold" Text="Diagnóstico de archivo .DL"/>
            <TextBlock x:Name="PathLabel" Margin="0,4,0,0"
                       FontFamily="Consolas, JetBrains Mono" FontSize="11"
                       Foreground="{DynamicResource FgMuted}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ResumenLabel" Margin="0,8,0,0" FontSize="13"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" x:Name="AccionHint"
                           Foreground="{DynamicResource FgMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,16,0"/>
                <Button DockPanel.Dock="Right" Padding="14,6" Margin="6,0,0,0"
                        x:Name="CerrarBtn" Content="Cerrar" IsCancel="True" Click="OnCerrarClick"/>
                <Button DockPanel.Dock="Right" Padding="14,6" Margin="6,0,0,0"
                        x:Name="AccionPrincipalBtn" Content="Aplicar reparación y abrir"
                        Click="OnAccionPrincipalClick" IsVisible="False"/>
                <Button DockPanel.Dock="Right" Padding="14,6"
                        x:Name="CopiarReporteBtn" Content="Copiar reporte" Click="OnCopiarReporteClick"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="IssuesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" RowHeight="36"
                  Background="{DynamicResource BgSecondary}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sev" Width="70" Binding="{Binding Severity}"/>
                <DataGridTextColumn Header="Código" Width="160" Binding="{Binding Codigo}"
                                    FontFamily="Consolas, JetBrains Mono"/>
                <DataGridTemplateColumn Header="Descripción" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
