<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cmn="clr-namespace:Shared.UI.Common;assembly=MemoriaPlus.UI.Shared"
        x:Class="LosasPlus.Views.ImportarCombinacionesWindow"
        x:CompileBindings="False"
        Title="Importar combinaciones desde DISEST"
        Width="960" Height="640" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}">
    <Window.Resources>
        <cmn:EnumToBoolConverter x:Key="EnumToBool"/>
        <ControlTheme x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </ControlTheme>
        <ControlTheme x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </ControlTheme>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Importar combinaciones desde DISEST"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimary}"/>
            <TextBlock Text="{Binding NombreArchivo, StringFormat='Archivo: {0}'}"
                       FontSize="12" Foreground="{DynamicResource FgMuted}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="10,8"
                Background="{DynamicResource BgInput}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5">
            <TextBlock Text="{Binding ResumenDiff}" TextWrapping="Wrap"
                       FontSize="12" Foreground="{DynamicResource FgSecondary}"/>
        </Border>

        <Grid ColumnDefinitions="*,12,240,12,*">
            <!-- Proyecto actual -->
            <Border Grid.Column="0" Theme="{StaticResource Tarjeta}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="PROYECTO ACTUAL" Theme="{StaticResource Etiqueta}"/>
                    <DataGrid Grid.Row="1" MaxHeight="170" Margin="0,0,0,10"
                              ItemsSource="{Binding CasosActuales}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Width="80"  Binding="{Binding Codigo}"/>
                            <DataGridTextColumn Header="Nombre" Width="*"   Binding="{Binding Nombre}"/>
                            <DataGridTextColumn Header="Tipo"   Width="90"  Binding="{Binding Tipo}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding CombinacionesActuales}"
                             Background="{DynamicResource BgInput}"
                             BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Acciones -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="ACCIONES" Theme="{StaticResource Etiqueta}"/>
                <RadioButton GroupName="estrategia" Margin="0,4" Foreground="{DynamicResource FgPrimary}"
                             Content="Reemplazar TODO con el archivo"
                             IsChecked="{Binding Estrategia, Converter={StaticResource EnumToBool}, ConverterParameter=ReemplazarTodo}"
                             ToolTip.Tip="Descarta los casos y combinaciones actuales y deja exactamente lo del archivo."/>
                <RadioButton GroupName="estrategia" Margin="0,4" Foreground="{DynamicResource FgPrimary}"
                             Content="Merge inteligente"
                             IsChecked="{Binding Estrategia, Converter={StaticResource EnumToBool}, ConverterParameter=MergeInteligente}"
                             ToolTip.Tip="Actualiza los casos que coinciden por código, agrega los nuevos y agrega las combinaciones que falten."/>
                <RadioButton GroupName="estrategia" Margin="0,4" Foreground="{DynamicResource FgPrimary}"
                             Content="Solo agregar nuevas"
                             IsChecked="{Binding Estrategia, Converter={StaticResource EnumToBool}, ConverterParameter=SoloAgregarNuevas}"
                             ToolTip.Tip="Agrega únicamente los casos y combinaciones que aún no existen."/>
                <RadioButton GroupName="estrategia" Margin="0,4" Foreground="{DynamicResource FgPrimary}"
                             Content="Solo importar casos"
                             IsChecked="{Binding Estrategia, Converter={StaticResource EnumToBool}, ConverterParameter=SoloImportarCasos}"
                             ToolTip.Tip="Importa sólo los casos de carga; ignora las combinaciones del archivo."/>
                <Button Content="Aplicar acción  →" Margin="0,16,0,0" Padding="12,8" Cursor="Hand"
                        FontWeight="SemiBold" Foreground="White"
                        Background="{DynamicResource Accent}" BorderThickness="0"
                        Command="{Binding AplicarCommand}"/>
                <Button Content="Cancelar" Margin="0,8,0,0" Padding="12,6" Cursor="Hand"
                        Command="{Binding CancelarCommand}"/>
            </StackPanel>

            <!-- Archivo -->
            <Border Grid.Column="4" Theme="{StaticResource Tarjeta}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="ARCHIVO IMPORTADO" Theme="{StaticResource Etiqueta}"/>
                    <DataGrid Grid.Row="1" MaxHeight="170" Margin="0,0,0,10"
                              ItemsSource="{Binding CasosArchivo}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Width="80"  Binding="{Binding Codigo}"/>
                            <DataGridTextColumn Header="Nombre" Width="*"   Binding="{Binding Nombre}"/>
                            <DataGridTextColumn Header="Tipo"   Width="90"  Binding="{Binding Tipo}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding CombinacionesArchivo}"
                             Background="{DynamicResource BgInput}"
                             BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
