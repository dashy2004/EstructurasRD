<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LosasPlus.Views.PdfViewerControl"
             x:CompileBindings="False"
             Background="{DynamicResource BgPrimary}">

    <!-- H3 — Visor PDF multipágina. Toolbar: abrir · prev/next página · zoom 50–200%.
         Code-behind puro (sin VM): rasteriza la página actual vía PdfImportador
         (Docnet.Core/PDFium, BGRA → WriteableBitmap; respeta el pin SkiaSharp 2.88). -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10,6"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="📂  Abrir PDF…" Padding="12,5" Click="OnAbrir"
                        ToolTip.Tip="Abrir un documento PDF para visualizar."/>
                <Border Width="1" Margin="8,2" Background="{DynamicResource Border}"/>
                <Button x:Name="BtnPrev" Content="◀" Padding="10,5" Click="OnPrev"
                        ToolTip.Tip="Página anterior"/>
                <TextBlock x:Name="LblPagina" VerticalAlignment="Center" Margin="10,0"
                           Foreground="{DynamicResource FgSecondary}" Text="—"/>
                <Button x:Name="BtnNext" Content="▶" Padding="10,5" Click="OnNext"
                        ToolTip.Tip="Página siguiente"/>
                <Border Width="1" Margin="8,2" Background="{DynamicResource Border}"/>
                <Button Content="−" Padding="12,5" Click="OnZoomOut" ToolTip.Tip="Alejar"/>
                <TextBlock x:Name="LblZoom" VerticalAlignment="Center" Margin="8,0" Width="48"
                           TextAlignment="Center" Foreground="{DynamicResource FgSecondary}"
                           Text="100%"/>
                <Button Content="+" Padding="12,5" Click="OnZoomIn" ToolTip.Tip="Acercar"/>
                <TextBlock x:Name="LblEstado" VerticalAlignment="Center" Margin="14,0"
                           Foreground="{DynamicResource FgMuted}" FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Text="Abrí un PDF para empezar."/>
            </StackPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource BgInput}">
            <Image x:Name="PaginaImg" Stretch="None"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
