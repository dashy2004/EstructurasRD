<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LosasPlus.Views.TxtTablaView"
             Background="{DynamicResource BgInput}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,6"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatsTextBlock" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgMuted}" FontSize="12"
                           Text="Sin modificaciones — selecciona, Ctrl+C copia con tabs."/>
                <Button DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0"
                        x:Name="ExportarBtn" Click="OnExportarClick"
                        Content="Exportar .txt modificado"
                        ToolTip.Tip="Guarda los cambios en {stem}.modificado.txt (sin pisar el original)"/>
                <Button DockPanel.Dock="Right" Padding="10,4"
                        x:Name="ResetBtn" Click="OnResetClick"
                        Content="Revertir cambios"
                        ToolTip.Tip="Vuelve todas las celdas a su valor original parseado del .txt."/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  GridLinesVisibility="All"
                  FontFamily="Consolas, JetBrains Mono"
                  FontSize="12"
                  ClipboardCopyMode="ExcludeHeader"/>
    </DockPanel>
</UserControl>
