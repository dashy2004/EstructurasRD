<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta clara. Port 1:1 a Avalonia. -->
    <SolidColorBrush x:Key="BgPrimary"   Color="#F7F8FA"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgTertiary"  Color="#EDEDF0"/>
    <SolidColorBrush x:Key="BgInput"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FgPrimary"   Color="#1F2937"/>
    <SolidColorBrush x:Key="FgSecondary" Color="#374151"/>
    <SolidColorBrush x:Key="FgMuted"     Color="#6B7280"/>
    <SolidColorBrush x:Key="FgOnAccent"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent"      Color="#0E7DB8"/>
    <SolidColorBrush x:Key="AccentHi"    Color="#0B6298"/>
    <SolidColorBrush x:Key="Border"      Color="#D1D5DB"/>
    <SolidColorBrush x:Key="Warn"        Color="#D97706"/>
    <SolidColorBrush x:Key="Err"         Color="#DC2626"/>
    <SolidColorBrush x:Key="Ok"          Color="#059669"/>
    <SolidColorBrush x:Key="RowAlt"      Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Selection"   Color="#3DB1F2"/>
    <SolidColorBrush x:Key="ActiveBar"   Color="#0E7DB8"/>

    <FontFamily x:Key="UiFont">Inter, Segoe UI, Tahoma, Helvetica, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">JetBrains Mono, Consolas, Cascadia Mono, Courier New</FontFamily>
</ResourceDictionary>
