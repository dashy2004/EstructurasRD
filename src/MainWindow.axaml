<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LosasPlus.ViewModels"
        xmlns:v="clr-namespace:LosasPlus.Views"
        xmlns:cad="clr-namespace:LosasPlus.Views.Cad"
        xmlns:vigas="clr-namespace:LosasPlus.Views.Vigas"
        xmlns:vws="clr-namespace:MemoriaPlus.Views;assembly=MemoriaPlus.UI.Shared"
        xmlns:cmn="clr-namespace:MemoriaPlus.Common;assembly=MemoriaPlus.UI.Shared"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        x:Class="LosasPlus.MainWindow"
        x:CompileBindings="False"
        Title="{Binding TituloVentana}"
        Icon="/Resources/branding/EstructurasRD.png"
        Height="900" Width="1440" MinHeight="640" MinWidth="1100"
        Background="{DynamicResource BgPrimary}"
        WindowStartupLocation="CenterScreen">

    <!-- ============================================================
         Port WPF→Avalonia del MainWindow real (shell de 14 modos).
         Cambios clave vs. WPF:
           · Visibility+DataTrigger por modo  → IsVisible + EnumToBoolConverter.
           · Style/ControlTemplate+Triggers    → Styles con selectores pseudo-clase.
           · ToolTip="..."                     → ToolTip.Tip="...".
           · Style="{StaticResource X}"        → Theme="{StaticResource X}".
           · Hyperlink+RequestNavigate         → HyperlinkButton NavigateUri.
           · MouseDoubleClick                  → DoubleTapped.
           · Window.InputBindings/KeyBinding   → Window.KeyBindings + KeyGesture
             (los 4 fijos acá; los 6 personalizables los aplica el code-behind).
           · Lienzo CAD = CadView completo (canvas + calibrar PDF + muros + DXF).
         ============================================================ -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding IrAExploradorCommand}"/>
        <KeyBinding Gesture="Ctrl+L" Command="{Binding AgregarLosaCommand}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+OemQuestion" Command="{Binding AbrirShortcutsCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Nav tabs (RadioButton reestilizado con indicador inferior). -->
        <Style Selector="RadioButton.navtab">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="bd" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.navtab:checked /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ActiveBar}"/>
        </Style>
        <Style Selector="RadioButton.navtab:checked">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="RadioButton.navtab:pointerover:unchecked /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
        </Style>
        <Style Selector="RadioButton.navtab:pointerover:unchecked">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
        </Style>

        <!-- Sidebar vertical (Fase D): RadioButton de navegación de modo con
             indicador izquierdo, agrupado por categoría. Reemplaza la banda de
             menús horizontal de modos. -->
        <Style Selector="RadioButton.navside">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="bd" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="3,0,0,0" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.navside:checked /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ActiveBar}"/>
        </Style>
        <Style Selector="RadioButton.navside:checked">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="RadioButton.navside:pointerover:unchecked /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
        </Style>
        <Style Selector="RadioButton.navside:pointerover:unchecked">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
        </Style>

        <!-- Caption de grupo de la sidebar. -->
        <Style Selector="TextBlock.sidecat">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="Margin" Value="14,12,0,4"/>
        </Style>

        <!-- H1 — Caption de categoría del nav (7 bloques) y separador vertical. -->
        <Style Selector="TextBlock.navcat">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="10,0,4,9"/>
        </Style>
        <Style Selector="Border.navsep">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="4,6"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource Border}"/>
        </Style>

        <!-- Botón ID del grid de losas resaltado cuando ModoConectarBordes activo. -->
        <Style Selector="Button.connectmode">
            <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgOnAccent}"/>
            <Setter Property="ToolTip.Tip" Value="Click para conectar bordes adicionales"/>
        </Style>

        <!-- Celda Ly/Lx resaltada cuando el aspecto está fuera de rango. -->
        <Style Selector="Border.aspectwarn">
            <Setter Property="Background" Value="{DynamicResource Warn}"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*">

        <!-- =============================================================
             ÁREA PRINCIPAL (rediseño 2026-06): el SIDEBAR de navegación se
             ELIMINÓ — la navegación por categorías (Proyecto / Geometría /
             Análisis / Salida / Sistema, con sus Vistas) vive ahora dentro del
             ribbon, junto a las acciones de cada categoría. Una sola columna →
             máxima pantalla de trabajo. El branding se reubicó (compacto) en la
             franja de contexto NIVEL/SISTEMA.
             ============================================================= -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto">

            <!-- ============================================================
                 TOP CHROME (rediseño 2026-06): RIBBON de pestañas + franja de
                 contexto NIVEL/SISTEMA full-width. Reemplaza el Menu horizontal.
                 Todos los Click/Command handlers se preservan 1:1 — sólo cambia
                 la presentación. Tema/Apariencia migran a la pestaña «Ver».
                 ============================================================ -->
            <StackPanel Grid.Row="0">

                <!-- RIBBON: Inicio · Insertar · Calcular · Exportar · Ver -->
                <Border Background="{DynamicResource BgInput}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                    <Border.Styles>
                        <!-- Botón grande de ribbon: icono arriba, etiqueta abajo.
                             Template propio (Border#bd) para hover fiable, igual
                             que el patrón .tool del CadView. -->
                        <Style Selector="Button.rb">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="1,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Name="bd" Background="Transparent" CornerRadius="5" Padding="9,5">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="Button.rb:pointerover /template/ Border#bd">
                            <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
                        </Style>
                        <!-- icono / etiqueta: comunes a botones de acción (.rb) y de
                             navegación (.rbnav) — selector sin prefijo de padre. -->
                        <Style Selector="TextBlock.ic">
                            <Setter Property="FontSize" Value="19"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                        <Style Selector="TextBlock.lb">
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,2,0,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
                        </Style>

                        <!-- Botón de NAVEGACIÓN de modo (RadioButton): mismo look que
                             .rb pero con estado :checked resaltado en Accent. -->
                        <Style Selector="RadioButton.rbnav">
                            <Setter Property="Margin" Value="1,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <Border Name="bd" Background="Transparent" CornerRadius="5" Padding="9,5">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="RadioButton.rbnav:pointerover /template/ Border#bd">
                            <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
                        </Style>
                        <Style Selector="RadioButton.rbnav:checked /template/ Border#bd">
                            <Setter Property="Background" Value="{DynamicResource Accent}"/>
                        </Style>
                        <Style Selector="RadioButton.rbnav:checked TextBlock.ic">
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                        <Style Selector="RadioButton.rbnav:checked TextBlock.lb">
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                        <Style Selector="TextBlock.rbcap">
                            <Setter Property="FontSize" Value="9"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
                            <Setter Property="Margin" Value="0,3,0,0"/>
                        </Style>
                        <Style Selector="Border.rbsep">
                            <Setter Property="Width" Value="1"/>
                            <Setter Property="Margin" Value="7,8"/>
                            <Setter Property="Background" Value="{DynamicResource Border}"/>
                        </Style>
                        <Style Selector="TabControl.ribbon > TabItem">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="16,7"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </Border.Styles>

                    <TabControl Classes="ribbon" Padding="0" Margin="0">
                        <!-- ===== PROYECTO (Vistas de proyecto + acciones de archivo) ===== -->
                        <TabItem Header="Proyecto">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Margin="10,6,10,5">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Explorador de proyectos"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Explorador}">
                                                <StackPanel><TextBlock Classes="ic" Text="📂"/><TextBlock Classes="lb" Text="Explorador"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Búsqueda"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Busqueda}">
                                                <StackPanel><TextBlock Classes="ic" Text="🔍"/><TextBlock Classes="lb" Text="Búsqueda"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Editor de Losas"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Editor}">
                                                <StackPanel><TextBlock Classes="ic" Text="✎"/><TextBlock Classes="lb" Text="Editor"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Validación normativa"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Validacion}">
                                                <StackPanel><TextBlock Classes="ic" Text="🛡"/><TextBlock Classes="lb" Text="Validación"/></StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Vistas"/>
                                    </StackPanel>
                                    <Border Classes="rbsep"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="rb" Click="OnNewProjectClick" ToolTip.Tip="Nuevo proyecto">
                                                <StackPanel><TextBlock Classes="ic" Text="📄"/><TextBlock Classes="lb" Text="Nuevo"/></StackPanel>
                                            </Button>
                                            <Button Classes="rb" Click="OnOpenProjectClick" ToolTip.Tip="Abrir proyecto">
                                                <StackPanel><TextBlock Classes="ic" Text="📂"/><TextBlock Classes="lb" Text="Abrir"/></StackPanel>
                                            </Button>
                                            <Button Classes="rb" Click="OnSaveProjectClick" ToolTip.Tip="Guardar proyecto">
                                                <StackPanel><TextBlock Classes="ic" Text="💾"/><TextBlock Classes="lb" Text="Guardar"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Proyecto"/>
                                    </StackPanel>
                                    <Border Classes="rbsep"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="rb" Click="OnOpenClick" ToolTip.Tip="Abrir .DL legacy">
                                                <StackPanel><TextBlock Classes="ic" Text="📑"/><TextBlock Classes="lb" Text="Abrir .DL"/></StackPanel>
                                            </Button>
                                            <Button Classes="rb" Click="OnDiagnosticarDLClick" ToolTip.Tip="Diagnosticar .DL">
                                                <StackPanel><TextBlock Classes="ic" Text="🩺"/><TextBlock Classes="lb" Text="Diagnosticar"/></StackPanel>
                                            </Button>
                                            <Button Classes="rb" Click="OnSaveClick" ToolTip.Tip="Guardar .DL agregado">
                                                <StackPanel><TextBlock Classes="ic" Text="🗎"/><TextBlock Classes="lb" Text="Guardar .DL"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Legacy .DL"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===== GEOMETRÍA (Vistas de geometría + inserción de modelo) ===== -->
                        <TabItem Header="Geometría">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Margin="10,6,10,5">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Planta 2D"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Planta2D}">
                                                <StackPanel><TextBlock Classes="ic" Text="📐"/><TextBlock Classes="lb" Text="Planta 2D"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Plano CAD"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PlanoCad}">
                                                <StackPanel><TextBlock Classes="ic" Text="🗺"/><TextBlock Classes="lb" Text="Plano CAD"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Vista 3D"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Vista3D}">
                                                <StackPanel><TextBlock Classes="ic" Text="🧊"/><TextBlock Classes="lb" Text="Vista 3D"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Visor PDF"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=VisorPdf}">
                                                <StackPanel><TextBlock Classes="ic" Text="📄"/><TextBlock Classes="lb" Text="Visor PDF"/></StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Vistas"/>
                                    </StackPanel>
                                    <Border Classes="rbsep"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="rb" Click="OnGenerarEjesClick" ToolTip.Tip="Generar ejes del nivel (desde columnas)">
                                                <StackPanel><TextBlock Classes="ic" Text="📐"/><TextBlock Classes="lb" Text="Ejes"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Geometría"/>
                                    </StackPanel>
                                    <Border Classes="rbsep"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="rb" Click="OnGenerarDesdeFotoClick" ToolTip.Tip="Generar sistema desde foto (IA local Qwen)">
                                                <StackPanel><TextBlock Classes="ic" Text="🖼"/><TextBlock Classes="lb" Text="Desde foto"/></StackPanel>
                                            </Button>
                                            <Button Classes="rb" Click="OnGenerarDesdeDxfClick" ToolTip.Tip="Generar sistema desde DXF estructural">
                                                <StackPanel><TextBlock Classes="ic" Text="📥"/><TextBlock Classes="lb" Text="Desde DXF"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Importar modelo"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===== ANÁLISIS (Vistas de análisis + calculadoras) ===== -->
                        <TabItem Header="Análisis">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Margin="10,6,10,5">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Cargas y Combinaciones"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CargasCombinaciones}">
                                                <StackPanel><TextBlock Classes="ic" Text="📊"/><TextBlock Classes="lb" Text="Cargas"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Bajada de Cargas"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=BajadaCargas}">
                                                <StackPanel><TextBlock Classes="ic" Text="⬇"/><TextBlock Classes="lb" Text="Bajada"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Vigas Continuas"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Vigas}">
                                                <StackPanel><TextBlock Classes="ic" Text="📐"/><TextBlock Classes="lb" Text="Vigas"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Columnas"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Columnas}">
                                                <StackPanel><TextBlock Classes="ic" Text="🏛"/><TextBlock Classes="lb" Text="Columnas"/></StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Vistas"/>
                                    </StackPanel>
                                    <Border Classes="rbsep"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="rb" Click="OnCalcularCargaUltimaClick" ToolTip.Tip="Calcular carga última (Wu) desde geometría — LRFD 1.2D+1.6L">
                                                <StackPanel><TextBlock Classes="ic" Text="∑"/><TextBlock Classes="lb" Text="Carga Wu"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Cargas"/>
                                    </StackPanel>
                                    <Border Classes="rbsep"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="rb" Command="{Binding CalcularConMotorCommand}" ToolTip.Tip="Calcular losas con el motor FEA nativo (FEM, sin Losas.exe)">
                                                <StackPanel><TextBlock Classes="ic" Text="▶"/><TextBlock Classes="lb" Text="Motor FEM"/></StackPanel>
                                            </Button>
                                            <Button Classes="rb" Click="OnCalcularNativoClick" ToolTip.Tip="Calcular losas (Pieper-Martens nativo, sin Losas.exe)">
                                                <StackPanel><TextBlock Classes="ic" Text="🧮"/><TextBlock Classes="lb" Text="Pieper-M."/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Losas"/>
                                    </StackPanel>
                                    <Border Classes="rbsep"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="rb" Click="OnImportTxtClick" ToolTip.Tip="Importar la salida .TXT de Losas.exe">
                                                <StackPanel><TextBlock Classes="ic" Text="📥"/><TextBlock Classes="lb" Text="Importar .TXT"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Importar"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===== SALIDA (Vistas de salida + exportación) ===== -->
                        <TabItem Header="Salida">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Margin="10,6,10,5">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="DL Editor"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DLEditor}">
                                                <StackPanel><TextBlock Classes="ic" Text="▤"/><TextBlock Classes="lb" Text="DL Editor"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Salida .TXT"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Salida}">
                                                <StackPanel><TextBlock Classes="ic" Text="⇲"/><TextBlock Classes="lb" Text="Salida .TXT"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Aceros"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Aceros}">
                                                <StackPanel><TextBlock Classes="ic" Text="🔩"/><TextBlock Classes="lb" Text="Aceros"/></StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Vistas"/>
                                    </StackPanel>
                                    <Border Classes="rbsep"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="rb" Command="{Binding GenerarMemoriaCommand}" ToolTip.Tip="Generar memoria → abrir MemoriaPlus (Ctrl+G)">
                                                <StackPanel><TextBlock Classes="ic" Text="📝"/><TextBlock Classes="lb" Text="Memoria"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Memoria"/>
                                    </StackPanel>
                                    <Border Classes="rbsep"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="rb" Click="OnExportCsvClick" ToolTip.Tip="Exportar CSV">
                                                <StackPanel><TextBlock Classes="ic" Text="📄"/><TextBlock Classes="lb" Text="CSV"/></StackPanel>
                                            </Button>
                                            <Button Classes="rb" Click="OnExportXlsxClick" ToolTip.Tip="Exportar XLSX">
                                                <StackPanel><TextBlock Classes="ic" Text="📊"/><TextBlock Classes="lb" Text="XLSX"/></StackPanel>
                                            </Button>
                                            <Button Classes="rb" Click="OnExportSafClick" ToolTip.Tip="Exportar SAF (vigas)">
                                                <StackPanel><TextBlock Classes="ic" Text="🏗"/><TextBlock Classes="lb" Text="SAF vigas"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Datos"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ===== SISTEMA (Vistas de sistema + apariencia) ===== -->
                        <TabItem Header="Sistema">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Margin="10,6,10,5">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Reglamento"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Reglamento}">
                                                <StackPanel><TextBlock Classes="ic" Text="⚖"/><TextBlock Classes="lb" Text="Reglamento"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Configuración"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Configuracion}">
                                                <StackPanel><TextBlock Classes="ic" Text="⚙"/><TextBlock Classes="lb" Text="Configuración"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Plugins"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Plugins}">
                                                <StackPanel><TextBlock Classes="ic" Text="◆"/><TextBlock Classes="lb" Text="Plugins"/></StackPanel>
                                            </RadioButton>
                                            <RadioButton Classes="rbnav" GroupName="ModoNav" ToolTip.Tip="Acerca de"
                                                         IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Acerca}">
                                                <StackPanel><TextBlock Classes="ic" Text="ℹ"/><TextBlock Classes="lb" Text="Acerca"/></StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Vistas"/>
                                    </StackPanel>
                                    <Border Classes="rbsep"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Classes="rb" Click="OnToggleTheme" ToolTip.Tip="Ciclar tema Precision/Light/Dark">
                                                <StackPanel><TextBlock Classes="ic" Text="🌓"/><TextBlock Classes="lb" Text="Tema"/></StackPanel>
                                            </Button>
                                            <Button Classes="rb" Click="OnAppearanceClick" ToolTip.Tip="Personalizar colores">
                                                <StackPanel><TextBlock Classes="ic" Text="🎨"/><TextBlock Classes="lb" Text="Apariencia"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Classes="rbcap" Text="Apariencia"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- FRANJA DE CONTEXTO: NIVEL / SISTEMA full-width + chip validación. -->
                <Border Background="{DynamicResource BgSecondary}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                        Padding="16,5">
                    <DockPanel LastChildFill="False">
                        <!-- Chip de validación normativa: click → modo Validación. -->
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4"
                                Cursor="Hand" BorderThickness="1" VerticalAlignment="Center"
                                Background="{DynamicResource BgInput}"
                                BorderBrush="{DynamicResource Border}"
                                Click="OnChipValidacionClick"
                                ToolTip.Tip="Abrir panel de validación normativa">
                            <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgPrimary}"
                                       Text="{Binding Validacion.ResumenIndicador}"/>
                        </Button>

                        <!-- Branding compacto (reubicado del antiguo sidebar eliminado). -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,18,0">
                            <Image Source="avares://LosasPlus/Resources/branding/EstructurasRD.png"
                                   Width="22" Height="22" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock Text="{x:Static cmn:Branding.Producto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Version}" FontSize="9"
                                       Foreground="{DynamicResource FgMuted}"
                                       VerticalAlignment="Bottom" Margin="5,0,0,2"/>
                        </StackPanel>

                        <!-- NIVEL -->
                        <TextBlock DockPanel.Dock="Left" Text="NIVEL" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="10" Margin="0,0,8,0"
                                   Foreground="{DynamicResource FgMuted}"/>
                        <ComboBox DockPanel.Dock="Left" x:Name="NivelesList" VerticalAlignment="Center" MinWidth="120"
                                  ItemsSource="{Binding NivelesDelEdificio}"
                                  SelectedIndex="{Binding IndiceNivelActivo, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button DockPanel.Dock="Left" Content="+" Width="24" Height="24" Padding="0" Margin="4,0,0,0"
                                Click="OnAddNivel" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource FgPrimary}"
                                ToolTip.Tip="Agregar nuevo nivel"/>
                        <Button DockPanel.Dock="Left" Content="−" Width="24" Height="24" Padding="0" Margin="0,0,12,0"
                                Click="OnDeleteNivel" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource FgMuted}"
                                ToolTip.Tip="Eliminar nivel activo"/>

                        <Border DockPanel.Dock="Left" Width="1" Background="{DynamicResource Border}" Margin="0,4"/>

                        <!-- SISTEMA -->
                        <TextBlock DockPanel.Dock="Left" Text="SISTEMA" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="10" Margin="12,0,8,0"
                                   Foreground="{DynamicResource FgMuted}"/>
                        <ComboBox DockPanel.Dock="Left" x:Name="SistemasList" VerticalAlignment="Center" MinWidth="150"
                                  ItemsSource="{Binding NivelActivo.Sistemas}"
                                  SelectedItem="{Binding SistemaActivo, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox DockPanel.Dock="Left" x:Name="SistemaNombreInline" VerticalAlignment="Center"
                                 Width="120" Margin="6,0,0,0"
                                 Text="{Binding SistemaActivo.Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip.Tip="Renombrar el sistema activo. El selector se actualiza en caliente."/>
                        <TextBlock DockPanel.Dock="Left" Text="Elev. Z:" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="11" Foreground="{DynamicResource FgMuted}" ToolTip.Tip="Elevación del sistema (m)"/>
                        <TextBox DockPanel.Dock="Left" Text="{Binding SistemaActivo.Elevacion}" VerticalAlignment="Center" Width="50" FontSize="11" Padding="4,2"/>
                        <Button DockPanel.Dock="Left" Content="+" Width="24" Height="24" Padding="0" Margin="12,0,0,0"
                                Click="OnAddSistema" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource FgPrimary}"
                                ToolTip.Tip="Agregar nuevo sistema"/>
                        <Button DockPanel.Dock="Left" Content="−" Width="24" Height="24" Padding="0"
                                Click="OnDeleteSistema" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource FgMuted}"
                                ToolTip.Tip="Eliminar sistema seleccionado"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- =========================================================
                 CONTENT SWITCH por ModoActivo.
                 · Router (Fase D): los 12 modos respaldados por un UserControl
                   autónomo se hostean en este único ContentControl vía
                   CurrentView. Para los modos inline CurrentView devuelve null
                   y este control queda vacío.
                 · Inline (IsVisible + EnumToBool): Explorador, Editor, PlanoCad,
                   DLEditor, Salida, Plugins, Acerca — conservan su XAML inline
                   y sus controles x:Name usados por el code-behind.
                 ========================================================= -->
            <Grid Grid.Row="1">

                <!-- Router: sub-vista del modo activo (o vacío si es inline). -->
                <ContentControl Content="{Binding CurrentView}"/>

                <!-- MODO Explorador: hub de proyectos recientes (.lpx.json). -->
                <Grid Margin="32,24"
                      IsVisible="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Explorador}"
                      RowDefinitions="Auto,Auto,Auto,*,Auto">

                    <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Proyectos recientes" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource FgPrimary}"/>
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource FgMuted}" FontSize="13"
                                       Text="Archivos .lpx.json compartidos con MemoriaPlus.App. Doble-click para abrir en Editor."/>
                        </StackPanel>
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,6"
                                Content="+ Nuevo proyecto"
                                Command="{Binding NuevoProyectoLpxCommand}"
                                Theme="{StaticResource PrimaryButton}"/>
                        <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,6"
                                Content="📂 Abrir .lpx.json…"
                                Command="{Binding AbrirProyectoLpxCommand}"/>
                    </Grid>

                    <!-- PROYECTO ACTIVO: renombrar + guardar + lista sistemas. -->
                    <Border Grid.Row="1" Margin="0,0,0,16" Padding="16"
                            Background="{DynamicResource BgSecondary}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Text="Proyecto activo"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Padding="12,4" Margin="6,0,0,0"
                                        Content="Guardar como…"
                                        Command="{Binding GuardarComoLpxCommand}"
                                        ToolTip.Tip="Pide path. Ctrl+Shift+S"/>
                                <Button DockPanel.Dock="Right" Padding="12,4"
                                        Content="💾 Guardar"
                                        Theme="{StaticResource PrimaryButton}"
                                        Command="{Binding GuardarProyectoLpxCommand}"
                                        ToolTip.Tip="Guarda al path actual. Ctrl+S"/>
                            </DockPanel>

                            <Grid ColumnDefinitions="*,12,*,12,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nombre del proyecto" FontSize="11"
                                               Foreground="{DynamicResource FgMuted}"/>
                                    <TextBox Margin="0,4,0,0"
                                             Text="{Binding Proyecto.Nombre, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip.Tip="Aparece en el título de la ventana y en recientes."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Autor (ingeniero)" FontSize="11"
                                               Foreground="{DynamicResource FgMuted}"/>
                                    <TextBox Margin="0,4,0,0"
                                             Text="{Binding Proyecto.Autor, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Código de obra" FontSize="11"
                                               Foreground="{DynamicResource FgMuted}"/>
                                    <TextBox Margin="0,4,0,0"
                                             Text="{Binding Proyecto.CodigoObra, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Sistemas del nivel" Margin="0,16,0,4" FontSize="11"
                                       Foreground="{DynamicResource FgMuted}"/>
                            <ItemsControl ItemsSource="{Binding NivelActivo.Sistemas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="🗂" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip.Tip="Renombrá el sistema (nivel)."/>
                                            <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                       Text="{Binding Losas.Count, StringFormat='{}{0} losa(s)'}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,0,0,12" Padding="10,6"
                            Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            IsVisible="{Binding StatusPersistencia, Converter={StaticResource StringNotEmptyToBoolConverter}}">
                        <TextBlock Text="{Binding StatusPersistencia}" FontSize="11"
                                   Foreground="{DynamicResource FgSecondary}" TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="3" Background="{DynamicResource BgSecondary}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <DataGrid x:Name="ProyectosRecientesGrid"
                                  ItemsSource="{Binding ProyectosRecientes}"
                                  SelectedItem="{Binding ProyectoRecienteSeleccionado}"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="Transparent" BorderThickness="0"
                                  DoubleTapped="OnAbrirRecienteDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NOMBRE"      Width="2*"  Binding="{Binding Nombre}"/>
                                <DataGridTextColumn Header="INGENIERO"   Width="*"   Binding="{Binding Ingeniero}"/>
                                <DataGridTextColumn Header="CÓDIGO OBRA" Width="120" Binding="{Binding Codia}"/>
                                <DataGridTextColumn Header="SISTEMAS"    Width="80"  Binding="{Binding Niveles}"/>
                                <DataGridTextColumn Header="ÚLT. EDICIÓN" Width="140" Binding="{Binding UltimaEdicion}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="4" Margin="0,8,0,0" HorizontalAlignment="Right"
                               Foreground="{DynamicResource FgMuted}" FontSize="11">
                        <Run Text="Total: "/>
                        <Run Text="{Binding ProyectosRecientes.Count, Mode=OneWay}"/>
                        <Run Text=" proyectos · registry compartido con MemoriaPlus"/>
                    </TextBlock>
                </Grid>

                <!-- MODO Editor: DataGrid de losas + tipos panel + panel lateral. -->
                <Grid Margin="16" ColumnDefinitions="*,320"
                      IsVisible="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Editor}">

                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Filtro tipo:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="180" Text="{Binding FiltroTipo, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="+ Losa" Width="80" Margin="8,0,0,0" Click="OnAddLosa"/>
                            <Button Content="– Losa" Width="80" Margin="4,0,0,0" Click="OnDelLosa"/>
                            <Button Content="Pegar de Excel..." Width="140" Margin="8,0,0,0"
                                    Click="OnPasteFromExcelClick"
                                    ToolTip.Tip="Pegar una tabla con columnas Lx, Ly, Espesor, Carga (y opcional Tipo/Rec)."/>
                            <Button Content="↶ Undo" Width="80" Margin="8,0,0,0"
                                    Command="{Binding UndoCommand}" ToolTip.Tip="Deshacer (Ctrl+Z). Max 50."/>
                            <Button Content="↷ Redo" Width="80" Margin="4,0,0,0"
                                    Command="{Binding RedoCommand}" ToolTip.Tip="Rehacer (Ctrl+Y)."/>
                            <Button Content="⌨  Atajos" Width="100" Margin="8,0,0,0"
                                    Command="{Binding AbrirShortcutsCommand}" ToolTip.Tip="Ver atajos (Ctrl+/)."/>
                            <TextBlock Text="(seleccioná una fila para eliminar / aplicar tipo)"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource FgMuted}"/>
                        </DockPanel>

                        <!-- BULK APPLY PANEL (visible con ≥2 losas seleccionadas). -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource BgSecondary}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                                CornerRadius="4" Margin="0,4" Padding="10,6"
                                IsVisible="{Binding MostrarBulkPanel}">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource FgPrimary}" Margin="0,0,8,0">
                                    <Run Text="✎"/>
                                    <Run Text="{Binding BulkSeleccionadasCount, Mode=OneWay}"/>
                                    <Run Text=" seleccionadas · aplicar:"/>
                                </TextBlock>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Lx" VerticalAlignment="Center" Margin="6,0,2,0"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                    <TextBox Width="55" Text="{Binding BulkLx, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" ToolTip.Tip="Lx en metros (vacío = no aplicar)"/>
                                    <TextBlock Text="Ly" VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                    <TextBox Width="55" Text="{Binding BulkLy, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" ToolTip.Tip="Ly en metros (vacío = no aplicar)"/>
                                    <TextBlock Text="H" VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                    <TextBox Width="55" Text="{Binding BulkEspesor, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" ToolTip.Tip="Espesor en metros (vacío = no aplicar)"/>
                                    <TextBlock Text="Carga" VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                    <TextBox Width="55" Text="{Binding BulkCarga, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" ToolTip.Tip="Carga en t/m² (vacío = no aplicar)"/>
                                    <TextBlock Text="Tipo" VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                    <TextBox Width="50" Text="{Binding BulkTipo, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" ToolTip.Tip="Código de tipo (vacío = no aplicar)"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Theme="{StaticResource PrimaryButton}"
                                        Content="✓ Confirmar" Padding="14,4" Margin="12,0,0,0"
                                        Command="{Binding AplicarBulkCommand}"
                                        ToolTip.Tip="Aplicar los valores no vacíos a las losas seleccionadas"/>
                            </DockPanel>
                        </Border>

                        <!-- Tipos panel abajo -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgSecondary}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                Margin="0,6,0,0" Padding="6" Height="240">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6"
                                           Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap">
                                    <Run Text="TIPOS DE LOSAS · " FontWeight="Bold"/>
                                    <Run Text="hover = descripción · click = aplicar a la fila seleccionada"/>
                                </TextBlock>
                                <v:TiposLosaPanel x:Name="TiposPanel"/>
                            </DockPanel>
                        </Border>

                        <DataGrid x:Name="LosasGrid" ItemsSource="{Binding LosasFiltradas}"
                                  AutoGenerateColumns="False" SelectionMode="Extended"
                                  HeadersVisibility="Column"
                                  CellEditEnding="OnLosasCellEdited"
                                  SelectionChanged="OnLosasSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ID" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button BorderThickness="0" Background="Transparent" Padding="2"
                                                    Cursor="Hand" HorizontalContentAlignment="Center"
                                                    Classes.connectmode="{Binding $parent[Window].DataContext.ModoConectarBordes}"
                                                    Click="OnLosaIdClick" Tag="{Binding}">
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- DIR: indicador 1D/2D (versión simplificada del SVG rotado WPF). -->
                                <DataGridTemplateColumn Header="DIR" Width="44" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Cond}" FontWeight="SemiBold" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       ToolTip.Tip="{Binding DireccionTrabajoTexto}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <v:TipoLosaIconView Codigo="{Binding Tipo, Mode=OneWay}"
                                                                Width="44" Height="44"
                                                                ToolTip.Tip="{Binding TipoDescripcion}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="TIPO" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button BorderThickness="1" Padding="6,2" Margin="2"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource Border}" Cursor="Hand"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="OnAbrirSelectorTipoLosaClick" Tag="{Binding}"
                                                    ToolTip.Tip="Click para abrir el selector visual de tipo Pieper-Martens">
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Tipo, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding TipoDescripcion, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Carga [t/m²]" Width="90"
                                                    Binding="{Binding Carga, StringFormat='{}{0:0.000}'}"/>
                                <DataGridTextColumn Header="H [m]" Width="70"
                                                    Binding="{Binding Espesor, StringFormat='{}{0:0.000}'}"/>
                                <DataGridTextColumn Header="Lx [m]" Width="70"
                                                    Binding="{Binding Lx, StringFormat='{}{0:0.000}'}"/>
                                <DataGridTextColumn Header="Ly [m]" Width="70"
                                                    Binding="{Binding Ly, StringFormat='{}{0:0.000}'}"/>
                                <DataGridTextColumn Header="Rec [m]" Width="70"
                                                    Binding="{Binding Rec, StringFormat='{}{0:0.000}'}"/>
                                <DataGridTemplateColumn Header="HEq [m]" Width="80" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding HEq, StringFormat='{}{0:0.000}', TargetNullValue=—}"
                                                       Foreground="{DynamicResource FgMuted}"
                                                       VerticalAlignment="Center" Margin="4,0"
                                                       ToolTip.Tip="Espesor equivalente (αfm ACI 318 §9.5.3.3) — para vigueta+bloque."/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Ly/Lx" Width="60" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,2"
                                                    Classes.aspectwarn="{Binding AspectoFueraDeRango}"
                                                    ToolTip.Tip="{Binding AspectoMensaje}">
                                                <TextBlock Text="{Binding Aspecto, StringFormat='{}{0:0.00}', Mode=OneWay}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Mfx" Width="80" IsReadOnly="True"
                                                    Binding="{Binding Mfx, StringFormat='{}{0:0.0000}'}"/>
                                <DataGridTextColumn Header="Mfy" Width="80" IsReadOnly="True"
                                                    Binding="{Binding Mfy, StringFormat='{}{0:0.0000}'}"/>
                                <DataGridTextColumn Header="MSx" Width="80" IsReadOnly="True"
                                                    Binding="{Binding MSx, StringFormat='{}{0:0.0000}'}"/>
                                <DataGridTextColumn Header="MSy" Width="80" IsReadOnly="True"
                                                    Binding="{Binding MSy, StringFormat='{}{0:0.0000}'}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Panel lateral: settings del sistema + bordes -->
                    <Border Grid.Column="1" Background="{DynamicResource BgSecondary}" Margin="6,0,0,0" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Proyecto" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="Nombre del proyecto" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Proyecto.Nombre, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip.Tip="Aparece en el título de la ventana y en el Explorador"/>
                                <TextBlock Text="Autor (ingeniero)" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Proyecto.Autor, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Código de obra" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Proyecto.CodigoObra, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding AutoBackupActivo, Mode=TwoWay}"
                                          Content="Backups automáticos al guardar"
                                          ToolTip.Tip="Crea una copia timestamped en {carpeta}/backups/ antes de sobreescribir. Conserva las últimas 20."/>

                                <Separator Margin="0,12"/>

                                <TextBlock Text="Sistema" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="Nombre del sistema" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Sistema.Nombre, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip.Tip="Aparece en la barra de estado y distingue niveles."/>
                                <TextBlock Text="FC [ton/cm²]" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Sistema.Fc, StringFormat='{}{0:0.000}'}"/>
                                <TextBlock Text="FY [ton/cm²]" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Sistema.Fy, StringFormat='{}{0:0.000}'}"/>
                                <TextBlock Text="ADICIONALES (0=rectas, 1=camelladas)" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Sistema.Adicionales}"/>

                                <Separator Margin="0,12"/>

                                <!-- Editores globales VigaPrincipal + Bovedilla (A3). Alimentan αfm y cómputos. -->
                                <TextBlock Text="Viga principal (para αfm)" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource Accent}"/>
                                <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="b [cm]" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                                        <TextBox Text="{Binding Sistema.VigaPrincipal.BaseCm, StringFormat='{}{0:0.##}'}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="h [cm]" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                                        <TextBox Text="{Binding Sistema.VigaPrincipal.AlturaCm, StringFormat='{}{0:0.##}'}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Bovedilla 1D  (S · B · L · H, en m)" FontWeight="Bold" FontSize="13" Margin="0,10,0,0"/>
                                <Grid ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
                                    <TextBox Grid.Column="0" Margin="0,0,2,0" Text="{Binding Sistema.Bovedilla1D.S, StringFormat='{}{0:0.###}'}" ToolTip.Tip="Separación / ancho nervio (m)"/>
                                    <TextBox Grid.Column="1" Margin="2,0"   Text="{Binding Sistema.Bovedilla1D.B, StringFormat='{}{0:0.###}'}" ToolTip.Tip="Ancho bovedilla (m)"/>
                                    <TextBox Grid.Column="2" Margin="2,0"   Text="{Binding Sistema.Bovedilla1D.L, StringFormat='{}{0:0.###}'}" ToolTip.Tip="Largo bovedilla (m)"/>
                                    <TextBox Grid.Column="3" Margin="2,0,0,0" Text="{Binding Sistema.Bovedilla1D.H, StringFormat='{}{0:0.###}'}" ToolTip.Tip="Altura bovedilla (m)"/>
                                </Grid>

                                <TextBlock Text="Bovedilla 2D  (S · B · L · H, en m)" FontWeight="Bold" FontSize="13" Margin="0,8,0,0"/>
                                <Grid ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
                                    <TextBox Grid.Column="0" Margin="0,0,2,0" Text="{Binding Sistema.Bovedilla2D.S, StringFormat='{}{0:0.###}'}" ToolTip.Tip="Separación / ancho nervio (m)"/>
                                    <TextBox Grid.Column="1" Margin="2,0"   Text="{Binding Sistema.Bovedilla2D.B, StringFormat='{}{0:0.###}'}" ToolTip.Tip="Ancho bovedilla (m)"/>
                                    <TextBox Grid.Column="2" Margin="2,0"   Text="{Binding Sistema.Bovedilla2D.L, StringFormat='{}{0:0.###}'}" ToolTip.Tip="Largo bovedilla (m)"/>
                                    <TextBox Grid.Column="3" Margin="2,0,0,0" Text="{Binding Sistema.Bovedilla2D.H, StringFormat='{}{0:0.###}'}" ToolTip.Tip="Altura bovedilla (m)"/>
                                </Grid>

                                <Separator Margin="0,12"/>

                                <!-- Panel αfm (ACI 318 §9.5.3.3) de la losa seleccionada (A3). -->
                                <TextBlock Text="αfm — rigidez de bordes (ACI 318 §9.5.3.3)"
                                           FontWeight="Bold" FontSize="14" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Accent}"/>
                                <StackPanel IsVisible="{Binding HayLosaSeleccionada, Converter={StaticResource BoolToCollapsedIfFalse}}">
                                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource FgMuted}"
                                               Text="{Binding LosaSeleccionada.Id, StringFormat='Losa {0} seleccionada'}"/>
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,6,0,0">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="αx" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding LosaSeleccionada.AlphaX, StringFormat='{}{0:0.000}', TargetNullValue='—', FallbackValue='—'}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="αy" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding LosaSeleccionada.AlphaY, StringFormat='{}{0:0.000}', TargetNullValue='—', FallbackValue='—'}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="αm" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding LosaSeleccionada.AlphaM, StringFormat='{}{0:0.000}', TargetNullValue='—', FallbackValue='—'}"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Chip OK/CHK (sólo si αm está calculado). -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                IsVisible="{Binding LosaSeleccionada.AlphaM, Converter={StaticResource NullToCollapsed}}">
                                        <Border CornerRadius="10" Padding="10,3" Background="#2E7D32"
                                                IsVisible="{Binding LosaSeleccionada.AlphaFmCumple, Converter={StaticResource BoolToCollapsedIfFalse}}">
                                            <TextBlock Text="✔ αm &gt; 2 — OK" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                        <Border CornerRadius="10" Padding="10,3" Background="#C62828"
                                                IsVisible="{Binding LosaSeleccionada.AlphaFmCumple, Converter={StaticResource BoolToCollapsedIfTrue}}">
                                            <TextBlock Text="✖ αm ≤ 2 — revisar espesor" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FgMuted}"
                                           IsVisible="{Binding HayLosaSeleccionada, Converter={StaticResource BoolToCollapsedIfTrue}}"
                                           Text="Seleccioná una losa en el grid para ver su relación de rigideces αfm."/>

                                <Separator Margin="0,12"/>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Left" Text="Bordes adic. SEGÚN X"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                    <ToggleButton DockPanel.Dock="Right" Padding="6,2"
                                                  IsChecked="{Binding ModoConectarBordes, Mode=TwoWay}"
                                                  ToolTip.Tip="Activá y click en dos IDs del grid para crear el borde."
                                                  FontSize="11">
                                        <TextBlock Text="🔗 Conectar"/>
                                    </ToggleButton>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Sistema.BordesX}" AutoGenerateColumns="False"
                                          MinHeight="100" MaxHeight="260" Margin="0,4,0,0" Tag="X"
                                          CellEditEnding="OnBordeCellEdited">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="B-I" Binding="{Binding BI}" Width="*"/>
                                        <DataGridTextColumn Header="B-J" Binding="{Binding BJ}" Width="*"/>
                                        <DataGridTemplateColumn Header="BAL" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedItem="{Binding Balanceo, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch">
                                                        <sys:String>S</sys:String>
                                                        <sys:String>N</sys:String>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="+ Borde X" Click="OnAddBordeX"/>
                                    <Button Content="– Borde X" Click="OnDelBordeX" Margin="4,0,0,0"/>
                                    <Button Content="Auto BAL" Margin="8,0,0,0"
                                            Command="{Binding AutoBalanceoCommand}"
                                            ToolTip.Tip="Setea BAL=N en bordes con voladizo."/>
                                </StackPanel>

                                <Separator Margin="0,12"/>
                                <TextBlock Text="Bordes adic. SEGÚN Y" FontWeight="Bold"/>
                                <DataGrid ItemsSource="{Binding Sistema.BordesY}" AutoGenerateColumns="False"
                                          MinHeight="100" MaxHeight="260" Margin="0,4,0,0" Tag="Y"
                                          CellEditEnding="OnBordeCellEdited">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="B-I" Binding="{Binding BI}" Width="*"/>
                                        <DataGridTextColumn Header="B-J" Binding="{Binding BJ}" Width="*"/>
                                        <DataGridTemplateColumn Header="BAL" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedItem="{Binding Balanceo, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch">
                                                        <sys:String>S</sys:String>
                                                        <sys:String>N</sys:String>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="+ Borde Y" Click="OnAddBordeY"/>
                                    <Button Content="– Borde Y" Click="OnDelBordeY" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- MODO Lienzo CAD (stub Fase E). -->
                <ContentControl IsVisible="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PlanoCad}">
                    <cad:CadView x:Name="CadEditorView" DataContext="{Binding}"/>
                </ContentControl>

                <!-- Modos enrutados al ContentControl de arriba (Fase D):
                     Planta2D, VisorPdf, Vista3D, CargasCombinaciones, Vigas,
                     Columnas. Sus bloques IsVisible se reemplazaron por el
                     router CurrentView; las sub-vistas no cambian. -->

                <!-- MODO DLEditor (texto crudo). -->
                <Grid Margin="16" RowDefinitions="Auto,*"
                      IsVisible="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DLEditor}">
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center"
                                   Text="Vista del archivo .DL generado a partir del modelo (lectura/edición)"/>
                        <Button DockPanel.Dock="Right" Content="Aplicar al modelo" Width="140" Click="OnApplyDLText"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" x:Name="DLEditor"
                             Text="{Binding DLContent, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"/>
                </Grid>

                <!-- MODO Salida .TXT (Texto resaltado + Tabla editable). -->
                <Grid Margin="16" RowDefinitions="Auto,*"
                      IsVisible="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Salida}">
                    <TextBlock Grid.Row="0" Text="{Binding TxtPath, StringFormat='Archivo: {0}'}"
                               Foreground="{DynamicResource FgMuted}" Margin="0,0,0,8"/>
                    <TabControl Grid.Row="1">
                        <TabItem Header="Texto">
                            <v:HighlightedTxtView Text="{Binding TxtContent}"/>
                        </TabItem>
                        <TabItem Header="Tabla (editable)">
                            <v:TxtTablaView Text="{Binding TxtContent}" OriginalPath="{Binding TxtPath}"/>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Modos Aceros y Reglamento: enrutados al ContentControl
                     (router CurrentView). -->

                <!-- MODO Plugins. -->
                <Grid Margin="16" RowDefinitions="Auto,*"
                      IsVisible="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Plugins}">
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Recargar plugins" Width="140" Click="OnReloadPlugins"/>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Scripts .csx en /plugins. Hooks: load, pre-dl, pre-run, post-run, post-txt, custom-export. Solo se ejecutan los CONFIABLES (Roslyn no es un sandbox fuerte)."/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Plugins.Loaded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            Background="{DynamicResource BgSecondary}" Margin="0,0,0,8" Padding="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}"
                                                               FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock DockPanel.Dock="Left" Margin="10,2,0,0"
                                                               Text="{Binding FileName, StringFormat='({0})'}"
                                                               Foreground="{DynamicResource FgMuted}"/>
                                                </DockPanel>
                                                <TextBlock Margin="0,4,0,0">
                                                    <Run Foreground="{DynamicResource FgMuted}" Text="Autor:"/>
                                                    <Run Text="{Binding Manifest.Author, Mode=OneWay}"/>
                                                    <Run Foreground="{DynamicResource FgMuted}" Text=" · Versión:"/>
                                                    <Run Text="{Binding Manifest.Version, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Text="{Binding Manifest.Description, Mode=OneWay}"
                                                           Foreground="{DynamicResource FgSecondary}"/>
                                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource FgMuted}"
                                                           Text="{Binding Sha256, StringFormat='SHA-256: {0}'}"
                                                           FontFamily="Consolas" FontSize="10"/>
                                                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Err}"
                                                           Text="{Binding CompileError, StringFormat='Error de compilación: {0}'}"
                                                           IsVisible="{Binding CompileError, Converter={StaticResource NullToCollapsed}}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                                                <Button Content="Confiar" Width="100" Click="OnTrustPluginClick"
                                                        Tag="{Binding FullPath}"
                                                        IsVisible="{Binding Trusted, Converter={StaticResource BoolToCollapsedIfTrue}}"/>
                                                <Button Content="Revocar" Width="100" Margin="0,4,0,0" Click="OnRevokeTrustClick"
                                                        Tag="{Binding FullPath}"
                                                        Background="{DynamicResource Border}"
                                                        IsVisible="{Binding Trusted, Converter={StaticResource BoolToCollapsedIfFalse}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Modos Validación, Bajada de Cargas, Búsqueda y Configuración:
                     enrutados al ContentControl (router CurrentView). La
                     ConfiguracionView ahora se crea en el VM, que reenvía el
                     evento AparienciaCambiada vía OnAplicarApariencia. -->

                <!-- MODO Acerca de. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Acerca}">
                    <StackPanel Margin="32,24" MaxWidth="900">
                        <TextBlock Text="{x:Static cmn:Branding.Producto}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock Text="Capa de UI, edición, visualización y exportación construida sobre el motor original."
                                   Margin="0,4,0,0" Foreground="{DynamicResource FgSecondary}"/>

                        <Separator Margin="0,16"/>
                        <TextBlock Text="Crédito principal" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource FgSecondary}">
                            <Run Text="El motor de cálculo es obra de "/><Run FontWeight="Bold" Text="Francisco Eludino Perdomo"/><Run Text=" (Losas v5.00, febrero 2011). El método implementado es el de Pieper-Martens (TU Braunschweig), adaptado para el análisis de losas continuas apoyadas en tres y cuatro bordes. Contacto: fa.perdomo@gmail.com."/>
                        </TextBlock>

                        <Separator Margin="0,16"/>
                        <TextBlock Text="Alcance del wrapper" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource FgSecondary}"
                                   Text="El presente programa NO modifica el binario original. Genera el archivo .DL de entrada conforme al formato documentado por el autor, permite lanzar Losas.exe (la ejecución del cálculo es manual desde su GUI) e importar el .TXT resultante para visualizar y exportar. Agrega edición estructurada con catálogo de tipos, esquema visual, preview del .TXT, exportación a CSV/XLSX, panel del Reglamento Dominicano y arquitectura de plugins .csx en sandbox Roslyn."/>

                        <Separator Margin="0,16"/>
                        <TextBlock Text="Limitaciones del motor (según el autor)" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource FgSecondary}"
                                   Text="· Carga viva ≤ 2/3 de la carga total (sin factorizar). · Apoyos lineales rígidos. · No verifica fuerza cortante. · No calcula deformaciones."/>

                        <Separator Margin="0,16"/>
                        <TextBlock FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource FgPrimary}">
                            <Run Text="Autor del wrapper "/><Run Text="{x:Static cmn:Branding.Producto}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource FgSecondary}">
                            <Run Text="Esta capa de UI/edición/exportación fue construida por "/><Run FontWeight="Bold" Text="Emil Guillen De la Cruz"/><Run Text=" como aporte al ecosistema de herramientas estructurales en República Dominicana. El motor sigue siendo obra exclusiva de F. Perdomo; "/><Run Text="{x:Static cmn:Branding.Producto}"/><Run Text=" se ofrece como sugerencia de modernización."/>
                        </TextBlock>
                        <Grid Margin="0,12,0,0" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Email" Foreground="{DynamicResource FgMuted}"/>
                            <HyperlinkButton Grid.Row="0" Grid.Column="1" Padding="0" Content="emilgdc@gmail.com"
                                             NavigateUri="mailto:emilgdc@gmail.com"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GitHub" Foreground="{DynamicResource FgMuted}"/>
                            <HyperlinkButton Grid.Row="1" Grid.Column="1" Padding="0" Content="@dashy2004"
                                             NavigateUri="https://github.com/dashy2004"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="YouTube" Foreground="{DynamicResource FgMuted}"/>
                            <HyperlinkButton Grid.Row="2" Grid.Column="1" Padding="0" Content="@emilguillen"
                                             NavigateUri="https://www.youtube.com/@emilguillen"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Instagram" Foreground="{DynamicResource FgMuted}"/>
                            <HyperlinkButton Grid.Row="3" Grid.Column="1" Padding="0" Content="@emilguillendelacruz"
                                             NavigateUri="https://www.instagram.com/emilguillendelacruz"/>
                        </Grid>

                        <Separator Margin="0,16"/>
                        <TextBlock Text="Aviso legal" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Warn}"
                                   Text="La distribución y uso público de este wrapper junto con el binario original requieren autorización de F. Perdomo. La presente compilación es una capa externa que respeta y atribuye la autoría del motor de cálculo. El código del wrapper es de Emil Guillen De la Cruz y se entrega como sugerencia/aporte sin reclamar derechos sobre el motor original."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- LOG EXPANDIBLE: visible si LogToggle activo. -->
            <Border Grid.Row="2" Background="#0F172A"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding #LogToggle.IsChecked, Converter={StaticResource BoolToCollapsedIfFalse}}"
                    Padding="14,8">
                <TextBox Height="120" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                         Background="#0F172A" Foreground="#E2E8F0" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11" VerticalContentAlignment="Top"/>
            </Border>

            <!-- STATUSBAR inferior. -->
            <Border Grid.Row="3" Padding="16,6" Background="{DynamicResource BgInput}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,6,0"
                             Fill="{DynamicResource Ok}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12">
                        <Run Foreground="{DynamicResource FgMuted}" Text="Status:"/>
                        <Run Foreground="{DynamicResource FgPrimary}" FontWeight="SemiBold" Text="Operativo"/>
                        <Run Foreground="{DynamicResource FgMuted}" Text="  ·  "/>
                        <Run Foreground="{DynamicResource FgSecondary}" Text="{Binding SistemaActivo.Nombre, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                               Margin="16,0,0,0" MaxWidth="340" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource FgMuted}"
                               ToolTip.Tip="{Binding Proyecto.Archivo}"
                               Text="{Binding Proyecto.Archivo, Mode=OneWay}"/>
                    <ToggleButton DockPanel.Dock="Right" x:Name="LogToggle" Content="Logs"
                                  Width="60" Margin="6,0,0,0" Background="Transparent"
                                  Foreground="{DynamicResource FgSecondary}" BorderThickness="0"
                                  FontSize="12"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                               Margin="0,0,16,0" Foreground="{DynamicResource FgMuted}"
                               Text="{Binding CopyrightTexto}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
