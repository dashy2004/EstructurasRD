<UserControl x:Class="LosasPlus.Views.TiposLosaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LosasPlus.Views"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Items">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="ItemBorder"
                            Margin="3" Width="74" Height="84"
                            Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="3"
                            ToolTipService.InitialShowDelay="200"
                            Cursor="Hand"
                            MouseLeftButtonDown="OnItemClick"
                            Tag="{Binding Codigo}">
                        <Border.ToolTip>
                            <StackPanel MaxWidth="280">
                                <TextBlock>
                                    <Run Text="TIPO " FontWeight="Bold"/>
                                    <Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray">
                                    <Run Text="Bordes empotrados: "/>
                                    <Run Text="{Binding BordesContinuos, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border.ToolTip>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentHi}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <v:TipoLosaIconView Codigo="{Binding Codigo, Mode=OneWay}"
                                            Width="68" Height="78"
                                            IsHitTestVisible="False"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
