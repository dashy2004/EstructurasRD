<UserControl x:Class="LosasPlus.Views.Columnas.ColumnaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <Style x:Key="EtiquetaSeccion" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="CampoNumerico" TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="BotonCompacto" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="TarjetaSeccion" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </UserControl.Resources>

    <!-- DataContext del sub-VM ColumnaEditor: lo establece MainWindow al pegar el View. -->
    <Grid DataContext="{Binding ColumnaEditor}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Left" Text="🟦  Columnas RC"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="➕  Nueva Columna" Style="{StaticResource BotonCompacto}"
                        Command="{Binding NuevaColumnaCommand}"/>
                <TextBlock Text="Columna:" Style="{StaticResource EtiquetaSeccion}" Margin="16,0,8,0"/>
                <ComboBox Width="170" VerticalAlignment="Center"
                          ItemsSource="{Binding Columnas}"
                          SelectedItem="{Binding ColumnaActiva}"
                          DisplayMemberPath="Nombre"
                          ToolTip="Columna en edición."/>
                <Button Content="🗑  Eliminar Columna" Style="{StaticResource BotonCompacto}"
                        Margin="16,0,0,0" Command="{Binding EliminarColumnaCommand}"/>
                <Border Margin="16,0,0,0" Padding="10,4" BorderThickness="1" CornerRadius="3"
                        VerticalAlignment="Center"
                        ToolTip="Ratio máximo radial Demanda/Capacidad — verde si la columna es conforme, rojo si alguna demanda excede 1.0.">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1F06914A"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Ok}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ColumnaConforme}" Value="False">
                                    <Setter Property="Background" Value="#1FBA1A1A"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Err}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource FgPrimary}" FontSize="12"
                               Text="{Binding RatioMaximoColumna, StringFormat={}D/C máx: {0:0.00}}"/>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Cuerpo: panel de parámetros + panel de gráficas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Panel izquierdo: parámetros + capas + demandas ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <!-- PARÁMETROS: geometría + materiales -->
                <Border Grid.Row="0" Style="{StaticResource TarjetaSeccion}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="PARÁMETROS"
                                   Style="{StaticResource EtiquetaSeccion}" Margin="0,0,0,6"/>
                        <Grid Grid.Row="1" IsEnabled="{Binding HayColumnaActiva}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Altura (m)"
                                       Style="{StaticResource EtiquetaCampo}"/>
                            <TextBox  Grid.Row="0" Grid.Column="1" Style="{StaticResource CampoNumerico}"
                                      Text="{Binding ColumnaActiva.Altura, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"
                                      GotFocus="OnSnapshotAntesDeEditar"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Base (m)"
                                       Style="{StaticResource EtiquetaCampo}"/>
                            <TextBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource CampoNumerico}"
                                      Text="{Binding ColumnaActiva.Geometria.Base, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"
                                      GotFocus="OnSnapshotAntesDeEditar"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Peralte (m)"
                                       Style="{StaticResource EtiquetaCampo}"/>
                            <TextBox  Grid.Row="2" Grid.Column="1" Style="{StaticResource CampoNumerico}"
                                      Text="{Binding ColumnaActiva.Geometria.Peralte, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"
                                      GotFocus="OnSnapshotAntesDeEditar"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="f'c (MPa)"
                                       Style="{StaticResource EtiquetaCampo}"/>
                            <TextBox  Grid.Row="3" Grid.Column="1" Style="{StaticResource CampoNumerico}"
                                      Text="{Binding ColumnaActiva.Geometria.Fc, StringFormat=0.#, UpdateSourceTrigger=LostFocus}"
                                      GotFocus="OnSnapshotAntesDeEditar"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="fy (MPa)"
                                       Style="{StaticResource EtiquetaCampo}"/>
                            <TextBox  Grid.Row="4" Grid.Column="1" Style="{StaticResource CampoNumerico}"
                                      Text="{Binding ColumnaActiva.Acero.Fy, StringFormat=0.#, UpdateSourceTrigger=LostFocus}"
                                      GotFocus="OnSnapshotAntesDeEditar"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CAPAS DE ACERO -->
                <Border Grid.Row="2" Style="{StaticResource TarjetaSeccion}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="CAPAS DE ACERO"
                                       Style="{StaticResource EtiquetaSeccion}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="+" Style="{StaticResource BotonCompacto}"
                                        Command="{Binding AgregarCapaCommand}" ToolTip="Añadir capa"/>
                                <Button Content="🗑" Style="{StaticResource BotonCompacto}"
                                        Command="{Binding EliminarCapaCommand}" ToolTip="Eliminar capa"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ColumnaActiva.Acero.Capas}"
                                  SelectedItem="{Binding CapaSeleccionada}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" HeadersVisibility="Column"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  BeginningEdit="OnBeginningEdit">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Profundidad (m)" Width="*"
                                                    Binding="{Binding Profundidad, StringFormat=0.###}"/>
                                <DataGridTextColumn Header="Area (m²)" Width="*"
                                                    Binding="{Binding Area, StringFormat=0.######}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- DEMANDAS DE DISEÑO -->
                <Border Grid.Row="4" Style="{StaticResource TarjetaSeccion}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="DEMANDAS DE DISEÑO"
                                       Style="{StaticResource EtiquetaSeccion}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="+"  Style="{StaticResource BotonCompacto}"
                                        Command="{Binding AgregarDemandaCommand}"  ToolTip="Añadir demanda"/>
                                <Button Content="🗑" Style="{StaticResource BotonCompacto}"
                                        Command="{Binding EliminarDemandaCommand}" ToolTip="Eliminar demanda"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Demandas}"
                                  SelectedItem="{Binding DemandaSeleccionada}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" HeadersVisibility="Column"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  BeginningEdit="OnBeginningEdit">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Combinación" Width="*"
                                                    Binding="{Binding NombreCombo}"/>
                                <DataGridTextColumn Header="Pu (kN)" Width="*"
                                                    Binding="{Binding Pu, StringFormat=0.#}"/>
                                <DataGridTextColumn Header="Mu (kN·m)" Width="*"
                                                    Binding="{Binding Mu, StringFormat=0.#}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Panel derecho: diagramas ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.6*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Diagrama de interacción P-M -->
                <Border Grid.Row="0" Style="{StaticResource TarjetaSeccion}">
                    <oxy:PlotView Model="{Binding ModeloDiagramaPM}" Background="Transparent"/>
                </Border>

                <!-- Croquis acotado de la sección -->
                <Border Grid.Row="2" Style="{StaticResource TarjetaSeccion}">
                    <oxy:PlotView Model="{Binding ModeloSeccionTransversal}" Background="Transparent"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
