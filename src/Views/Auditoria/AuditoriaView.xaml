<UserControl x:Class="LosasPlus.Views.Auditoria.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:aud="clr-namespace:LosasPlus.Auditoria;assembly=LosasPlus.Core"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <Style x:Key="EtiquetaSeccion" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="TarjetaSeccion" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="NumeroKpi" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="JetBrains Mono, Consolas"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EtiquetaKpi" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Valores enum bindeados al ComboBox del filtro de severidad. La
             opción "Todos" (representada por null) la maneja el VM al recibir
             la entrada vacía del ComboBox; aquí proveemos los tres valores
             concretos del enum. -->
        <ObjectDataProvider x:Key="SeveridadesDisponibles"
                            MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="aud:TipoMensajeAuditoria"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <!-- DataContext del sub-VM Auditoria: lo establece MainWindow al pegar el View. -->
    <Grid DataContext="{Binding Auditoria}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Toolbar superior ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Left" Text="📊  Auditoría del Proyecto"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Progress indeterminado mientras el motor corre. -->
                <ProgressBar Width="120" Height="6" IsIndeterminate="True"
                             Margin="0,0,12,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Accent}"
                             Background="{DynamicResource BgInput}"
                             BorderThickness="0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EjecutandoAnalisis}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Text="Filtro:" Style="{StaticResource EtiquetaSeccion}" Margin="0,0,8,0"/>
                <ComboBox Width="160" VerticalAlignment="Center"
                          ItemsSource="{Binding Source={StaticResource SeveridadesDisponibles}}"
                          SelectedItem="{Binding FiltroGravedad}"
                          ToolTip="Severidad mostrada en el log. Vacío = sin filtro.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="✕  Todos" Padding="10,4" Margin="6,0,0,0"
                        Cursor="Hand" FontSize="11"
                        Click="OnLimpiarFiltro"
                        ToolTip="Quitar el filtro de severidad (muestra todos los mensajes)."/>
            </StackPanel>
        </DockPanel>

        <!-- ===== Cuerpo: dos columnas asimétricas ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================
                 COL 0 — KPIs / Métricas
                 ============================================ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TARJETA DE ESTADO GLOBAL (chip gigante, cambia color por DataTrigger sobre ProyectoConforme) -->
                <Border Grid.Row="0" BorderThickness="1" CornerRadius="6" Padding="20" Height="140">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1F06914A"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Ok}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProyectoConforme}" Value="False">
                                    <Setter Property="Background" Value="#1FBA1A1A"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Err}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Estado CONFORME (visible cuando ProyectoConforme = true). -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProyectoConforme}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="✓" FontSize="36" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Ok}"/>
                            <TextBlock Text="PROYECTO CONFORME" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource FgPrimary}"/>
                            <TextBlock Text="Sin fallos críticos en el grafo del proyecto"
                                       FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource FgMuted}"/>
                        </StackPanel>
                        <!-- Estado CRÍTICO (visible cuando ProyectoConforme = false). -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProyectoConforme}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="⛔" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="CRÍTICO — REVISAR ELEMENTOS" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource FgPrimary}"/>
                            <TextBlock Text="Hay fallos D/C o errores estructurales en el grafo"
                                       FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource FgMuted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TARJETA DE CONTADORES — Advertencias / Errores en bloques numéricos grandes -->
                <Border Grid.Row="2" Style="{StaticResource TarjetaSeccion}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="HALLAZGOS"
                                   Style="{StaticResource EtiquetaSeccion}" Margin="0,0,0,10"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CantidadAdvertencias}"
                                           Style="{StaticResource NumeroKpi}"
                                           Foreground="{DynamicResource Warn}"/>
                                <TextBlock Text="⚠  ADVERTENCIAS" Style="{StaticResource EtiquetaKpi}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource Border}" Margin="0,8"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding CantidadErrores}"
                                           Style="{StaticResource NumeroKpi}"
                                           Foreground="{DynamicResource Err}"/>
                                <TextBlock Text="⛔  ERRORES" Style="{StaticResource EtiquetaKpi}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- TARJETA DE RATIOS D/C — barra cromática por elemento estructural -->
                <Border Grid.Row="4" Style="{StaticResource TarjetaSeccion}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="RATIOS D/C MÁXIMOS"
                                   Style="{StaticResource EtiquetaSeccion}" Margin="0,0,0,10"/>

                        <!-- Vigas -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vigas (flexión)"
                                   Style="{StaticResource EtiquetaCampo}"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Height="14"
                                     Margin="0,3" Minimum="0" Maximum="1.5"
                                     Value="{Binding RatioMaximoVigas, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RatioVigasExcede}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Err}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,3,0,3"
                                   FontFamily="JetBrains Mono, Consolas" FontSize="11"
                                   Foreground="{DynamicResource FgPrimary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding RatioMaximoVigas, StringFormat=0.000}"/>

                        <!-- Columnas -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Columnas (P-M)"
                                   Style="{StaticResource EtiquetaCampo}"/>
                        <ProgressBar Grid.Row="2" Grid.Column="1" Height="14"
                                     Margin="0,3" Minimum="0" Maximum="1.5"
                                     Value="{Binding RatioMaximoColumnas, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RatioColumnasExcede}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Err}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,3,0,3"
                                   FontFamily="JetBrains Mono, Consolas" FontSize="11"
                                   Foreground="{DynamicResource FgPrimary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding RatioMaximoColumnas, StringFormat=0.000}"/>

                        <!-- Zapatas -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Zapatas (ELU)"
                                   Style="{StaticResource EtiquetaCampo}"/>
                        <ProgressBar Grid.Row="3" Grid.Column="1" Height="14"
                                     Margin="0,3" Minimum="0" Maximum="1.5"
                                     Value="{Binding RatioMaximoZapatas, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RatioZapatasExcede}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Err}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="8,3,0,3"
                                   FontFamily="JetBrains Mono, Consolas" FontSize="11"
                                   Foreground="{DynamicResource FgPrimary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding RatioMaximoZapatas, StringFormat=0.000}"/>

                        <!-- Global -->
                        <Border Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                Background="{DynamicResource BgInput}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="3" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="GLOBAL (peor caso)"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource EtiquetaSeccion}"/>
                                <TextBlock Grid.Column="1"
                                           FontFamily="JetBrains Mono, Consolas"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FgPrimary}"
                                           Text="{Binding RatioMaximoGlobal, StringFormat=0.000}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================
                 COL 1 — Log Maestro de Alertas
                 ============================================ -->
            <Border Grid.Column="2" Style="{StaticResource TarjetaSeccion}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="LOG MAESTRO DE ALERTAS"
                                   Style="{StaticResource EtiquetaSeccion}"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   FontFamily="JetBrains Mono, Consolas" FontSize="11"
                                   Foreground="{DynamicResource FgMuted}">
                            <Run Text="Mostrando: "/>
                            <Run Text="{Binding MensajesFiltrados.Count, Mode=OneWay, FallbackValue=0}"/>
                        </TextBlock>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding MensajesFiltrados}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionUnit="FullRow"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource BgInput}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tipo}" Value="ErrorFallo">
                                        <Setter Property="Foreground" Value="{DynamicResource Err}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tipo}" Value="Advertencia">
                                        <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tipo}" Value="Info">
                                        <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Severidad: icono compacto (• / ⚠ / ⛔) según Tipo. -->
                            <DataGridTemplateColumn Header="" Width="40" SortMemberPath="Tipo">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="•"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="Advertencia">
                                                                <Setter Property="Text" Value="⚠"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="ErrorFallo">
                                                                <Setter Property="Text" Value="⛔"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CÓDIGO" Width="110" Binding="{Binding Codigo}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="JetBrains Mono, Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CATEGORÍA" Width="150" Binding="{Binding Categoria}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="MENSAJE" Width="*" Binding="{Binding Mensaje}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="4,4"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="UBICACIÓN" Width="220" Binding="{Binding Ubicacion}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
