<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             x:Class="LosasPlus.Views.TipoLosaIconView"
             Background="Transparent"
             ClipToBounds="True">
    <Grid>
        <!-- SVG embebido (vector escalable) cuando existe para el código. -->
        <svg:Svg x:Name="Svg" IsVisible="False" Stretch="Uniform" IsHitTestVisible="False"/>
        <!-- Fallback: dibujo programático con Shapes. -->
        <Canvas x:Name="Canvas" Background="Transparent" IsVisible="False"/>
    </Grid>
</UserControl>
