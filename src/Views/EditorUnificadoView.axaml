<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LosasPlus.Views"
             x:Class="LosasPlus.Views.EditorUnificadoView"
             x:CompileBindings="False"
             Background="{DynamicResource BgPrimary}">

    <!-- Editor unificado (UI1): hospeda Planta 2D, el único lienzo desde UI1.6 —
         el modo Plano CAD fue retirado; import/CAD viven en la toolbar y el
         panel PLANO/PDF de Planta2DEditorView. -->
    <v:Planta2DEditorView x:Name="EditorView" DataContext="{Binding}"/>
</UserControl>
