<UserControl x:Class="LosasPlus.Views.Rc.RcSectionDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <Style x:Key="EtiquetaSeccion" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
        </Style>
        <Style x:Key="TarjetaSeccion" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="EtiquetaParam" TargetType="TextBlock">
            <Setter Property="Width" Value="146"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Columna izquierda: parámetros ===== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Materiales -->
                <Border Style="{StaticResource TarjetaSeccion}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MATERIALES" Style="{StaticResource EtiquetaSeccion}"
                                   Margin="0,0,0,8"/>
                        <DockPanel Margin="0,5">
                            <TextBlock DockPanel.Dock="Left" Text="f'c (MPa)"
                                       Style="{StaticResource EtiquetaParam}"/>
                            <TextBox Text="{Binding Fc, StringFormat=0.##, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock DockPanel.Dock="Left" Text="fy (MPa)"
                                       Style="{StaticResource EtiquetaParam}"/>
                            <TextBox Text="{Binding Fy, StringFormat=0.##, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Sección -->
                <Border Style="{StaticResource TarjetaSeccion}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SECCIÓN" Style="{StaticResource EtiquetaSeccion}"
                                   Margin="0,0,0,8"/>
                        <DockPanel Margin="0,5">
                            <TextBlock DockPanel.Dock="Left" Text="Base (m)"
                                       Style="{StaticResource EtiquetaParam}"/>
                            <TextBox Text="{Binding Base, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock DockPanel.Dock="Left" Text="Peralte (m)"
                                       Style="{StaticResource EtiquetaParam}"/>
                            <TextBox Text="{Binding Peralte, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock DockPanel.Dock="Left" Text="Recubrimiento (m)"
                                       Style="{StaticResource EtiquetaParam}"/>
                            <TextBox Text="{Binding Recubrimiento, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Refuerzo -->
                <Border Style="{StaticResource TarjetaSeccion}">
                    <StackPanel>
                        <TextBlock Text="REFUERZO LONGITUDINAL" Style="{StaticResource EtiquetaSeccion}"
                                   Margin="0,0,0,8"/>
                        <DockPanel Margin="0,5">
                            <TextBlock DockPanel.Dock="Left" Text="As superior (m²)"
                                       Style="{StaticResource EtiquetaParam}"/>
                            <TextBox Text="{Binding AreaAceroTop, StringFormat=0.######, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,5">
                            <TextBlock DockPanel.Dock="Left" Text="As inferior (m²)"
                                       Style="{StaticResource EtiquetaParam}"/>
                            <TextBox Text="{Binding AreaAceroBot, StringFormat=0.######, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                        <CheckBox Margin="0,8,0,0" FontSize="12"
                                  Foreground="{DynamicResource FgSecondary}"
                                  IsChecked="{Binding MomentoPositivo}"
                                  Content="Momento positivo (acero inferior a tracción)"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Columna derecha: diagrama + resultados ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Diagrama de la sección -->
            <Border Grid.Row="0" Style="{StaticResource TarjetaSeccion}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SECCIÓN · DEFORMACIONES · BLOQUE DE WHITNEY"
                               Style="{StaticResource EtiquetaSeccion}" Margin="0,0,0,6"/>
                    <oxy:PlotView Grid.Row="1" Model="{Binding ModeloSeccion}"
                                  Background="Transparent" MinHeight="260"/>
                </Grid>
            </Border>

            <!-- Resultados de capacidad -->
            <Border Grid.Row="1" Style="{StaticResource TarjetaSeccion}">
                <StackPanel>
                    <TextBlock Text="CAPACIDAD A FLEXIÓN" Style="{StaticResource EtiquetaSeccion}"
                               Margin="0,0,0,8"/>
                    <UniformGrid Rows="2" Columns="3">
                        <StackPanel Margin="4">
                            <TextBlock Text="Mn (kN·m)" FontSize="10"
                                       Foreground="{DynamicResource FgMuted}"/>
                            <TextBlock Text="{Binding MomentoNominal, StringFormat=0.0}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgPrimary}"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="φMn (kN·m)" FontSize="10"
                                       Foreground="{DynamicResource FgMuted}"/>
                            <TextBlock Text="{Binding MomentoDiseno, StringFormat=0.0}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="φ" FontSize="10" Foreground="{DynamicResource FgMuted}"/>
                            <TextBlock Text="{Binding FactorPhi, StringFormat=0.000}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgPrimary}"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="c — eje neutro (m)" FontSize="10"
                                       Foreground="{DynamicResource FgMuted}"/>
                            <TextBlock Text="{Binding EjeNeutro, StringFormat=0.0000}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgPrimary}"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="a — bloque (m)" FontSize="10"
                                       Foreground="{DynamicResource FgMuted}"/>
                            <TextBlock Text="{Binding BloqueCompresion, StringFormat=0.0000}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgPrimary}"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="Clasificación" FontSize="10"
                                       Foreground="{DynamicResource FgMuted}"/>
                            <TextBlock Text="{Binding Clasificacion}" FontSize="13"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource FgPrimary}"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Indicadores normativos -->
                    <Border CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Ok}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CumpleCuantiaMinima}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource Err}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Cuantía mínima — ρ ≥ ρ_min" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{DynamicResource FgOnAccent}"/>
                    </Border>
                    <Border CornerRadius="4" Padding="10,6" Margin="0,6,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Ok}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CumpleLimiteDeformacion}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource Err}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Ductilidad — εt ≥ 0.004 (sección no sobre-reforzada frágil)"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgOnAccent}"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Advertencias}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"
                                           Margin="0,2" Foreground="{DynamicResource Warn}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
