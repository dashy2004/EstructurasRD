<Window x:Class="LosasPlus.Views.Rc.RcSectionDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rc="clr-namespace:LosasPlus.Views.Rc"
        Title="Diseño de sección RC"
        Width="1000" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <rc:RcSectionDesignView Grid.Row="0"/>

        <Border Grid.Row="1" Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <Button Content="Cerrar" HorizontalAlignment="Right" Padding="18,5"
                    Cursor="Hand" Click="OnCerrarClick"/>
        </Border>
    </Grid>
</Window>
