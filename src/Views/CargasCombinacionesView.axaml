<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cargas="clr-namespace:LosasPlus.Cargas;assembly=LosasPlus.Core"
             xmlns:models="clr-namespace:LosasPlus.Models;assembly=LosasPlus.Core"
             x:Class="LosasPlus.Views.CargasCombinacionesView"
             x:CompileBindings="False"
             Background="{DynamicResource BgPrimary}"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <ControlTheme x:Key="EtiquetaSeccion" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </ControlTheme>
        <ControlTheme x:Key="BotonCompacto" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </ControlTheme>
        <ControlTheme x:Key="TarjetaSeccion" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </ControlTheme>
        <ControlTheme x:Key="FilaResumen" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,3"/>
        </ControlTheme>
        <ControlTheme x:Key="TabSecundario" TargetType="TabItem"
                      BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="12"/>
        </ControlTheme>
    </UserControl.Resources>

    <Grid DataContext="{Binding CargasCombinaciones}" Margin="16" RowDefinitions="Auto,*">

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Left" Text="📊  Cargas y Combinaciones"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📥  Importar DISEST" Theme="{StaticResource BotonCompacto}"
                        Click="OnImportarClick"
                        ToolTip.Tip="Importar casos y combinaciones desde un archivo DISEST .DZP o .CEZ."/>
                <Button Content="📤  Exportar .DZP" Theme="{StaticResource BotonCompacto}"
                        Click="OnExportarClick" ToolTip.Tip="Exportar la base de cargas a un archivo DISEST .DZP."/>
                <Button Content="⚙  Normalizar" Theme="{StaticResource BotonCompacto}"
                        Click="OnNormalizarClick"
                        ToolTip.Tip="Re-sembrar los casos y combinaciones según la norma seleccionada."/>
                <TextBlock Text="Norma:" Theme="{StaticResource EtiquetaSeccion}" Margin="18,0,8,0"/>
                <ComboBox Width="160" VerticalAlignment="Center"
                          ItemsSource="{Binding Normas}" SelectedItem="{Binding Norma}"
                          ToolTip.Tip="Norma de la que provienen los factores de combinación."/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,12,280">
            <!-- Columna central -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <!-- Casos -->
                <Border Grid.Row="0" Theme="{StaticResource TarjetaSeccion}" Margin="0,0,0,12">
                    <Grid RowDefinitions="Auto,Auto">
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="CASOS DE CARGA" Theme="{StaticResource EtiquetaSeccion}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ Añadir Caso" Theme="{StaticResource BotonCompacto}" Command="{Binding AgregarCasoCommand}"/>
                                <Button Content="🗑 Eliminar Caso" Theme="{StaticResource BotonCompacto}" Command="{Binding EliminarCasoCommand}"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid Grid.Row="1" MaxHeight="200"
                                  ItemsSource="{Binding Casos}" SelectedItem="{Binding CasoSeleccionado}"
                                  AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                                  BeginningEdit="OnBeginningEdit">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Width="90" Binding="{Binding Codigo}"/>
                                <DataGridTextColumn Header="Nombre" Width="*"  Binding="{Binding Nombre}"/>
                                <DataGridTemplateColumn Header="Tipo" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Tipo}" Margin="6,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding $parent[DataGrid].DataContext.TiposCaso}"
                                                      SelectedItem="{Binding Tipo}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="FCE" Width="56" Binding="{Binding Fce}"/>
                                <DataGridCheckBoxColumn Header="FSIS" Width="60" Binding="{Binding Fsis}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Matriz de factores -->
                <Border Grid.Row="1" Theme="{StaticResource TarjetaSeccion}">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="MATRIZ DE FACTORES" Theme="{StaticResource EtiquetaSeccion}" Margin="0,0,0,8"/>
                        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <TabItem Header="Servicio" Theme="{StaticResource TabSecundario}">
                                <Grid Margin="0,8,0,0" RowDefinitions="Auto,*">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                        <Button Content="+ Añadir" Theme="{StaticResource BotonCompacto}"
                                                Command="{Binding AgregarCombinacionCommand}"
                                                CommandParameter="{x:Static cargas:TipoCombinacion.Servicio}"/>
                                        <Button Content="🗑 Quitar" Theme="{StaticResource BotonCompacto}"
                                                Command="{Binding EliminarCombinacionCommand}"
                                                CommandParameter="{Binding #GridMatrizServicio.SelectedItem}"/>
                                    </StackPanel>
                                    <DataGrid x:Name="GridMatrizServicio" Grid.Row="1"
                                              ItemsSource="{Binding CombinacionesServicio}"
                                              AutoGenerateColumns="False" CanUserSortColumns="False"
                                              CanUserReorderColumns="False" FrozenColumnCount="1"
                                              HeadersVisibility="Column" SelectionMode="Single"
                                              BeginningEdit="OnBeginningEdit">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Combinación" Width="*" MinWidth="160" Binding="{Binding Nombre}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Últimas" Theme="{StaticResource TabSecundario}">
                                <Grid Margin="0,8,0,0" RowDefinitions="Auto,*">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                        <Button Content="+ Añadir" Theme="{StaticResource BotonCompacto}"
                                                Command="{Binding AgregarCombinacionCommand}"
                                                CommandParameter="{x:Static cargas:TipoCombinacion.Ultima}"/>
                                        <Button Content="🗑 Quitar" Theme="{StaticResource BotonCompacto}"
                                                Command="{Binding EliminarCombinacionCommand}"
                                                CommandParameter="{Binding #GridMatrizUltimas.SelectedItem}"/>
                                    </StackPanel>
                                    <DataGrid x:Name="GridMatrizUltimas" Grid.Row="1"
                                              ItemsSource="{Binding CombinacionesUltimas}"
                                              AutoGenerateColumns="False" CanUserSortColumns="False"
                                              CanUserReorderColumns="False" FrozenColumnCount="1"
                                              HeadersVisibility="Column" SelectionMode="Single"
                                              BeginningEdit="OnBeginningEdit">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Combinación" Width="*" MinWidth="160" Binding="{Binding Nombre}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- Panel lateral -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0" Theme="{StaticResource TarjetaSeccion}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="RESUMEN" Theme="{StaticResource EtiquetaSeccion}" Margin="0,0,0,8"/>
                        <DockPanel Theme="{StaticResource FilaResumen}">
                            <TextBlock DockPanel.Dock="Left" Text="Casos de carga" FontSize="12" Foreground="{DynamicResource FgSecondary}"/>
                            <TextBlock Text="{Binding CantidadCasos}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}"/>
                        </DockPanel>
                        <DockPanel Theme="{StaticResource FilaResumen}">
                            <TextBlock DockPanel.Dock="Left" Text="Combinaciones de servicio" FontSize="12" Foreground="{DynamicResource FgSecondary}"/>
                            <TextBlock Text="{Binding CantidadServicio}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}"/>
                        </DockPanel>
                        <DockPanel Theme="{StaticResource FilaResumen}">
                            <TextBlock DockPanel.Dock="Left" Text="Combinaciones últimas" FontSize="12" Foreground="{DynamicResource FgSecondary}"/>
                            <TextBlock Text="{Binding CantidadUltimas}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}"/>
                        </DockPanel>
                        <DockPanel Theme="{StaticResource FilaResumen}">
                            <TextBlock DockPanel.Dock="Left" Text="Total de combinaciones" FontSize="12" Foreground="{DynamicResource FgSecondary}"/>
                            <TextBlock Text="{Binding CantidadCombinaciones}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}"/>
                        </DockPanel>
                        <Border Margin="0,10,0,0" Padding="8,6" CornerRadius="4" Background="{DynamicResource BgInput}">
                            <TextBlock Text="{Binding EstadoValidacion}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Theme="{StaticResource TarjetaSeccion}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ALERTAS NORMATIVAS" Theme="{StaticResource EtiquetaSeccion}" Margin="0,0,0,8"/>
                        <TextBlock Text="Sin alertas — la base de cargas es conforme."
                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource FgMuted}"
                                   IsVisible="{Binding !HayAlertas}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                            <ItemsControl ItemsSource="{Binding AlertasNormativas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Grid.Column="0" Text="⚠" Margin="0,0,6,0" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgSecondary}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Theme="{StaticResource TarjetaSeccion}">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="ESTRUCTURA" Theme="{StaticResource EtiquetaSeccion}" Margin="0,0,0,8"/>
                        <TreeView Grid.Row="1" ItemsSource="{Binding Edificios}" Background="Transparent" BorderThickness="0">
                            <TreeView.DataTemplates>
                                <TreeDataTemplate DataType="models:Edificio" ItemsSource="{Binding Niveles}">
                                    <TextBlock Text="{Binding Nombre, StringFormat='🏢  {0}'}" Foreground="{DynamicResource FgPrimary}" FontSize="12"/>
                                </TreeDataTemplate>
                                <TreeDataTemplate DataType="models:Nivel" ItemsSource="{Binding Sistemas}">
                                    <TextBlock Text="{Binding Nombre, StringFormat='▦  {0}'}" Foreground="{DynamicResource FgSecondary}" FontSize="12"/>
                                </TreeDataTemplate>
                                <DataTemplate DataType="models:Sistema">
                                    <TextBlock Text="{Binding Nombre, StringFormat='▢  {0}'}" Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                </DataTemplate>
                            </TreeView.DataTemplates>
                        </TreeView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
