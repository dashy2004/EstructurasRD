<UserControl x:Class="LosasPlus.Views.CargasCombinacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <Style x:Key="EtiquetaSeccion" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BotonCompacto" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <!-- El contenido se rebasa al sub-VM CargasCombinaciones del MainViewModel. -->
    <Grid DataContext="{Binding CargasCombinaciones}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera: título + selector de norma -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Left" Text="📊  Cargas y Combinaciones"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📥  Importar .DZP/.CEZ" Style="{StaticResource BotonCompacto}"
                        Margin="0,0,14,0" Click="OnImportarClick"
                        ToolTip="Importar casos y combinaciones desde un archivo DISEST .DZP o .CEZ."/>
                <TextBlock Text="Norma:" Style="{StaticResource EtiquetaSeccion}" Margin="0,0,8,0"/>
                <ComboBox Width="170" VerticalAlignment="Center"
                          ItemsSource="{Binding Normas}"
                          SelectedItem="{Binding Norma}"
                          ToolTip="Norma de la que provienen los factores de combinación."/>
            </StackPanel>
        </DockPanel>

        <!-- Sección: casos de carga -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="CASOS DE CARGA"
                               Style="{StaticResource EtiquetaSeccion}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ Añadir Caso" Style="{StaticResource BotonCompacto}"
                                Command="{Binding AgregarCasoCommand}"/>
                        <Button Content="🗑 Eliminar Caso" Style="{StaticResource BotonCompacto}"
                                Command="{Binding EliminarCasoCommand}"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid Grid.Row="1" MaxHeight="220"
                          ItemsSource="{Binding Casos}"
                          SelectedItem="{Binding CasoSeleccionado}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                          BeginningEdit="OnBeginningEdit">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Width="130" Binding="{Binding Codigo}"/>
                        <DataGridTextColumn Header="Nombre" Width="*"  Binding="{Binding Nombre}"/>
                        <DataGridTemplateColumn Header="Tipo" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Tipo}" Margin="6,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.TiposCaso, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding Tipo}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Sección: combinaciones (master-detail) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Maestro: lista de combinaciones -->
            <Border Grid.Column="0" Padding="12"
                    Background="{DynamicResource BgSecondary}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="COMBINACIONES"
                                   Style="{StaticResource EtiquetaSeccion}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Añadir" Style="{StaticResource BotonCompacto}"
                                    Command="{Binding AgregarCombinacionCommand}"/>
                            <Button Content="🗑 Eliminar" Style="{StaticResource BotonCompacto}"
                                    Command="{Binding EliminarCombinacionCommand}"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Combinaciones}"
                              SelectedItem="{Binding CombinacionSeleccionada}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                              BeginningEdit="OnBeginningEdit">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Width="*" Binding="{Binding Nombre}"/>
                            <DataGridTemplateColumn Header="Tipo" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tipo}" Margin="6,0" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.TiposCombinacion, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding Tipo}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Detalle: términos de la combinación seleccionada -->
            <Border Grid.Column="2" Padding="12"
                    Background="{DynamicResource BgSecondary}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="TÉRMINOS DE LA COMBINACIÓN"
                                   Style="{StaticResource EtiquetaSeccion}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Añadir Término" Style="{StaticResource BotonCompacto}"
                                    Command="{Binding AgregarTerminoCommand}"/>
                            <Button Content="🗑 Eliminar" Style="{StaticResource BotonCompacto}"
                                    Command="{Binding EliminarTerminoCommand}"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CombinacionSeleccionada.Terminos}"
                              SelectedItem="{Binding TerminoSeleccionado}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                              BeginningEdit="OnBeginningEdit">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Caso" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CodigoCaso}" Margin="6,0" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Casos, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  DisplayMemberPath="Codigo" SelectedValuePath="Codigo"
                                                  SelectedValue="{Binding CodigoCaso}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Factor" Width="110"
                                                Binding="{Binding Factor, StringFormat=0.00}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
