<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:LosasPlus.Views"

             x:Class="LosasPlus.Views.Planta2DEditorView"
             x:CompileBindings="False"
             Background="{DynamicResource BgPrimary}">

    <UserControl.Resources>
        <!-- Paleta de muros (UI1.4) — desde UI1.6 vive en Views/. -->
        <v:EspesorABrushConverter x:Key="EspesorABrush"/>
        <v:CountToBoolConverter x:Key="CountToBool"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Barra superior: Nivel, Herramientas, Acciones -->
        <Border DockPanel.Dock="Top" Padding="12,8"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Snapping controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <CheckBox x:Name="ChkSnap" Content="Snap (S)" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip.Tip="Activa o desactiva el auto-ajuste (snapping) a rejilla y objetos."/>
                    
                    <TextBlock Text="Paso:" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource FgSecondary}"/>
                    <ComboBox x:Name="CbGridStep" SelectedIndex="2" VerticalAlignment="Center" Width="85">
                        <ComboBoxItem Content="0.1 m"/>
                        <ComboBoxItem Content="0.2 m"/>
                        <ComboBoxItem Content="0.5 m"/>
                        <ComboBoxItem Content="1.0 m"/>
                        <ComboBoxItem Content="Libre"/>
                    </ComboBox>
                </StackPanel>

                <!-- Barra de Herramientas / Modos. WrapPanel: en resoluciones
                     chicas los botones bajan a una segunda fila en vez de
                     desbordarse fuera de la ventana. -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <RadioButton x:Name="BtnPuntero" Content="↖ Puntero" IsChecked="True"
                                 Classes="tool-button" GroupName="FloorTool" ToolTip.Tip="Seleccionar y arrastrar elementos en planta."/>
                    <RadioButton x:Name="BtnAddLosa" Content="▭ + Losa"
                                 Classes="tool-button" GroupName="FloorTool" ToolTip.Tip="Hacer click en el lienzo para colocar una nueva losa."/>
                    <RadioButton x:Name="BtnAddViga" Content="📐 + Viga"
                                 Classes="tool-button" GroupName="FloorTool" ToolTip.Tip="Hacer click en el lienzo para colocar una nueva viga."/>
                    <RadioButton x:Name="BtnAddCol" Content="🏛 + Columna"
                                 Classes="tool-button" GroupName="FloorTool" ToolTip.Tip="Hacer click en el lienzo para colocar una nueva columna."/>
                    <RadioButton x:Name="BtnAddEje" Content="📏 + Eje"
                                 Classes="tool-button" GroupName="FloorTool" ToolTip.Tip="Hacer click en el lienzo para colocar un nuevo eje estructural."/>
                    <RadioButton x:Name="BtnAddMuro" Content="🧱 + Muro"
                                 Classes="tool-button" GroupName="FloorTool" ToolTip.Tip="Hacer click en el lienzo para colocar un nuevo muro."/>
                    <RadioButton x:Name="BtnCalibrarPdf" Content="🎯 Calibrar PDF"
                                 Classes="tool-button" GroupName="FloorTool"
                                 ToolTip.Tip="Dos puntos sobre el PDF + distancia real para corregir su escala. Shift = línea ortogonal · Esc cancela."/>
                    <RadioButton x:Name="BtnMapearLosa" Content="▱ Calcar losa"
                                 Classes="tool-button" GroupName="FloorTool"
                                 ToolTip.Tip="Click sobre un contorno rectangular cerrado del DXF para crear la losa ahí (anclada)."/>
                </WrapPanel>

                <!-- Acciones globales -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="q adm (t/m²):" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource FgSecondary}"/>
                    <TextBox x:Name="TxtQAdm" Text="15.0" Width="50" VerticalAlignment="Center"/>
                    <Button Content="📂 DXF" Command="{Binding CadEditor.ImportarDxfCommand}"
                            ToolTip.Tip="Importar plano DXF como referencia (underlay) para calcar la estructura."/>
                    <Button Content="📑 PDF" Command="{Binding CadEditor.ImportarPdfCommand}"
                            ToolTip.Tip="Importar plano PDF como referencia (underlay)."/>
                    <Button Content="🤖 Auto-Conectar" Command="{Binding CadEditor.AutoAlinearSistemasCommand}"
                            ToolTip.Tip="Alinea losas vecinas y genera los bordes de continuidad."/>
                    <Button x:Name="BtnRecalcular" Content="⚡ Recalcular Descenso" Classes="accent"
                            ToolTip.Tip="Calcula el descenso topológico real losa->viga->columna->zapata en este nivel."/>
                    <Button x:Name="BtnEliminar" Content="🗑 Eliminar" Background="#D32F2F" Foreground="White"
                            ToolTip.Tip="Elimina el elemento seleccionado."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra inferior: Ayuda y Estado -->
        <Border DockPanel.Dock="Bottom" Padding="12,4"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Foreground="{DynamicResource FgMuted}" FontSize="12"
                           Text="Rueda = zoom · Arr. Botón Central/Derecho = pan · Click = seleccionar · Arr. Izquierdo = mover."/>
                <TextBlock Grid.Column="1" Foreground="{DynamicResource FgMuted}" FontSize="12" FontWeight="SemiBold"
                           Text="Editor 2D de Planta"/>
            </Grid>
        </Border>

        <!-- Área de Trabajo: Canvas + Panel de Propiedades -->
        <Grid ColumnDefinitions="*,300">
            <!-- Canvas Editor -->
            <Border Grid.Column="0" Background="{DynamicResource BgInput}" ClipToBounds="True" Focusable="True">
                <Grid>
                    <v:PlantaCanvas x:Name="EditorCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Nivel="{Binding NivelActivo}" Edificio="{Binding EdificioActivo}"
                                    PdfRef="{Binding CadEditor.Pdf}" FondoPdf="{Binding CadEditor.FondoPdf}"
                                    OpacidadPdf="{Binding CadEditor.OpacidadPdf}"
                                    PlanoDxf="{Binding CadEditor.Plano}"
                                    RevisionPlano="{Binding CadEditor.RevisionPlano}"
                                    RevisionPdf="{Binding CadEditor.RevisionPdf}"
                                    EspesorMuroNuevo="{Binding CadEditor.EspesorMuroNuevo}"
                                    AlturaMuroNueva="{Binding CadEditor.AlturaMuroNueva}"/>

                    <!-- Editor flotante de calibración del PDF (UI1.2): aparece al
                         fijar el segundo punto. Enter aplica, Esc cancela. -->
                    <Border x:Name="PanelCalibrarPdf" IsVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                            Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCalLinea" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="TxtCalDistReal" Width="90" VerticalAlignment="Center"/>
                            <TextBlock Text="m" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource FgMuted}"/>
                            <Button x:Name="BtnCalAceptar" Content="Aplicar" Classes="accent"/>
                            <Button x:Name="BtnCalCancelar" Content="Cancelar"/>
                        </StackPanel>
                    </Border>

                    <!-- Leyenda «Suma de Colores» (UI1.4): fija abajo-izquierda;
                         visible sólo con muros. Mismo desglose que el lienzo CAD —
                         el SSOT de muros es compartido (CadEditor.ResumenMuros). -->
                    <Border ZIndex="50" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="12" Padding="12,10" MaxHeight="300" MaxWidth="240"
                            Background="{DynamicResource BgSecondary}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="7"
                            IsVisible="{Binding CadEditor.ResumenMuros.Count, Converter={StaticResource CountToBool}}">
                        <StackPanel>
                            <TextBlock Text="🧱  SUMA DE COLORES" FontWeight="Bold" FontSize="10"
                                       Foreground="{DynamicResource FgMuted}" Margin="0,0,0,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                                <ItemsControl ItemsSource="{Binding CadEditor.ResumenMuros}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <Border DockPanel.Dock="Left" Width="14" Height="14"
                                                        CornerRadius="3" Margin="0,1,8,0"
                                                        VerticalAlignment="Top"
                                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                        Background="{Binding Espesor, Converter={StaticResource EspesorABrush}}"/>
                                                <StackPanel>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgPrimary}"
                                                               Text="{Binding EtiquetaLosa, Mode=OneWay}"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource FgSecondary}">
                                                        <Run Text="e "/><Run Text="{Binding Espesor, StringFormat=0.00, Mode=OneWay}"/><Run Text=" m  ·  "/>
                                                        <Run Text="{Binding LongitudTotal, StringFormat=0.00, Mode=OneWay}"/><Run Text=" m  ·  ×"/><Run Text="{Binding Cantidad, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Panel de Propiedades Lateral -->
            <Border Grid.Column="1" Padding="16" Background="{DynamicResource BgSecondary}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="PROPIEDADES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FgMuted}"/>

                        <TextBlock x:Name="TxtNoSelection" Text="Ningún elemento seleccionado. Haga click en una losa, viga o columna para editar."
                                   Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap" FontStyle="Italic"/>

                        <!-- Panel Losa -->
                        <StackPanel x:Name="PanelLosa" Spacing="12" IsVisible="False">
                            <TextBlock Text="◆ Losa" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtLosaId" IsReadOnly="True" Background="{DynamicResource BgTertiary}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Coord X (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtLosaX" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Coord Y (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtLosaY" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Lx (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtLosaLx" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ly (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtLosaLy" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Carga Wu:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtLosaCarga" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Espesor:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtLosaEspesor" Margin="0,0,0,8"/>
                            </Grid>
                        </StackPanel>

                        <!-- Panel Viga -->
                        <StackPanel x:Name="PanelViga" Spacing="12" IsVisible="False">
                            <TextBlock Text="◆ Viga" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtVigaId" IsReadOnly="True" Background="{DynamicResource BgTertiary}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Nombre:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtVigaNombre" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Origen X (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtVigaX" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Origen Y (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtVigaY" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ángulo (°):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtVigaAngulo" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Largo (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtVigaLargo" IsReadOnly="True" Background="{DynamicResource BgTertiary}" Margin="0,0,0,8"/>
                            </Grid>
                        </StackPanel>

                        <!-- Panel Columna -->
                        <StackPanel x:Name="PanelColumna" Spacing="12" IsVisible="False">
                            <TextBlock Text="◆ Columna" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtColId" IsReadOnly="True" Background="{DynamicResource BgTertiary}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Nombre:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtColNombre" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Coord X (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtColX" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Coord Y (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtColY" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Base (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtColBase" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Peralte (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtColPeralte" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Altura (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtColAltura" Margin="0,0,0,8"/>
                            </Grid>
                        </StackPanel>

                        <!-- Panel Eje -->
                        <StackPanel x:Name="PanelEje" Spacing="12" IsVisible="False">
                            <TextBlock Text="📏 Eje Estructural" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Etiqueta:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtEjeEtiqueta" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Inicio X (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtEjeStartX" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Inicio Y (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtEjeStartY" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Fin X (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtEjeEndX" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Fin Y (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtEjeEndY" Margin="0,0,0,8"/>
                            </Grid>
                            
                            <Button x:Name="BtnVerElevacion" Content="Ver Elevación 3D" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                            <Button x:Name="BtnGenerarVigaContinua" Content="Generar Viga Continua" Classes="accent" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Panel Muro -->
                        <StackPanel x:Name="PanelMuro" Spacing="12" IsVisible="False">
                            <TextBlock Text="🧱 Muro" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtMuroId" IsReadOnly="True" Background="{DynamicResource BgTertiary}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Inicio X (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtMuroStartX" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Inicio Y (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtMuroStartY" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Fin X (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtMuroEndX" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Fin Y (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtMuroEndY" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Espesor (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtMuroEspesor" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Altura (m):" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtMuroAltura" Margin="0,0,0,8"/>
                            </Grid>
                        </StackPanel>

                        <!-- Panel PLANO / PDF (UI1.6): portado del panel lateral del
                             lienzo CAD retirado. Mismos bindings CadEditor.*;
                             el lienzo refresca vía RevisionPlano/Pdf. -->
                        <Expander Header="📐 PLANO / PDF" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">
                                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="PLANO IMPORTADO"
                                               FontWeight="Bold" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource FgMuted}"/>
                                    <Button DockPanel.Dock="Right" Content="🗑" Padding="4,0" FontSize="12"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource FgMuted}"
                                            Command="{Binding CadEditor.EliminarDxfCommand}"
                                            ToolTip.Tip="Quitar el plano DXF (no afecta las losas)."/>
                                </DockPanel>
                                <TextBlock Text="{Binding CadEditor.Plano.NombreArchivo, FallbackValue=(sin plano DXF), TargetNullValue=(sin plano DXF)}"
                                           FontFamily="JetBrains Mono, Consolas" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource FgPrimary}"/>
                                <TextBlock FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource FgMuted}">
                                    <Run Text="{Binding CadEditor.Plano.Ancho, StringFormat=0.0, FallbackValue=0, Mode=OneWay}"/>
                                    <Run Text=" × "/>
                                    <Run Text="{Binding CadEditor.Plano.Alto, StringFormat=0.0, FallbackValue=0, Mode=OneWay}"/>
                                    <Run Text=" m  ·  "/>
                                    <Run Text="{Binding CadEditor.Plano.CantidadEntidades, FallbackValue=0, Mode=OneWay}"/>
                                    <Run Text=" entidades"/>
                                </TextBlock>
                                <Border Height="1" Margin="0,12" Background="{DynamicResource Border}"/>
                                <StackPanel IsEnabled="{Binding CadEditor.TienePlano}">
                                    <TextBlock Text="AJUSTE ESPACIAL" FontWeight="Bold" FontSize="10"
                                               Foreground="{DynamicResource FgMuted}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Escala" FontSize="11" Foreground="{DynamicResource FgSecondary}"/>
                                    <TextBox Margin="0,2,0,8" Text="{Binding CadEditor.EscalaPlano}"/>
                                    <TextBlock Text="Offset X (m)" FontSize="11" Foreground="{DynamicResource FgSecondary}"/>
                                    <TextBox Margin="0,2,0,8" Text="{Binding CadEditor.OffsetXPlano}"/>
                                    <TextBlock Text="Offset Y (m)" FontSize="11" Foreground="{DynamicResource FgSecondary}"/>
                                    <TextBox Margin="0,2,0,12" Text="{Binding CadEditor.OffsetYPlano}"/>
                                </StackPanel>
                                <Border Height="1" Margin="0,12" Background="{DynamicResource Border}"/>
                                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="PDF IMPORTADO"
                                               FontWeight="Bold" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource FgMuted}"/>
                                    <Button DockPanel.Dock="Right" Content="🗑" Padding="4,0" FontSize="12"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource FgMuted}"
                                            Command="{Binding CadEditor.EliminarPdfCommand}"
                                            ToolTip.Tip="Quitar el PDF underlay del lienzo."/>
                                </DockPanel>
                                <TextBlock Text="{Binding CadEditor.Pdf.NombreArchivo, FallbackValue=(sin PDF), TargetNullValue=(sin PDF)}"
                                           FontFamily="JetBrains Mono, Consolas" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource FgPrimary}"/>
                                <TextBlock FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource FgMuted}">
                                    <Run Text="{Binding CadEditor.Pdf.Ancho, StringFormat=0.00, FallbackValue=0, Mode=OneWay}"/>
                                    <Run Text=" × "/>
                                    <Run Text="{Binding CadEditor.Pdf.Alto, StringFormat=0.00, FallbackValue=0, Mode=OneWay}"/>
                                    <Run Text=" m  ·  primera página"/>
                                </TextBlock>
                                <Border Height="1" Margin="0,12" Background="{DynamicResource Border}"/>
                                <StackPanel IsEnabled="{Binding CadEditor.TienePdf}">
                                    <TextBlock Text="AJUSTE ESPACIAL PDF" FontWeight="Bold" FontSize="10"
                                               Foreground="{DynamicResource FgMuted}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Escala" FontSize="11" Foreground="{DynamicResource FgSecondary}"/>
                                    <TextBox Margin="0,2,0,8" Text="{Binding CadEditor.EscalaPdf}"/>
                                    <TextBlock Text="Offset X (m)" FontSize="11" Foreground="{DynamicResource FgSecondary}"/>
                                    <TextBox Margin="0,2,0,8" Text="{Binding CadEditor.OffsetXPdf}"/>
                                    <TextBlock Text="Offset Y (m)" FontSize="11" Foreground="{DynamicResource FgSecondary}"/>
                                    <TextBox Margin="0,2,0,8" Text="{Binding CadEditor.OffsetYPdf}"/>
                                    <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource FgSecondary}">
                                        <Run Text="Opacidad: "/>
                                        <Run Text="{Binding CadEditor.OpacidadPdf, StringFormat='{}{0:P0}', Mode=OneWay}"/>
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                            Value="{Binding CadEditor.OpacidadPdf, Mode=TwoWay}"
                                            TickFrequency="0.1" Margin="0,2,0,8"
                                            ToolTip.Tip="Atenúa el PDF de fondo (0% transparente · 100% opaco)."/>
                                    <CheckBox Content="🌙  Modo Oscuro (Fondo Negro)"
                                              IsChecked="{Binding CadEditor.InvertirColorPdf, Mode=TwoWay}"
                                              Foreground="{DynamicResource FgSecondary}"
                                              Margin="0,4,0,4"
                                              ToolTip.Tip="Invierte los canales del PDF para reducir la fatiga visual."/>
                                </StackPanel>
                                <Border Height="1" Margin="0,12" Background="{DynamicResource Border}"/>
                                <TextBlock Text="🧱  MUROS" FontWeight="Bold" FontSize="10"
                                           Foreground="{DynamicResource FgMuted}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6" ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Espesor (m)" FontSize="11"
                                               Foreground="{DynamicResource FgSecondary}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Altura (m)" FontSize="11"
                                               Foreground="{DynamicResource FgSecondary}"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" Margin="0,2,0,0"
                                             Text="{Binding CadEditor.EspesorMuroNuevo}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Margin="0,2,0,0"
                                             Text="{Binding CadEditor.AlturaMuroNueva}"/>
                                </Grid>
                                <TextBlock FontSize="10" Foreground="{DynamicResource FgMuted}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Valores de los muros nuevos («🧱 + Muro» en la toolbar)."/>
                                <ListBox MaxHeight="150" Margin="0,0,0,8"
                                         Background="{DynamicResource BgInput}"
                                         BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                         ItemsSource="{Binding Sistema.Muros}"
                                         SelectedItem="{Binding CadEditor.MuroSeleccionado, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="11" Height="11"
                                                        CornerRadius="2" Margin="0,0,7,0" VerticalAlignment="Center"
                                                        Background="{Binding Espesor, Converter={StaticResource EspesorABrush}}"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource FgPrimary}">
                                                    <Run Text="Muro "/><Run Text="{Binding Id, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Longitud, StringFormat=0.00, Mode=OneWay}"/><Run Text=" m"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel IsEnabled="{Binding CadEditor.MuroSeleccionado, Converter={StaticResource NullToCollapsed}}">
                                    <Button Content="🗑  Eliminar muro" Padding="10,6"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding CadEditor.EliminarMuroCommand}"
                                            ToolTip.Tip="Quita el muro seleccionado del sistema (Ctrl+Z lo revierte)."/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>

    <!-- Estilos específicos para botones de herramientas compactos -->
    <UserControl.Styles>
        <Style Selector="RadioButton.tool-button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="bd" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tool-button:checked /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="RadioButton.tool-button:checked">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="RadioButton.tool-button:pointerover:unchecked /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
        </Style>
    </UserControl.Styles>
</UserControl>
