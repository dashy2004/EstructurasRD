<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LosasPlus.Views.ReglamentoView"
             x:CompileBindings="False"
             Background="{DynamicResource BgPrimary}">
    <Grid Margin="6" ColumnDefinitions="320,*" RowDefinitions="Auto,Auto,*">

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Reglamentos · referencias normativas"
                   FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>

        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Padding="10,6" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Carpeta PDFs:" VerticalAlignment="Center"
                           Margin="0,0,8,0" Foreground="{DynamicResource FgMuted}"/>
                <Button DockPanel.Dock="Right" Content="Examinar..." Width="100" Margin="6,0,0,0"
                        Click="OnBrowseCarpeta"/>
                <Button DockPanel.Dock="Right" Content="Guardar" Width="80" Margin="6,0,0,0"
                        Click="OnSaveCarpeta" Theme="{StaticResource PrimaryButton}"/>
                <TextBox x:Name="CarpetaBox" VerticalAlignment="Center"
                         FontFamily="JetBrains Mono, Consolas" FontSize="11"/>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="2" Grid.Column="0" x:Name="NormasList"
                 ItemsSource="{Binding Normas}"
                 SelectionChanged="OnSelectionChanged"
                 Background="{DynamicResource BgInput}"
                 Foreground="{DynamicResource FgPrimary}"
                 BorderBrush="{DynamicResource Border}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Codigo}" FontWeight="Bold"/>
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Text="{Binding Ambito}" FontSize="10"
                                       Foreground="{DynamicResource Accent}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource FgMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Row="2" Grid.Column="1" Margin="6,0,0,0">
            <StackPanel x:Name="DetalleHost" Margin="6"/>
        </ScrollViewer>
    </Grid>
</UserControl>
