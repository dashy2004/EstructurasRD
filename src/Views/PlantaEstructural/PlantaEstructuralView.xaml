<UserControl x:Class="LosasPlus.Views.PlantaEstructural.PlantaEstructuralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:planta="clr-namespace:LosasPlus.Views.PlantaEstructural"
             xmlns:conv="clr-namespace:LosasPlus.Converters"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean"/>
    </UserControl.Resources>
    <!--
        Vista de planta estructural 2D (Liga C paso C1). DataContext:
        MainViewModel. La toolbar superior expone el selector de nivel
        (combobox bindeado a PlantaEstructural.NivelActivo). El canvas
        debajo recibe los bindings necesarios para renderizar grilla +
        columnas + vigas + zapatas del nivel seleccionado.

        En esta primera iteración el canvas es READ-ONLY: solo permite
        zoom (rueda) + pan (rueda media o Ctrl+arrastre) + click-select
        (sincroniza con el panel "Elemento Activo" del shell).
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Toolbar superior ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="📐  Planta Estructural"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Nivel:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                <ComboBox Width="180" Height="26" VerticalAlignment="Center"
                          ItemsSource="{Binding PlantaEstructural.NivelesDisponibles}"
                          SelectedItem="{Binding PlantaEstructural.NivelActivo}"
                          DisplayMemberPath="Nombre"/>
                <TextBlock Text="  ·  Zoom rueda, pan rueda media (o Ctrl+arrastre), click sobre elemento para seleccionar"
                           VerticalAlignment="Center" FontSize="10" FontStyle="Italic"
                           Foreground="{DynamicResource FgMuted}" Margin="12,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== Canvas 2D ===== -->
        <Grid Grid.Row="1">
            <Border Background="#FF1A1A1A"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <planta:PlantaEstructuralCanvas x:Name="Canvas"
                    Proyecto="{Binding PlantaEstructural.Proyecto}"
                    NivelActivo="{Binding PlantaEstructural.NivelActivo}"
                    GrillaActiva="{Binding PlantaEstructural.GrillaActiva}"
                    SistemaActivo="{Binding PlantaEstructural.SistemaActivo}"
                    Revision="{Binding PlantaEstructural.Revision}"
                    Seleccion="{Binding PlantaEstructural.Seleccion}"
                    HerramientaActiva="{Binding PlantaEstructural.HerramientaActiva, Mode=TwoWay}"/>
            </Border>

            <!-- Toolbar flotante de herramientas (Liga C paso C2) — mismo
                 patrón que el viewport 3D B3. RadioButtons bindean a
                 PlantaEstructural.HerramientaActiva vía EnumToBooleanConverter.
                 Snap a grilla está activo por default; Shift mientras
                 arrastra/crea desactiva el snap temporalmente. -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,16,0" Padding="8"
                    Background="#E62A2A2A" CornerRadius="8" Panel.ZIndex="10">
                <StackPanel Orientation="Vertical" MinWidth="180">
                    <TextBlock Text="HERRAMIENTAS PLANTA"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#FFCCCCCC" Margin="0,0,0,6"/>
                    <RadioButton GroupName="HerramientasPlanta"
                                 Content="🔍  Selección / Mover"
                                 Foreground="#FFEEEEEE" Margin="0,0,0,4"
                                 ToolTip="Click selecciona. Arrastrar una columna/zapata mueve su posición en planta. Snap a grilla activo por defecto (mantén Shift para libre)."
                                 IsChecked="{Binding PlantaEstructural.HerramientaActiva,
                                     Converter={StaticResource EnumToBoolean},
                                     ConverterParameter=Seleccion}"/>
                    <RadioButton GroupName="HerramientasPlanta"
                                 Content="🟨  Crear Columna"
                                 Foreground="#FFEEEEEE" Margin="0,0,0,4"
                                 ToolTip="1 click crea una columna en el nivel activo. Snap a la intersección de grilla más cercana."
                                 IsChecked="{Binding PlantaEstructural.HerramientaActiva,
                                     Converter={StaticResource EnumToBoolean},
                                     ConverterParameter=CrearColumna}"/>
                    <RadioButton GroupName="HerramientasPlanta"
                                 Content="🟧  Crear Viga"
                                 Foreground="#FFEEEEEE" Margin="0,0,0,4"
                                 ToolTip="2 clicks (inicio + fin). Snap a grilla en ambos endpoints."
                                 IsChecked="{Binding PlantaEstructural.HerramientaActiva,
                                     Converter={StaticResource EnumToBoolean},
                                     ConverterParameter=CrearViga}"/>
                    <RadioButton GroupName="HerramientasPlanta"
                                 Content="🗑  Borrar elemento"
                                 Foreground="#FFEEEEEE" Margin="0,0,0,4"
                                 ToolTip="Click sobre columna/viga/zapata para eliminarla. Muros y losas blindados."
                                 IsChecked="{Binding PlantaEstructural.HerramientaActiva,
                                     Converter={StaticResource EnumToBoolean},
                                     ConverterParameter=BorrarElemento}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
