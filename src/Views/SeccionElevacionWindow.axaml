<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:LosasPlus.Views"
        x:Class="LosasPlus.Views.SeccionElevacionWindow"
        Title="Elevación por Eje"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TxtTitulo" Text="Elevación del Eje" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}"/>
        </Border>
        <Border Background="{DynamicResource BgInput}" ClipToBounds="True">
            <v:SeccionElevacionCanvas x:Name="CanvasElevacion" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>
    </DockPanel>
</Window>
