<UserControl x:Class="LosasPlus.Views.Viewport3D.Viewport3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             xmlns:conv="clr-namespace:LosasPlus.Converters"
             Background="{DynamicResource BgPrimary}">
    <UserControl.Resources>
        <Style x:Key="EtiquetaSeccion" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Conversor para bindear RadioButton.IsChecked al enum
             HerramientaActiva (Módulo 2C Fase 3D-II). -->
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean"/>
    </UserControl.Resources>

    <!-- DataContext del sub-VM Viewport3D: lo establece MainWindow al pegar el View. -->
    <Grid DataContext="{Binding Viewport3D}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Toolbar superior ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="🧊  Vista 3D — Escena Estructural"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Progress indeterminado mientras el motor regenera la escena. -->
                <ProgressBar Width="120" Height="6" IsIndeterminate="True"
                             Margin="0,0,12,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Accent}"
                             Background="{DynamicResource BgInput}"
                             BorderThickness="0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CargandoEscena}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Text="Elementos:" Style="{StaticResource EtiquetaSeccion}" Margin="0,0,4,0"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                           FontFamily="JetBrains Mono, Consolas" FontSize="11"
                           Foreground="{DynamicResource FgPrimary}"
                           Text="{Binding ItemsEscena3D.Count, FallbackValue=0}"/>

                <TextBlock Text="(viewport read-only — selección y edición desde paneles 2D)"
                           VerticalAlignment="Center" FontSize="10"
                           FontStyle="Italic"
                           Foreground="{DynamicResource FgMuted}"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== Lienzo 3D (HelixToolkit.Wpf.SharpDX 3.1.2) =====
             El Grid Row 1 contiene el Border (viewport) + un Border
             flotante con la toolbar de creación interactiva (Módulo 2C
             Fase 3D-II) — Panel.ZIndex=10 lo coloca encima del viewport. -->
        <Grid Grid.Row="1">
        <Border
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="6">
            <!--
                Configuración crítica (Plan Maestro Fase 3D-I1):

                - EffectsManager: instancia gestionada por el VM (IDisposable
                  en Viewport3DViewModel libera los recursos DirectX al cerrar).
                - Camera: PerspectiveCamera del VM (también disposable).
                - ItemsSource: ObservableElement3DCollection del VM, alimentada
                  por SyncEscenaService en el hilo UI vía Dispatcher.Invoke.
                - EnableSwapChainRendering=true: máxima tasa de refresco.
                  Documentado por mantenedores: óptimo "if there is no WPF
                  overlapping controls over viewport". Aquí no superponemos
                  controles 2D sobre el viewport — el toolbar vive en Row 0.
                - BackgroundColor=#FF1E1E1E: acopla con el tema oscuro
                  corporativo (BgPrimary del Design System).
                - ShowCoordinateSystem / ShowViewCube: ayudas visuales para
                  orientación espacial del ingeniero.
                - EnableD2DRendering=False: sin overlay 2D dentro del viewport;
                  reduce coste CPU.
                - AutoUpdateOctree=True: aceleración de hit-testing geométrico
                  (lo usaremos en Fase 3D-I3 para selección).
            -->
            <hx:Viewport3DX x:Name="Viewport"
                            EffectsManager="{Binding EffectsManager}"
                            Camera="{Binding Camera}"
                            EnableSwapChainRendering="False"
                            EnableD2DRendering="False"
                            BackgroundColor="#FF1E1E1E"
                            ShowCoordinateSystem="True"
                            ShowViewCube="True"
                            CameraMode="Inspect"
                            ZoomExtentsWhenLoaded="True"
                            MouseDown3D="OnViewportMouseDown3D"
                            MouseMove3D="OnViewportMouseMove3D">
                <!-- Iluminación de la escena (Fase 3D-I4 Parte C). Combina
                     dos luces clásicas Phong:
                     · AmbientLight3D #FF2D2D2D — gris oscuro continuo que
                       evita que las caras opuestas a la direccional caigan
                       en negro absoluto (preserva legibilidad de volumen).
                     · DirectionalLight3D blanca con dirección oblicua
                       descendente (-1, -1, -2) — modela las sombras propias
                       de las aristas de columnas, vigas, zapatas y muros
                       extruidos, dándole al concreto un aspecto sólido y
                       diferenciable contra el fondo oscuro corporativo. -->
                <hx:AmbientLight3D Color="#FF2D2D2D"/>
                <hx:DirectionalLight3D Color="#FFFFFFFF" Direction="-1,-1,-2"/>

                <!-- Viewport3DX no expone ItemsSource directo: se envuelve la
                     colección reactiva en un GroupModel3D que sí lo expone.
                     Patrón documentado por los mantenedores de HelixToolkit. -->
                <hx:GroupModel3D ItemsSource="{Binding ItemsEscena3D}"/>

                <!-- Cursor guía 3D (Módulo 2 Parte B Fase 3D-II): cubo oro
                     0.25 m de lado que el code-behind mueve vía Transform
                     en cada MouseMove3D cuando HerramientaActiva != Selección.
                     Inicialmente Hidden + sin Geometry; la primera vez que
                     el handler lo necesita lo inicializa perezosamente
                     (geometría + material). -->
                <hx:MeshGeometryModel3D x:Name="CursorGuia3D" Visibility="Hidden"/>

                <!-- Preview line para flow de 2 clicks en CrearViga (Liga B
                     paso B3): tras el primer click, el handler MouseMove3D
                     actualiza esta línea con un segmento desde P1 hasta el
                     cursor (snap-magnetizado). Naranja saturado coherente
                     con el banner de modo autoría. Hidden hasta que haya
                     primer click memorizado. -->
                <hx:LineGeometryModel3D x:Name="VigaPreviewLine"
                                        Color="#FFE67E22"
                                        Thickness="2"
                                        Visibility="Hidden"/>
            </hx:Viewport3DX>
        </Border>

        <!-- ===== Toolbar flotante de herramientas (Módulo 2C → Liga B B3) =====
             Posicionada en la esquina superior-derecha del viewport. Los 4
             RadioButtons bindean a MainViewModel.HerramientaAutoria3D vía
             RelativeSource AncestorType=Window — DIRECTIVA 3 de B3: la
             toolbar nunca toca el Viewport3D directamente, todo cambio de
             estado pasa por el MainViewModel. -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,16,16,0" Padding="8"
                Background="#E62A2A2A" CornerRadius="8" Panel.ZIndex="10">
            <StackPanel Orientation="Vertical" MinWidth="180">
                <TextBlock Text="HERRAMIENTAS 3D"
                           FontSize="10" FontWeight="Bold"
                           Foreground="#FFCCCCCC" Margin="0,0,0,6"/>
                <RadioButton GroupName="Herramientas3D"
                             Content="🔍  Selección"
                             Foreground="#FFEEEEEE" Margin="0,0,0,4"
                             IsChecked="{Binding DataContext.HerramientaAutoria3D,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToBoolean},
                                 ConverterParameter=Seleccion}"/>
                <RadioButton GroupName="Herramientas3D"
                             Content="🟨  Crear Columna"
                             Foreground="#FFEEEEEE" Margin="0,0,0,4"
                             IsChecked="{Binding DataContext.HerramientaAutoria3D,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToBoolean},
                                 ConverterParameter=CrearColumna}"/>
                <RadioButton GroupName="Herramientas3D"
                             Content="🟧  Crear Viga"
                             Foreground="#FFEEEEEE" Margin="0,0,0,4"
                             ToolTip="2 clicks (inicio + fin). El primer click memoriza P1 y dibuja una línea naranja provisional desde P1 al cursor. El segundo click materializa la viga."
                             IsChecked="{Binding DataContext.HerramientaAutoria3D,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToBoolean},
                                 ConverterParameter=CrearViga}"/>
                <RadioButton GroupName="Herramientas3D"
                             Content="🗑  Borrar elemento"
                             Foreground="#FFEEEEEE" Margin="0,0,0,4"
                             ToolTip="Click sobre un elemento estructural (columna/viga/zapata) lo elimina. Click en vacío es no-op silencioso. Muros y losas blindados."
                             IsChecked="{Binding DataContext.HerramientaAutoria3D,
                                 RelativeSource={RelativeSource AncestorType=Window},
                                 Converter={StaticResource EnumToBoolean},
                                 ConverterParameter=BorrarElemento}"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
