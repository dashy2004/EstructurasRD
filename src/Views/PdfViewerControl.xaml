<UserControl x:Class="LosasPlus.Views.PdfViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgInput}">
    <!--
        PDF Viewer embebido para el modo Reglamento (Liga E paso E1).
        DependencyProperty PdfPath; cuando cambia, se cuenta el total de
        páginas con PdfImportador.ContarPaginasAsync y se rasteriza la
        página 0. Navegación con prev/next + zoom 50%-200% via slider.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar de navegación -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Left" x:Name="BtnAnterior"
                        Content="◀ Anterior" Padding="10,4"
                        Click="OnAnteriorClick"/>
                <Button DockPanel.Dock="Right" x:Name="BtnSiguiente"
                        Content="Siguiente ▶" Padding="10,4"
                        Click="OnSiguienteClick"/>
                <TextBlock DockPanel.Dock="Left" Margin="12,0,4,0" VerticalAlignment="Center"
                           Text="Página" Foreground="{DynamicResource FgMuted}"/>
                <TextBox DockPanel.Dock="Left" x:Name="TxtPagina" Width="44"
                         VerticalAlignment="Center" TextAlignment="Center"
                         FontFamily="JetBrains Mono, Consolas"
                         KeyDown="OnPaginaKeyDown"/>
                <TextBlock DockPanel.Dock="Left" Margin="4,0,12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgMuted}">
                    de <Run x:Name="LblTotal" Text="0"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgMuted}" FontSize="11">
                    Zoom: <Run x:Name="LblZoom" Text="100%"/>
                </TextBlock>
                <Slider DockPanel.Dock="Right" x:Name="SldZoom"
                        Minimum="0.5" Maximum="2.0" Value="1.0" Width="120"
                        VerticalAlignment="Center" Margin="0,0,8,0"
                        TickFrequency="0.25" IsSnapToTickEnabled="False"
                        ValueChanged="OnZoomChanged"/>
                <!-- Spacer -->
                <Border/>
            </DockPanel>
        </Border>

        <!-- Canvas de la página -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#FF1A1A1A">
            <Grid x:Name="HostImagen" Margin="20"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="ImgPagina" Stretch="None"/>
                <TextBlock x:Name="LblPlaceholder"
                           Text="Cargando PDF…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgMuted}"
                           FontSize="14" FontStyle="Italic"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
