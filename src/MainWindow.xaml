<Window x:Class="LosasPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LosasPlus.ViewModels"
        xmlns:m="clr-namespace:LosasPlus.Models"
        xmlns:v="clr-namespace:LosasPlus.Views"
        xmlns:s="clr-namespace:LosasPlus.Services"
        xmlns:cmn="clr-namespace:MemoriaPlus.Common;assembly=MemoriaPlus.UI.Shared"
        xmlns:vws="clr-namespace:MemoriaPlus.Views;assembly=MemoriaPlus.UI.Shared"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{Binding TituloVentana}"
        Height="900" Width="1440" MinHeight="640" MinWidth="1100"
        Background="{DynamicResource BgPrimary}"
        WindowStartupLocation="CenterScreen">

    <!-- Atajos de teclado globales. Ctrl+/ abre el panel de atajos. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl"       Key="N" Command="{Binding NuevoProyectoLpxCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="O" Command="{Binding AbrirProyectoLpxCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="S" Command="{Binding GuardarProyectoLpxCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding GuardarComoLpxCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="E" Command="{Binding IrAExploradorCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="OemQuestion" Command="{Binding AbrirShortcutsCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="F" Command="{Binding IrABusquedaCommand}"/>
        <KeyBinding Modifiers="Ctrl"       Key="G" Command="{Binding GenerarMemoriaCommand}"/>
    </Window.InputBindings>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <cmn:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =============================================================
             SIDEBAR (240 px) — branding + nav modos + sistemas + footer
             ============================================================= -->
        <Border Grid.Column="0" Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- branding header -->
                    <RowDefinition Height="Auto"/>  <!-- nav modos -->
                    <RowDefinition Height="Auto"/>  <!-- separador SISTEMAS -->
                    <RowDefinition Height="*"/>     <!-- sistemas list -->
                    <RowDefinition Height="Auto"/>  <!-- footer sidebar -->
                </Grid.RowDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Row="0" Margin="20,20,20,12">
                    <TextBlock Text="LosasPlus"
                               FontFamily="Inter, Segoe UI"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="{Binding Version}"
                               FontFamily="JetBrains Mono, Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource FgMuted}"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="motor: F. Perdomo"
                               FontSize="10"
                               Foreground="{DynamicResource FgMuted}"/>
                </StackPanel>

                <!-- Nav modos: 7 RadioButtons bindeados a ModoActivo via EnumToBool. -->
                <StackPanel Grid.Row="1" Margin="8,0,8,12">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type RadioButton}">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type RadioButton}">
                                        <Border x:Name="bd"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="3,0,0,0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgTertiary}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ActiveBar}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsChecked" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgInput}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton GroupName="SidebarNav" Content="📂  Explorador"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Explorador}"/>
                    <RadioButton GroupName="SidebarNav" Content="🔍  Búsqueda"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Busqueda}"/>
                    <RadioButton GroupName="SidebarNav" Content="✎  Editor"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Editor}"/>
                    <RadioButton GroupName="SidebarNav" Content="⛶  Diagrama"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Diagrama}"/>
                    <RadioButton GroupName="SidebarNav" Content="▤  Editor .DL"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DLEditor}"/>
                    <RadioButton GroupName="SidebarNav" Content="⇲  Salida .TXT"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Salida}"/>
                    <RadioButton GroupName="SidebarNav" Content="🛡  Validación"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Validacion}"/>
                    <RadioButton GroupName="SidebarNav" Content="⚖  Reglamento"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Reglamento}"/>
                    <RadioButton GroupName="SidebarNav" Content="📚  Plantillas"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Plantillas}"/>
                    <RadioButton GroupName="SidebarNav" Content="⚙  Configuración"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Configuracion}"/>
                    <RadioButton GroupName="SidebarNav" Content="◆  Plugins"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Plugins}"/>
                    <RadioButton GroupName="SidebarNav" Content="ℹ  Acerca de"
                                 IsChecked="{Binding ModoActivo, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Acerca}"/>
                </StackPanel>

                <!-- Separador + título SISTEMAS -->
                <StackPanel Grid.Row="2" Margin="16,4,16,4">
                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,8"/>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="SISTEMAS"
                                   FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource FgMuted}"/>
                        <Button DockPanel.Dock="Right" Content="−" Width="22" Height="22" Padding="0"
                                Click="OnDeleteSistema"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource FgMuted}"
                                ToolTip="Eliminar sistema seleccionado"/>
                        <Button DockPanel.Dock="Right" Content="+" Width="22" Height="22" Padding="0"
                                Click="OnAddSistema"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource FgPrimary}"
                                ToolTip="Agregar nuevo sistema"/>
                    </DockPanel>
                </StackPanel>

                <!-- Lista de sistemas -->
                <ListBox Grid.Row="3" x:Name="SistemasList"
                         Margin="8,4,8,8"
                         ItemsSource="{Binding Proyecto.Sistemas}"
                         SelectedItem="{Binding SistemaActivo, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Nombre}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource FgPrimary}"/>
                                <TextBlock FontSize="10" Margin="0,2,0,0"
                                           Foreground="{DynamicResource FgMuted}">
                                    <Run Text="{Binding Losas.Count, Mode=OneWay}"/>
                                    <Run Text=" losas · "/>
                                    <Run Text="{Binding BordesX.Count, Mode=OneWay}"/>
                                    <Run Text="X + "/>
                                    <Run Text="{Binding BordesY.Count, Mode=OneWay}"/>
                                    <Run Text="Y bordes"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer sidebar: project path + theme buttons -->
                <Border Grid.Row="4" Padding="14,10"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="PROJECT" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource FgMuted}"/>
                        <TextBlock Text="{Binding Proyecto.Archivo, FallbackValue=(sin .DL), TargetNullValue=(sin .DL), Mode=OneWay}"
                                   FontFamily="JetBrains Mono, Consolas" FontSize="10"
                                   Margin="0,2,0,8"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Proyecto.Archivo}"
                                   Foreground="{DynamicResource FgSecondary}"/>
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Left" Content="Tema" Padding="8,3"
                                    Click="OnToggleTheme"
                                    Background="Transparent"
                                    Foreground="{DynamicResource FgSecondary}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    ToolTip="Ciclar Precision/Light/Dark"/>
                            <Button DockPanel.Dock="Right" Content="Apariencia" Padding="8,3"
                                    Click="OnAppearanceClick"
                                    Background="Transparent"
                                    Foreground="{DynamicResource FgSecondary}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    ToolTip="Personalizar colores"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =============================================================
             ÁREA PRINCIPAL: top bar + content switch + statusbar
             ============================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- top action bar -->
                <RowDefinition Height="*"/>     <!-- content switch -->
                <RowDefinition Height="Auto"/>  <!-- log expandible -->
                <RowDefinition Height="Auto"/>  <!-- statusbar -->
            </Grid.RowDefinitions>

            <!-- =========================================================
                 TOP ACTION BAR: menús File/Engine/Export + path Losas.exe +
                 botón Lanzar motor. Visible en TODOS los modos.
                 ========================================================= -->
            <Border Grid.Row="0" Padding="16,8"
                    Background="{DynamicResource BgInput}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center">
                        <Menu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
                            </Style>
                        </Menu.Resources>
                        <MenuItem Header="File">
                            <MenuItem Header="Nuevo proyecto..." Click="OnNewProjectClick"/>
                            <MenuItem Header="Abrir proyecto..." Click="OnOpenProjectClick"/>
                            <MenuItem Header="Guardar proyecto..." Click="OnSaveProjectClick"/>
                            <Separator/>
                            <MenuItem Header="Abrir .DL legacy..." Click="OnOpenClick"/>
                            <MenuItem Header="Guardar .DL agregado..." Click="OnSaveClick"
                                      ToolTip="Guarda todos los sistemas en un único .DL multi-sistema (formato legacy)."/>
                            <Separator/>
                            <MenuItem Header="Pegar de Excel..." Click="OnPasteFromExcelClick"/>
                        </MenuItem>
                        <MenuItem Header="Engine">
                            <MenuItem Header="Examinar Losas.exe..." Click="OnBrowseLosasExe"/>
                            <MenuItem Header="Lanzar Losas.exe" Click="OnLaunchLosasExeClick"/>
                            <MenuItem Header="Importar .TXT..." Click="OnImportTxtClick"/>
                        </MenuItem>
                        <MenuItem Header="Export">
                            <MenuItem Header="Generar memoria .docx... (Ctrl+G)" Command="{Binding GenerarMemoriaCommand}"/>
                            <Separator/>
                            <MenuItem Header="Exportar CSV..." Click="OnExportCsvClick"/>
                            <MenuItem Header="Exportar XLSX..." Click="OnExportXlsxClick"/>
                        </MenuItem>
                    </Menu>

                    <!-- Botón Lanzar motor a la derecha -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="▶ Lanzar motor" Padding="14,4" Margin="6,0,0,0"
                            Click="OnLaunchLosasExeClick"
                            ToolTip="Abre Losas.exe. Cargá el .DL desde su menú File y ejecutá el cálculo, luego volvé acá e Importá el .TXT."/>

                    <!-- Chip indicador de Validación normativa (commit 33). Click lleva al modo Validación.
                         Color de fondo varía según severidad (verde / naranja / rojo). -->
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4"
                            Cursor="Hand" BorderThickness="1"
                            Command="{Binding Validacion.AbrirPanelCommand}"
                            Click="OnChipValidacionClick"
                            ToolTip="Abrir panel de validación normativa">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="#1F4CAF50"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Ok}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Validacion.ColorIndicador}" Value="Error">
                                        <Setter Property="Background" Value="#1FD32F2F"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Err}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Validacion.ColorIndicador}" Value="Warning">
                                        <Setter Property="Background" Value="#1FFFA000"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Warn}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="JetBrains Mono, Consolas"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgPrimary}"
                                   Text="{Binding Validacion.ResumenIndicador}"/>
                    </Button>

                    <!-- Path Losas.exe -->
                    <TextBlock DockPanel.Dock="Left" Text="Losas.exe:" VerticalAlignment="Center"
                               Margin="16,0,6,0" Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                    <TextBox Text="{Binding LosasExePath, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="JetBrains Mono, Consolas" FontSize="11"
                             VerticalAlignment="Center" MinHeight="26" Margin="0,0,6,0"/>
                </DockPanel>
            </Border>

            <!-- =========================================================
                 CONTENT SWITCH por ModoActivo. Cada modo es una Grid con
                 el contenido del antiguo TabItem. Visible solo si su modo
                 está activo (DataTrigger).
                 ========================================================= -->
            <Grid Grid.Row="1">

                <!-- MODO Explorador (commit 32): hub de proyectos recientes (.lpx.json) -->
                <Grid Margin="32,24">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Explorador">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- header -->
                        <RowDefinition Height="Auto"/>  <!-- status -->
                        <RowDefinition Height="*"/>     <!-- tabla -->
                        <RowDefinition Height="Auto"/>  <!-- footer info -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Proyectos recientes"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource FgPrimary}"/>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource FgMuted}"
                                       FontSize="13"
                                       Text="Archivos .lpx.json compartidos con MemoriaPlus.App. Doble-click para abrir en Editor."/>
                        </StackPanel>
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,6"
                                Content="+ Nuevo proyecto"
                                Command="{Binding NuevoProyectoLpxCommand}"
                                Style="{StaticResource PrimaryButton}"/>
                        <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,6"
                                Content="📂 Abrir .lpx.json…"
                                Command="{Binding AbrirProyectoLpxCommand}"/>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,0,0,12" Padding="10,6"
                            Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusPersistencia, Converter={StaticResource NullToCollapsed}}" Value="Visible">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusPersistencia}"
                                   FontFamily="JetBrains Mono, Consolas"
                                   FontSize="11"
                                   Foreground="{DynamicResource FgSecondary}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource BgSecondary}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <DataGrid x:Name="ProyectosRecientesGrid"
                                  ItemsSource="{Binding ProyectosRecientes}"
                                  SelectedItem="{Binding ProyectoRecienteSeleccionado}"
                                  SelectionUnit="FullRow"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MouseDoubleClick="OnAbrirRecienteDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NOMBRE"      Width="2*"  Binding="{Binding Nombre}"/>
                                <DataGridTextColumn Header="INGENIERO"   Width="*"   Binding="{Binding Ingeniero}"/>
                                <DataGridTextColumn Header="CÓDIGO OBRA" Width="120" Binding="{Binding Codia}"/>
                                <DataGridTextColumn Header="SISTEMAS"    Width="80"  Binding="{Binding Niveles}"/>
                                <DataGridTextColumn Header="ÚLT. EDICIÓN" Width="140" Binding="{Binding UltimaEdicion}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="3" Margin="0,8,0,0"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource FgMuted}"
                               FontFamily="JetBrains Mono, Consolas" FontSize="11">
                        <Run Text="Total: "/>
                        <Run Text="{Binding ProyectosRecientes.Count, Mode=OneWay}"/>
                        <Run Text=" proyectos · registry compartido con MemoriaPlus"/>
                    </TextBlock>
                </Grid>

                <!-- MODO Editor: DataGrid de losas + tipos panel + sistema settings -->
                <Grid Margin="16">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Editor">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Columna del esquema en vivo: 0 si toggle OFF, *
                             si toggle ON. Cambia via DataTrigger sobre
                             EsquemaEnVivo. -->
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="{x:Type ColumnDefinition}">
                                    <Setter Property="Width" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsquemaEnVivo}" Value="True">
                                            <Setter Property="Width" Value="*"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Esquema en vivo (col 1) — visible solo con toggle ON -->
                    <Border Grid.Column="1" Margin="6,0,6,0"
                            Background="{DynamicResource BgSecondary}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsquemaEnVivo}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <v:DiagramView x:Name="DiagramLive" DataContext="{Binding}"/>
                    </Border>

                    <!-- Tabla de losas + tipos panel abajo -->
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Filtro tipo:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="180" Text="{Binding FiltroTipo, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="+ Losa" Width="80" Margin="8,0,0,0" Click="OnAddLosa"/>
                            <Button Content="– Losa" Width="80" Margin="4,0,0,0" Click="OnDelLosa"/>
                            <Button Content="Pegar de Excel..." Width="140" Margin="8,0,0,0"
                                    Click="OnPasteFromExcelClick"
                                    ToolTip="Pegar (Ctrl+V) una tabla con columnas Lx, Ly, Espesor, Carga (opcionalmente Tipo y Rec) y crear las losas."/>
                            <!-- Undo / Redo (Ctrl+Z / Ctrl+Y) -->
                            <Button Content="↶ Undo" Width="80" Margin="8,0,0,0"
                                    Command="{Binding UndoCommand}"
                                    ToolTip="Deshacer último cambio (Ctrl+Z). Max 50 niveles."/>
                            <Button Content="↷ Redo" Width="80" Margin="4,0,0,0"
                                    Command="{Binding RedoCommand}"
                                    ToolTip="Rehacer el último undo (Ctrl+Y)."/>
                            <Button Content="⌨  Atajos" Width="100" Margin="8,0,0,0"
                                    Command="{Binding AbrirShortcutsCommand}"
                                    ToolTip="Ver todos los atajos de teclado (Ctrl+/)."/>
                            <!-- Esquema en vivo: split-view con el diagrama. -->
                            <ToggleButton DockPanel.Dock="Right" Margin="8,0,0,0"
                                          IsChecked="{Binding EsquemaEnVivo, Mode=TwoWay}"
                                          Padding="10,4"
                                          ToolTip="Mostrar el esquema 2D al lado de la tabla y redibujarlo en vivo a medida que editás Lx/Ly/Tipo.">
                                <TextBlock>
                                    <Run Text="👁  Esquema en vivo"/>
                                </TextBlock>
                            </ToggleButton>
                            <TextBlock Text="(seleccioná una fila para eliminar / aplicar tipo)" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource FgMuted}"/>
                        </DockPanel>

                        <!-- BULK APPLY PANEL (visible cuando ≥2 losas seleccionadas).
                             Aplica los valores ingresados a todas las losas seleccionadas.
                             Campos vacíos = no aplicar ese atributo. -->
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource BgSecondary}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                                CornerRadius="4"
                                Margin="0,4,0,4" Padding="10,6">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MostrarBulkPanel}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource FgPrimary}"
                                           Margin="0,0,8,0">
                                    <Run Text="✎"/>
                                    <Run Text="{Binding BulkSeleccionadasCount, Mode=OneWay}"/>
                                    <Run Text=" seleccionadas · aplicar:"/>
                                </TextBlock>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Lx" VerticalAlignment="Center" Margin="6,0,2,0"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                    <TextBox Width="55" Text="{Binding BulkLx, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" FontFamily="JetBrains Mono"
                                             ToolTip="Lx en metros (vacío = no aplicar)"/>
                                    <TextBlock Text="Ly" VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                    <TextBox Width="55" Text="{Binding BulkLy, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" FontFamily="JetBrains Mono"
                                             ToolTip="Ly en metros (vacío = no aplicar)"/>
                                    <TextBlock Text="H" VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                    <TextBox Width="55" Text="{Binding BulkEspesor, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" FontFamily="JetBrains Mono"
                                             ToolTip="Espesor en metros (vacío = no aplicar)"/>
                                    <TextBlock Text="Carga" VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                    <TextBox Width="55" Text="{Binding BulkCarga, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" FontFamily="JetBrains Mono"
                                             ToolTip="Carga en t/m² (vacío = no aplicar)"/>
                                    <TextBlock Text="Tipo" VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                    <TextBox Width="50" Text="{Binding BulkTipo, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" FontFamily="JetBrains Mono"
                                             ToolTip="Código del tipo Pieper-Martens (vacío = no aplicar)"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                        Content="✓ Confirmar"
                                        Padding="14,4" Margin="12,0,0,0"
                                        Command="{Binding AplicarBulkCommand}"
                                        ToolTip="Aplicar los valores no vacíos a todas las losas seleccionadas"/>
                            </DockPanel>
                        </Border>

                        <!-- Tipos panel abajo -->
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource BgSecondary}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                Margin="0,6,0,0" Padding="6" Height="240">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6"
                                           Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap">
                                    <Run Text="TIPOS DE LOSAS · " FontWeight="Bold"/>
                                    <Run Text="hover = descripción · click = aplicar a la fila seleccionada"/>
                                </TextBlock>
                                <v:TiposLosaPanel x:Name="TiposPanel"/>
                            </DockPanel>
                        </Border>

                        <DataGrid x:Name="LosasGrid"
                                  ItemsSource="{Binding LosasFiltradas}"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  CellEditEnding="OnLosasCellEdited"
                                  SelectionChanged="OnLosasSelectionChanged">
                            <DataGrid.Columns>
                                <!-- ID: en modo conexión, click crea bordes adicionales pareando IDs. -->
                                <DataGridTemplateColumn Header="ID" Width="50" IsReadOnly="True" SortMemberPath="Id">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button BorderThickness="0" Background="Transparent"
                                                    Padding="2" Cursor="Hand"
                                                    HorizontalContentAlignment="Center"
                                                    Click="OnLosaIdClick"
                                                    Tag="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.ModoConectarBordes, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentHi}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource FgOnAccent}"/>
                                                                <Setter Property="ToolTip" Value="Click para conectar bordes adicionales"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Columna DIR: indicador 1D/2D según Losa.Cond (Lx/Ly aspect ratio).
                                     Live: cambia al editar Lx o Ly. -->
                                <!-- DIR: indicador 2D / 1D-V (losa ancha, refuerzo vertical) /
                                     1D-H (losa alta, refuerzo horizontal). El SVG de "una
                                     dirección" se rota según DireccionAnguloGrados (0°
                                     wide / 90° tall). Live: se actualiza al editar Lx o Ly. -->
                                <DataGridTemplateColumn Header="DIR" Width="44" IsReadOnly="True"
                                                        SortMemberPath="DireccionTrabajo">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding DireccionTrabajoTexto}">
                                                <svgc:SvgViewbox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Width="28" Height="28"
                                                                 RenderTransformOrigin="0.5,0.5">
                                                    <svgc:SvgViewbox.RenderTransform>
                                                        <RotateTransform Angle="{Binding DireccionAnguloGrados}"/>
                                                    </svgc:SvgViewbox.RenderTransform>
                                                    <svgc:SvgViewbox.Style>
                                                        <Style TargetType="{x:Type svgc:SvgViewbox}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cond}" Value="1D">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Source" Value="pack://application:,,,/Resources/icons/direction_1d.svg"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </svgc:SvgViewbox.Style>
                                                </svgc:SvgViewbox>
                                                <svgc:SvgViewbox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Width="28" Height="28">
                                                    <svgc:SvgViewbox.Style>
                                                        <Style TargetType="{x:Type svgc:SvgViewbox}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cond}" Value="2D">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Source" Value="pack://application:,,,/Resources/icons/direction_2d.svg"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </svgc:SvgViewbox.Style>
                                                </svgc:SvgViewbox>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <v:TipoLosaIconView Codigo="{Binding Tipo, Mode=OneWay}"
                                                                Width="44" Height="44"
                                                                ToolTip="{Binding TipoDescripcion}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="TIPO" Width="180" SortMemberPath="Tipo">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Click abre el modal SelectorTipoLosaWindow (commit 37).
                                                 Doble-click se mantiene como Tag=Losa para que el handler
                                                 en code-behind sepa qué losa abrir. -->
                                            <Button BorderThickness="1" Padding="6,2" Margin="2"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource Border}"
                                                    Cursor="Hand"
                                                    HorizontalContentAlignment="Stretch"
                                                    Click="OnAbrirSelectorTipoLosaClick"
                                                    Tag="{Binding}"
                                                    ToolTip="Click para abrir el selector visual de tipo Pieper-Martens">
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Tipo, Mode=OneWay}"
                                                         FontWeight="SemiBold"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding TipoDescripcion, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Carga [t/m²]" Width="90"
                                                    Binding="{Binding Carga, StringFormat=0.000, ValidatesOnDataErrors=True, UpdateSourceTrigger=LostFocus}"/>
                                <DataGridTextColumn Header="H [m]" Width="70"
                                                    Binding="{Binding Espesor, StringFormat=0.000, ValidatesOnDataErrors=True, UpdateSourceTrigger=LostFocus}"/>
                                <DataGridTextColumn Header="Lx [m]" Width="70"
                                                    Binding="{Binding Lx, StringFormat=0.000, ValidatesOnDataErrors=True, UpdateSourceTrigger=LostFocus}"/>
                                <DataGridTextColumn Header="Ly [m]" Width="70"
                                                    Binding="{Binding Ly, StringFormat=0.000, ValidatesOnDataErrors=True, UpdateSourceTrigger=LostFocus}"/>
                                <DataGridTextColumn Header="Rec [m]" Width="70"
                                                    Binding="{Binding Rec, StringFormat=0.000, ValidatesOnDataErrors=True, UpdateSourceTrigger=LostFocus}"/>
                                <!-- HEq: espesor equivalente (αfm ACI 318 §9.5.3.3) — útil para
                                     verificar si una losa vigueta+bloque tiene rigidez similar a una
                                     maciza. Computed read-only del CalculoEngine de Core (commit 27). -->
                                <DataGridTextColumn Header="HEq [m]" Width="80" IsReadOnly="True"
                                                    Binding="{Binding HEq, StringFormat=0.000, TargetNullValue=—}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
                                            <Setter Property="FontFamily" Value="JetBrains Mono"/>
                                            <Setter Property="ToolTip" Value="Espesor equivalente (αfm ACI 318 §9.5.3.3) — para vigueta+bloque. — si no calculado."/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Ly/Lx" Width="60" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AspectoFueraDeRango}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Warn}"/>
                                                                <Setter Property="ToolTip" Value="{Binding AspectoMensaje}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Aspecto, StringFormat=0.00, Mode=OneWay}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Mfx" Binding="{Binding Mfx, StringFormat=0.0000}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Mfy" Binding="{Binding Mfy, StringFormat=0.0000}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="MSx" Binding="{Binding MSx, StringFormat=0.0000}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="MSy" Binding="{Binding MSy, StringFormat=0.0000}" Width="80" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Panel lateral: settings del sistema + bordes -->
                    <Border Grid.Column="2" Background="{DynamicResource BgSecondary}" Margin="6,0,0,0" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Sistema" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Nombre" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Sistema.Nombre, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="FC [ton/cm²]" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Sistema.Fc, StringFormat=0.000, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="FY [ton/cm²]" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Sistema.Fy, StringFormat=0.000, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="ADICIONALES (0=rectas, 1=camelladas)" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding Sistema.Adicionales, UpdateSourceTrigger=LostFocus}"/>

                                <Separator Margin="0,12,0,12"/>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Left" Text="Bordes adic. SEGÚN X" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <ToggleButton DockPanel.Dock="Right" Padding="6,2"
                                                  IsChecked="{Binding ModoConectarBordes, Mode=TwoWay}"
                                                  ToolTip="Activá y click en dos IDs de losas del grid para crear el borde automático."
                                                  FontSize="11">
                                        <TextBlock Text="🔗 Conectar"/>
                                    </ToggleButton>
                                </DockPanel>
                                <!-- Altura dinámica: MinHeight=100 expande con el contenido. Se mantiene
                                     dentro del ScrollViewer del panel lateral. -->
                                <DataGrid ItemsSource="{Binding Sistema.BordesX}" AutoGenerateColumns="False"
                                          MinHeight="100" MaxHeight="260"
                                          Margin="0,4,0,0" CanUserAddRows="False" SelectionMode="Single" Tag="X"
                                          VerticalScrollBarVisibility="Auto"
                                          CellEditEnding="OnBordeCellEdited">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="B-I" Binding="{Binding BI}" Width="*"/>
                                        <DataGridTextColumn Header="B-J" Binding="{Binding BJ}" Width="*"/>
                                        <!-- BAL: el SelectedValuePath=Content fija el bug donde la
                                             ComboBox devolvía el ComboBoxItem en vez del string. -->
                                        <DataGridTemplateColumn Header="BAL" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding Balanceo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              SelectedValuePath="Content">
                                                        <ComboBoxItem Content="S"/>
                                                        <ComboBoxItem Content="N"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="+ Borde X" Click="OnAddBordeX"/>
                                    <Button Content="– Borde X" Click="OnDelBordeX" Margin="4,0,0,0"/>
                                    <Button Content="Auto BAL" Margin="8,0,0,0"
                                            Command="{Binding AutoBalanceoCommand}"
                                            ToolTip="Setea BAL=N en bordes donde al menos una losa tiene voladizo (Losas.exe convention)."/>
                                </StackPanel>

                                <Separator Margin="0,12,0,12"/>
                                <TextBlock Text="Bordes adic. SEGÚN Y" FontWeight="Bold"/>
                                <DataGrid ItemsSource="{Binding Sistema.BordesY}" AutoGenerateColumns="False"
                                          MinHeight="100" MaxHeight="260"
                                          Margin="0,4,0,0" CanUserAddRows="False" SelectionMode="Single" Tag="Y"
                                          VerticalScrollBarVisibility="Auto"
                                          CellEditEnding="OnBordeCellEdited">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="B-I" Binding="{Binding BI}" Width="*"/>
                                        <DataGridTextColumn Header="B-J" Binding="{Binding BJ}" Width="*"/>
                                        <DataGridTemplateColumn Header="BAL" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding Balanceo, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              SelectedValuePath="Content">
                                                        <ComboBoxItem Content="S"/>
                                                        <ComboBoxItem Content="N"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="+ Borde Y" Click="OnAddBordeY"/>
                                    <Button Content="– Borde Y" Click="OnDelBordeY" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- MODO Diagrama -->
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Diagrama">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <v:DiagramView x:Name="Diagram" DataContext="{Binding}"/>
                </ContentControl>

                <!-- MODO DLEditor (texto crudo) -->
                <Grid Margin="16">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="DLEditor">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center"
                                   Text="Vista del archivo .DL generado a partir del modelo (lectura/edición)"/>
                        <Button DockPanel.Dock="Right" Content="Aplicar al modelo" Width="140" Click="OnApplyDLText"/>
                    </DockPanel>
                    <TextBox Grid.Row="1"
                             x:Name="DLEditor"
                             Text="{Binding DLContent, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"/>
                </Grid>

                <!-- MODO Salida .TXT -->
                <Grid Margin="16">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Salida">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding TxtPath, StringFormat={}Archivo: {0}}"
                               Foreground="{DynamicResource FgMuted}" Margin="0,0,0,8"/>
                    <v:HighlightedTxtView Grid.Row="1" Text="{Binding TxtContent}"/>
                </Grid>

                <!-- MODO Reglamento -->
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Reglamento">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <v:ReglamentoView DataContext="{Binding}"/>
                </ContentControl>

                <!-- MODO Plugins -->
                <Grid Margin="16">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Plugins">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Recargar plugins" Width="140" Click="OnReloadPlugins"/>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Scripts .csx en /plugins. Hooks soportados: load, pre-dl, pre-run, post-run, post-txt, custom-export. Los hooks SOLO se ejecutan para plugins marcados como CONFIABLES (Roslyn no es un sandbox de seguridad fuerte)."/>
                    </DockPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Plugins.Loaded}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        Background="{DynamicResource BgSecondary}"
                                        Margin="0,0,0,8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock DockPanel.Dock="Left" Margin="10,2,0,0"
                                                           Text="{Binding FileName, StringFormat=({0})}"
                                                           Foreground="{DynamicResource FgMuted}"/>
                                                <TextBlock HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="● No confiable"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Trusted}" Value="True">
                                                                    <Setter Property="Text" Value="● Confiable"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>

                                            <TextBlock Margin="0,4,0,0">
                                                <Run Foreground="{DynamicResource FgMuted}" Text="Autor:"/>
                                                <Run Text="{Binding Manifest.Author, FallbackValue=(sin manifest), TargetNullValue=(sin manifest), Mode=OneWay}"/>
                                                <Run Foreground="{DynamicResource FgMuted}" Text=" · Versión:"/>
                                                <Run Text="{Binding Manifest.Version, FallbackValue=-, TargetNullValue=-, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Text="{Binding Manifest.Description, FallbackValue=Sin descripción, TargetNullValue=Sin descripción, Mode=OneWay}"
                                                       Foreground="{DynamicResource FgSecondary}"/>
                                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource FgMuted}"
                                                       Text="{Binding Sha256, StringFormat=SHA-256: {0}}"
                                                       FontFamily="Consolas" FontSize="10"/>

                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Err}"
                                                       Text="{Binding CompileError, StringFormat=Error de compilación: {0}}"
                                                       Visibility="{Binding CompileError, Converter={StaticResource NullToCollapsed}}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <Button Content="Confiar" Width="100" Click="OnTrustPluginClick"
                                                    Tag="{Binding FullPath}"
                                                    Visibility="{Binding Trusted, Converter={StaticResource BoolToCollapsedIfTrue}}"/>
                                            <Button Content="Revocar" Width="100" Margin="0,4,0,0" Click="OnRevokeTrustClick"
                                                    Tag="{Binding FullPath}"
                                                    Background="{DynamicResource Border}"
                                                    Visibility="{Binding Trusted, Converter={StaticResource BoolToCollapsedIfFalse}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>
                </Grid>

                <!-- MODO Validación normativa (commit 33) — consume ValidacionView del shared.
                     El MainViewModel implementa IValidacionHost, así que DataContext del shared view
                     puede ser el MainViewModel completo y resolverá vía vm.Validacion. -->
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Validacion">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <vws:ValidacionView DataContext="{Binding Validacion}"
                                        HorizontalAlignment="Stretch"/>
                </ContentControl>

                <!-- MODO Búsqueda global (commit 35) — consume BusquedaView del shared. -->
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Busqueda">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <vws:BusquedaView/>
                </ContentControl>

                <!-- MODO Plantillas (commit 36) — consume PlantillasView del shared. -->
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Plantillas">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <vws:PlantillasView/>
                </ContentControl>

                <!-- MODO Configuración (commit 34) — consume ConfiguracionView del shared
                     (Perfil ingeniero + Apariencia + Atajos editables). -->
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Configuracion">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <vws:ConfiguracionView/>
                </ContentControl>

                <!-- MODO Acerca de -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="{x:Type ScrollViewer}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModoActivo}" Value="Acerca">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="32,24" MaxWidth="900">
                        <TextBlock Text="LosasPlus" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock Text="Capa de UI, edición, visualización y exportación construida sobre el motor original."
                                   Margin="0,4,0,0" Foreground="{DynamicResource FgSecondary}"/>

                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Crédito principal" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource FgSecondary}">
                            El motor de cálculo es obra de <Run FontWeight="Bold">Francisco Eludino Perdomo</Run>
                            (Losas v5.00, febrero 2011). El método implementado es el de Pieper-Martens
                            (TU Braunschweig), adaptado por el autor para el análisis de losas continuas
                            apoyadas en tres y cuatro bordes. Contacto del autor original:
                            <Run Text=" fa.perdomo@gmail.com" FontStyle="Italic"/>.
                        </TextBlock>

                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Alcance del wrapper" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource FgSecondary}">
                            El presente programa NO modifica el binario original. Genera el archivo .DL
                            de entrada conforme al formato documentado por el autor en Losas.hlp,
                            permite lanzar Losas.exe (la ejecución del cálculo es manual desde la GUI
                            nativa del programa, ver <Run FontStyle="Italic">docs/RUNNER_BEHAVIOR.md</Run>)
                            e importar el .TXT resultante para visualizar y exportar. Agrega capas de:
                            edición estructurada con catálogo de tipos, esquema visual, preview del .TXT
                            de salida, exportación a CSV/XLSX, panel del Reglamento de Construcción Dominicano
                            y arquitectura de plugins .csx en sandbox Roslyn.
                        </TextBlock>

                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Limitaciones del motor (según el autor)" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource FgSecondary}">
                            · Carga viva ≤ 2/3 de la carga total (sin factorizar). · Apoyos lineales
                            rígidos (vigas con peralte &gt; 4·h o cumplimiento del §13.6.1.6 ACI 318-08).
                            · No verifica fuerza cortante. · No calcula deformaciones.
                        </TextBlock>

                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Autor del wrapper LosasPlus" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource FgSecondary}">
                            Esta capa de UI/edición/exportación fue construida por
                            <Run FontWeight="Bold">Emil Guillen De la Cruz</Run> como aporte al ecosistema
                            de herramientas estructurales en República Dominicana. El motor de cálculo
                            sigue siendo obra exclusiva de F. Perdomo; LosasPlus se ofrece como sugerencia
                            de modernización al autor original.
                        </TextBlock>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Email" Foreground="{DynamicResource FgMuted}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ContactEmail">
                                <Hyperlink NavigateUri="mailto:emilgdc@gmail.com" RequestNavigate="OnContactNavigate">emilgdc@gmail.com</Hyperlink>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GitHub" Foreground="{DynamicResource FgMuted}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1">
                                <Hyperlink NavigateUri="https://github.com/dashy2004" RequestNavigate="OnContactNavigate">@dashy2004</Hyperlink>
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="YouTube" Foreground="{DynamicResource FgMuted}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1">
                                <Hyperlink NavigateUri="https://www.youtube.com/@emilguillen" RequestNavigate="OnContactNavigate">@emilguillen</Hyperlink>
                            </TextBlock>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Instagram" Foreground="{DynamicResource FgMuted}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1">
                                <Hyperlink NavigateUri="https://www.instagram.com/emilguillendelacruz" RequestNavigate="OnContactNavigate">@emilguillendelacruz</Hyperlink>
                            </TextBlock>
                        </Grid>

                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Aviso legal" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource FgPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Warn}">
                            La distribución y uso público de este wrapper junto con el binario original
                            requieren autorización de F. Perdomo. La presente compilación es una capa
                            externa que respeta y atribuye la autoría del motor de cálculo. El código
                            fuente del wrapper es de Emil Guillen De la Cruz y se entrega como
                            sugerencia/aporte sin reclamar derechos sobre el motor original.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- =========================================================
                 LOG EXPANDIBLE: visible si LogToggle.IsChecked.
                 ========================================================= -->
            <Border Grid.Row="2"
                    Background="#0F172A"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Visibility="{Binding ElementName=LogToggle, Path=IsChecked, Converter={StaticResource BoolToCollapsedIfFalse}}"
                    Padding="14,8">
                <TextBox Height="120"
                         Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                         Background="#0F172A" Foreground="#E2E8F0"
                         BorderThickness="0"
                         FontFamily="JetBrains Mono, Consolas, Cascadia Mono"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"/>
            </Border>

            <!-- =========================================================
                 STATUSBAR inferior dinámico.
                 ========================================================= -->
            <Border Grid.Row="3" Padding="16,6"
                    Background="{DynamicResource BgInput}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,6,0"
                             Fill="{DynamicResource Ok}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12">
                        <Run Foreground="{DynamicResource FgMuted}" Text="Status:"/>
                        <Run Foreground="{DynamicResource FgPrimary}" FontWeight="SemiBold" Text="Operativo"/>
                        <Run Foreground="{DynamicResource FgMuted}" Text="  ·  "/>
                        <Run Foreground="{DynamicResource FgSecondary}" Text="{Binding SistemaActivo.Nombre, FallbackValue=(sin sistema), TargetNullValue=(sin sistema), Mode=OneWay}"/>
                    </TextBlock>
                    <ToggleButton DockPanel.Dock="Right" x:Name="LogToggle"
                                  Content="Logs" Width="60" Margin="6,0,0,0"
                                  Background="Transparent"
                                  Foreground="{DynamicResource FgSecondary}"
                                  BorderThickness="0"
                                  FontSize="12" FontWeight="Medium"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                               Margin="0,0,16,0"
                               Foreground="{DynamicResource FgMuted}"
                               Text="{Binding CopyrightTexto}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
