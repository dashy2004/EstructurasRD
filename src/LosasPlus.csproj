<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LosasPlus</AssemblyName>
    <RootNamespace>LosasPlus</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Authors>Wrapper basado en el motor de F. Perdomo (Losas v5.00)</Authors>
    <Product>LosasPlus</Product>
    <Description>Capa moderna de UI/edición/exportación sobre el motor de cálculo Losas.exe de Francisco Eludino Perdomo.</Description>
    <Copyright>Motor de cálculo: © Francisco Eludino Perdomo. Wrapper: créditos al autor original.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src.Core\LosasPlus.Core.csproj" />
    <ProjectReference Include="..\src.UI.Shared\MemoriaPlus.UI.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SharpVectors es UI-only (renderer SVG en WPF). Docnet.Core rasteriza
         PDFs vía PDFium (DLL nativa x64 embebida) y produce BitmapSource, así
         que también es UI-only. El resto de paquetes (ClosedXML, Roslyn,
         EncodingCodePages, Text.Json) llegan transitivamente vía
         LosasPlus.Core. -->
    <PackageReference Include="SharpVectors.Reloaded" Version="1.8.4.2" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- OxyPlot.Wpf: gráficas 2D de los diagramas de viga (V, M, δ) — Fase 3.
         Arrastra OxyPlot.Core (tipos puros, sin afinidad de UI/hilo) de forma
         transitiva. Confinado a la capa de presentación; src.Core no lo ve. -->
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <!-- HelixToolkit.Wpf.SharpDX: motor 3D acelerado por DirectX 11 — Fase 3D-I1
         del Plan Maestro de Expansión 3D (EstructurasRD). Arrastra
         HelixToolkit.SharpDX.Core, HelixToolkit.Geometry y HelixToolkit.Maths
         (todos tipos visuales/Geometry3D con afinidad UI). Vive sólo en `src/`;
         `src.Core` no lo ve y permanece libre de dependencias gráficas. -->
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\TiposLosa.json" />
    <Resource Include="Resources\Reglamento.json" />
    <Resource Include="Resources\icons\*.svg" />
  </ItemGroup>

</Project>
